    "general": [
      {
        "id": "problem",
        "numeral": "I",
        "name": "The problem",
        "title": "Why two ledgers cannot just talk",
        "goal": "Know what a ledger is, why two of them cannot see each other, and why CLPR adds no party in the middle to trust.",
        "first": "ledger"
      },
      {
        "id": "idea",
        "numeral": "II",
        "name": "The idea",
        "title": "Proof instead of trust",
        "goal": "Replace the party in the middle with a proof the receiving ledger checks itself, see what that leaves out, and meet everyone a message passes through.",
        "first": "proof"
      },
      {
        "id": "message",
        "numeral": "III",
        "name": "One message, end to end",
        "title": "The journey, the running hash, the money, the failures",
        "goal": "Follow one message there and back, then see what keeps it honest, who pays for it, and what happens when something breaks.",
        "first": "journey"
      },
      {
        "id": "build",
        "numeral": "IV",
        "name": "What you can build",
        "title": "Patterns built on CLPR messages",
        "goal": "The three patterns built on CLPR messages, the shapes of network that pairs of ledgers can form, and who runs what.",
        "first": "patterns"
      },
      {
        "id": "edges",
        "numeral": "V",
        "name": "The edges, and the lab",
        "title": "Adding ledgers, limits, and where CLPR lives",
        "goal": "How a new kind of ledger joins, what CLPR deliberately does not do, and where the code and the people are.",
        "first": "extend"
      }
