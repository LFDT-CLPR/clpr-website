---
/**
 * One sync cycle between two endpoints, as the four-step sequence of Endpoint sync §3.3: one
 * bidirectional gRPC stream per cycle and channel, an unproven request each way, at most one bundle
 * each way, and a terminal message from the responder that ends the cycle.
 *
 * The numbers are editable so the reader can see how the sender shapes a bundle from the request
 * (Endpoint sync §4, Bundle §3): messages start after the requestor's reported received id and are
 * capped by the requestor's per-bundle message throttle, so a bundle can be a partial bundle. A
 * stale or over-claiming request shows why the request never changes state: the requestor's
 * verifier and bundle processing reject what it gets wrong.
 */
import { ledgerConfig, manifest, bundle, transitions, endpointSync, service } from '../../lib/sources';
const { id = 'sync-cycle' } = Astro.props as { id?: string };

const steps = [
  {
    phase: 'Step 0 · before the first message',
    t: 'One stream, one channel, one cycle',
    plain: 'Endpoint A wants to sync one channel. It is the initiator: it picks one of Ledger B\'s endpoints from the peer manifest that Ledger A holds for the channel, and opens a gRPC stream to it. Endpoint B, which accepts the stream, is the responder. Apart from who opens the stream, the two sides do the same things. If B\'s manifest entry carries a certificate, B serves sync over TLS and A must connect over TLS, with no fallback to plaintext; if the entry has none, they talk in plaintext. Neither side presents a client certificate. Nothing is pushed unasked: each side describes its own state, and the other side shapes a bundle from that.',
    proto: 'Every endpoint that advertises a network address in its manifest entry serves the sync method of the endpoint sync gRPC service; an endpoint with no address only initiates. Every message on the stream carries the channel id, the same on every message. TLS protects data in transit and authenticates the server only when the client checks its certificate; it does not authenticate bundles, which rest on their proofs. Each cycle uses a new stream; under the recommended practice the connection and any TLS session may persist across cycles.',
    refs: [{ h: endpointSync('1-purpose-and-roles'), l: 'Endpoint sync §1' }, { h: endpointSync('2-transport'), l: 'Endpoint sync §2' }, { h: manifest('1-endpoint'), l: 'Endpoint manifest §1' }, { h: manifest('6-endpoint-discovery'), l: 'Endpoint manifest §6' }, { h: service('68-transport-and-sync-hygiene'), l: 'CLPR Service §6.8' }],
  },
  {
    phase: 'Step 1 · message ①',
    t: 'A describes its own state',
    plain: 'A sends the first message: a request with four values saying where A stands on this channel: the last of B\'s messages it has received, its channel status, the id of the trust anchor Ledger A stores for B, and the version of B\'s endpoint manifest that Ledger A holds. It is a hint, not a proof. B uses it only to shape the bundle it sends back.',
    proto: 'A side\'s first message in a cycle carries its request; later messages do not. The request is unproven: it MUST NOT cause a state change on either ledger. The receiving ledger\'s verifier and bundle processing remain the only authorities on channel state. The format of the trust anchor id is defined by the sender\'s proof scheme.',
    refs: [{ h: endpointSync('31-messages'), l: 'Endpoint sync §3.1' }, { h: endpointSync('32-rules'), l: 'Endpoint sync §3.2' }, { h: endpointSync('33-sequence'), l: 'Endpoint sync §3.3' }],
  },
  {
    phase: 'Step 2 · message ②',
    t: 'B answers with its own request, and a bundle for A',
    plain: 'B reads the request and takes from Ledger B a contiguous run of the messages A says it is missing: from the next id after A\'s number, within Ledger A\'s throttles. It proves B\'s queue metadata and the last message of the run from one state of Ledger B (the earlier messages are bound by the running hash), and sends the bundle together with B\'s own request, so that A can do the same for B.',
    proto: 'The run starts right after the requestor\'s reported received id, never extends past the sender\'s latest message, and respects the requestor\'s ledger throttles: a message count and a size. It MAY end early, which makes it a partial bundle. If the request claims messages the sender has not enqueued, the sender MAY start after its own acknowledged id or send no messages. If the requestor\'s manifest version is behind, the bundle MUST include a manifest proof. If no normal bundle verifies under the requestor\'s trust anchor, the sender sends a transition bundle instead. Each side sends at most one bundle per cycle.',
    refs: [{ h: endpointSync('4-message-range'), l: 'Endpoint sync §4' }, { h: endpointSync('5-endpoint-obligations'), l: 'Endpoint sync §5' }, { h: bundle('2-queue-metadata'), l: 'Bundle §2' }, { h: bundle('3-partial-bundles'), l: 'Bundle §3' }, { h: bundle('4-proof-requirements'), l: 'Bundle §4' }, { h: ledgerConfig('3-throttles'), l: 'Ledger configuration §3' }],
  },
  {
    phase: 'Step 3 · message ③',
    t: 'A sends B\'s bundle and submits its own',
    plain: 'A builds B\'s bundle from Ledger A, shaped by B\'s request, sends it, and half-closes its side of the stream. Separately, A submits the bundle it received to Ledger A as an ordinary transaction, after checking that it would make progress and be accepted, since a rejected bundle still costs the fee. On Ledger A the verifier checks the proof, and the CLPR Service checks that the message ids continue where Ledger A\'s record ends and that the running hash matches the proven last message; it records B\'s acknowledgement and dispatches the messages. The stream neither waits for the submission nor reports its result.',
    proto: 'An endpoint SHOULD evaluate the progress criteria against its last known view of the destination channel and SHOULD check that the bundle verifies and processes before submitting it. On the ledger, bundle processing runs the pre-checks, the verifier call, the limits, progress, the manifest and trust anchor update, the replay defence, the running hash, the acknowledgement checks, response ordering, then dispatch. A sender learns that its bundle was accepted from the requestor\'s next request.',
    refs: [{ h: endpointSync('33-sequence'), l: 'Endpoint sync §3.3' }, { h: service('52-checks-before-submitting'), l: 'CLPR Service §5.2' }, { h: transitions('2-bundle-processing'), l: 'Channel state transitions §2' }, { h: transitions('3-progress'), l: 'Channel state transitions §3' }],
  },
  {
    phase: 'Step 4 · message ④',
    t: 'B ends the cycle, and submits A\'s bundle',
    plain: 'On receiving A\'s bundle, B sends a terminal message, with no request and no bundle, and ends the call. The cycle is complete. B submits A\'s bundle to Ledger B the same way, outside the stream. How often to sync is left to each endpoint. Endpoints choose their sync peers at random, weighted toward peers that have delivered useful bundles, and prefer peers that reciprocate; that weighting is each endpoint\'s own choice.',
    proto: 'The responder sends the terminal message without waiting for the half-close, then MUST end the call. If step 3 carries no bundle, the responder MAY end the call without step 4. Peer selection is a Recommendation and local to each endpoint: the CLPR Service keeps no endpoint reputation. An endpoint MAY stop or reduce syncing with a peer that breaks the rules or sends bundles its ledger rejects; there is no cross-ledger misbehaviour reporting.',
    refs: [{ h: endpointSync('33-sequence'), l: 'Endpoint sync §3.3' }, { h: service('53-peer-selection'), l: 'CLPR Service §5.3' }, { h: service('68-transport-and-sync-hygiene'), l: 'CLPR Service §6.8' }, { h: endpointSync('6-misbehavior'), l: 'Endpoint sync §6' }],
  },
];
const X = { la: 60, ea: 210, eb: 560, lb: 706 };
---
<div class="sim synccycle" id={id}>
  <div class="sim__head">
    <div><span class="kind">Step-through</span><h3>One sync cycle as specified: four messages on one stream</h3></div>
    <span class="pill grey" data-role="clock">step 0 / 4</span>
    <div class="sim__track seg" data-role="track" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  </div>
  <div class="sim__body">
    <div class="sim__scroll">
    <svg viewBox="0 0 760 514" role="img" aria-label="Sequence diagram with four lifelines: Ledger A, Endpoint A, Endpoint B, Ledger B. Four messages pass between the endpoints; each endpoint submits the bundle it received to its own ledger, outside the stream.">
      <defs>
        <marker id={`${id}-arr`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--c)" /></marker>
        <marker id={`${id}-arr-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--a)" /></marker>
        <marker id={`${id}-arr-b`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--b)" /></marker>
        <marker id={`${id}-arr-g`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--text-3)" /></marker>
      </defs>

      <line x1={X.la} y1="48" x2={X.la} y2="494" class="line dash" />
      <line x1={X.ea} y1="48" x2={X.ea} y2="494" class="line dash" />
      <line x1={X.eb} y1="48" x2={X.eb} y2="494" class="line dash" />
      <line x1={X.lb} y1="48" x2={X.lb} y2="494" class="line dash" />

      <g><rect x="14" y="10" width="92" height="38" rx="8" class="d-a" /><text x={X.la} y="27" class="t b center">Ledger A</text><text x={X.la} y="42" class="t small center">CLPR Service</text></g>
      <g><rect x="140" y="10" width="140" height="38" rx="8" class="d-c" /><text x={X.ea} y="27" class="t b center">Endpoint A</text><text x={X.ea} y="42" class="t small center">initiator</text></g>
      <g><rect x="490" y="10" width="140" height="38" rx="8" class="d-c" /><text x={X.eb} y="27" class="t b center">Endpoint B</text><text x={X.eb} y="42" class="t small center">responder</text></g>
      <g><rect x="660" y="10" width="92" height="38" rx="8" class="d-b" /><text x={X.lb} y="27" class="t b center">Ledger B</text><text x={X.lb} y="42" class="t small center">CLPR Service</text></g>

      <g class="part" data-part="stream"><rect x="150" y="58" width="460" height="26" rx="6" class="d-grey" stroke-dasharray="5 4" /><text x="385" y="75" class="t small center">one stream = one sync cycle · one channel · TLS or plaintext</text></g>

      <g class="part" data-part="m1"><path d={`M${X.ea},112 L${X.eb},112`} class="line c dash" style="--len:350" marker-end={`url(#${id}-arr)`} /><text x="385" y="104" class="t small center b">① A's request: A's channel state</text><text x="385" y="126" class="t mono center" data-role="m1-fields"></text></g>
      <g class="part" data-part="noteB1"><rect x="440" y="138" width="240" height="24" rx="5" class="d-surface" stroke-dasharray="4 3" /><text x={X.eb} y="154" class="t small center">builds a bundle shaped by A's request</text></g>
      <g class="part" data-part="m2"><path d={`M${X.eb},200 L${X.ea},200`} class="line c" style="--len:350" marker-end={`url(#${id}-arr)`} /><text x="385" y="179" class="t small center b">② B's request: B's channel state,</text><text x="385" y="192" class="t small center b">and B's bundle for A</text><text x="385" y="214" class="t mono center" data-role="m2-fields"></text></g>
      <g class="part" data-part="noteA1"><rect x="90" y="226" width="240" height="24" rx="5" class="d-surface" stroke-dasharray="4 3" /><text x={X.ea} y="242" class="t small center">checks the bundle, then submits it</text></g>
      <g class="part" data-part="subA"><path d={`M${X.ea},278 L${X.la},278`} class="line a" style="--len:150" marker-end={`url(#${id}-arr-a)`} /><text x="135" y="270" class="t small center">submit bundle</text><text x="135" y="291" class="t mono center" data-role="subA-fields"></text></g>
      <g class="part" data-part="noteA2"><rect x="90" y="310" width="240" height="24" rx="5" class="d-surface" stroke-dasharray="4 3" /><text x={X.ea} y="326" class="t small center">builds a bundle shaped by B's request</text></g>
      <g class="part" data-part="m3"><path d={`M${X.ea},362 L${X.eb},362`} class="line c" style="--len:350" marker-end={`url(#${id}-arr)`} /><text x="385" y="354" class="t small center b">③ A's bundle for B, then half-close</text><text x="385" y="376" class="t mono center" data-role="m3-fields"></text></g>
      <g class="part" data-part="noteB2"><rect x="440" y="388" width="240" height="24" rx="5" class="d-surface" stroke-dasharray="4 3" /><text x={X.eb} y="404" class="t small center">checks the bundle, then submits it</text></g>
      <g class="part" data-part="subB"><path d={`M${X.eb},440 L${X.lb},440`} class="line b" style="--len:146" marker-end={`url(#${id}-arr-b)`} /><text x="633" y="432" class="t small center">submit bundle</text><text x="633" y="453" class="t mono center" data-role="subB-fields"></text></g>
      <g class="part" data-part="m4"><path d={`M${X.eb},484 L${X.ea},484`} class="line dash" style="--len:350" marker-end={`url(#${id}-arr-g)`} /><text x="385" y="476" class="t small center b">④ terminal message: nothing more</text></g>
      <g class="part" data-part="close"><text x="385" y="506" class="t small center muted">ends the call; as recommended, the connection may persist, and each cycle opens a new stream</text></g>

      <g class="sync__hint" data-role="hint"><rect x="70" y="116" width="130" height="40" rx="6" class="d-surface" stroke-dasharray="4 3" /><text x="135" y="132" class="t small center b">press Next</text><text x="135" y="147" class="t small center">to send message ①</text></g>
      <circle class="chip" data-role="chip1" r="6" aria-hidden="true" />
      <circle class="chip" data-role="chip2" r="6" aria-hidden="true" />
    </svg>
    </div>
    <p class="sim__scroll-note">Wider than a phone; scroll it sideways if you need to.</p>
    <p class="small" style="margin:6px 0 0">Dashed arrow: an unproven request. Solid arrow: a bundle whose contents are state-proven by the sending ledger; <code>meta(r, s, n)</code> abbreviates the queue metadata it proves: the last message id the sender has received, its channel status and its next message id. Both channels are ACTIVE and the trust anchors do not change in this cycle; those values are illustrative constants. The submissions are not part of the exchange: the stream does not wait for them.</p>

    <div class="steps two" style="--l:1.25fr;--r:1fr;margin-top:12px">
      <div class="step-card" data-role="card">
        {steps.map((s, i) => (
          <div data-card={i} hidden={i !== 0}>
            <div class="phase">{s.phase}</div>
            <h4>{s.t}</h4>
            <p>{s.plain}</p>
            <p class="proto"><strong>In protocol terms.</strong> <span set:html={s.proto} /></p>
            <p class="small" style="margin:6px 0 0">Source: {s.refs.map((r, j) => (<><a href={r.h} rel="noopener">{r.l}</a>{j < s.refs.length - 1 ? ' · ' : ''}</>))}</p>
          </div>
        ))}
      </div>
      <div class="sync__inputs" role="group" aria-label="Channel state on each ledger">
        <div class="sync__side" data-side="a">
          <div class="sync__title" style="color:var(--a)">Ledger A (Endpoint A's home)</div>
          <label>has received B's messages up to <input type="number" min="0" max="999999" value="3" data-in="aRecv" /></label>
          <label>A's next message id <input type="number" min="1" max="999999" value="9" data-in="aNext" /></label>
          <label>A's request claims received = <select data-in="aClaim"><option value="0">the truth</option><option value="-2">2 less (stale)</option><option value="2">2 more (over-claim)</option></select></label>
        </div>
        <div class="sync__side" data-side="b">
          <div class="sync__title" style="color:var(--b)">Ledger B (Endpoint B's home)</div>
          <label>has received A's messages up to <input type="number" min="0" max="999999" value="7" data-in="bRecv" /></label>
          <label>B's next message id <input type="number" min="1" max="999999" value="20" data-in="bNext" /></label>
          <label>B's endpoint manifest is at version <input type="number" min="1" max="999999" value="3" data-in="bMan" /> <span class="small">(A's cached copy: v3)</span></label>
        </div>
        <label class="sync__cap">most messages per bundle (the receiving ledger's throttle; the same on both here) <input type="number" min="1" max="999999" value="10" data-in="maxB" /></label>
      </div>
    </div>

    <p class="small" style="margin:10px 0 0">Source: <a href={endpointSync('3-exchange')} rel="noopener">Endpoint sync §3</a> · <a href={endpointSync('4-message-range')} rel="noopener">Endpoint sync §4</a> · <a href={manifest('6-endpoint-discovery')} rel="noopener">Endpoint manifest §6</a> (discovery) · <a href={service('5-bundle-submission')} rel="noopener">CLPR Service §5</a> (submission) · <a href={bundle('3-partial-bundles')} rel="noopener">Bundle §3</a> (partial bundles).</p>
  </div>
  <div class="sim__controls">
    <button class="btn" type="button" data-role="prev" disabled>◀ Prev</button>
    <button class="btn primary" type="button" data-role="next">Next ▶</button>
    <span class="spacer"></span>
    <button class="btn" type="button" data-role="reset">Reset</button>
  </div>
  <div class="sim__log sim__log--tall" data-role="log"></div>
</div>
<style>
  .synccycle .sim__head .sim__track { flex-basis: 100%; }
  .synccycle .part { opacity: 0.14; transition: opacity 250ms; }
  .synccycle .part.on { opacity: 1; }
  .synccycle .part.now path { stroke-width: 2.5; }
  /* The current step's arrows draw on (solid) or march (dashed); the chip travels the same path. */
  .synccycle .part.now path:not(.dash) { stroke-dasharray: var(--len, 350); animation: sync-draw 500ms ease-out; }
  .synccycle .part.now path.dash { animation: sync-march 700ms linear; }
  @keyframes sync-draw { from { stroke-dashoffset: var(--len, 350); } to { stroke-dashoffset: 0; } }
  @keyframes sync-march { from { stroke-dashoffset: 18; } to { stroke-dashoffset: 0; } }
  .synccycle .chip { opacity: 0; fill: var(--c); stroke: var(--surface); stroke-width: 2; offset-rotate: 0deg; }
  .synccycle .chip.a { fill: var(--a); }
  .synccycle .chip.b { fill: var(--b); }
  .synccycle .chip.g { fill: var(--text-3); }
  .synccycle .chip.go { animation: sync-chip 600ms ease-in-out both; }
  @keyframes sync-chip { 0% { offset-distance: 0%; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { offset-distance: 100%; opacity: 0; } }
  .synccycle text.ok { fill: var(--ok); }
  .synccycle text.bad { fill: var(--bad); }
  .synccycle text.warn { fill: var(--b); }
  .synccycle text.changed { animation: sync-flash 600ms ease; }
  @keyframes sync-flash { from { fill: var(--b); } }
  .synccycle .sync__hint.is-hidden { display: none; }
  .synccycle .sync__hint text { fill: var(--a); }
  .sync__inputs { font-size: 0.85rem; border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; background: var(--surface); display: grid; gap: 8px; align-content: start; min-width: 0; }
  .sync__side { display: grid; gap: 4px; }
  .sync__title { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; }
  .sync__inputs label { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; color: var(--text-2); }
  .sync__inputs input, .sync__inputs select { font: inherit; font-size: 0.85rem; width: 5.5em; padding: 2px 6px; border: 1px solid var(--border-2); border-radius: 6px; background: var(--surface); color: var(--text); transition: border-color 150ms, box-shadow 150ms, background-color 150ms; }
  .sync__inputs select { width: auto; }
  .sync__inputs input:focus, .sync__inputs select:focus { outline: none; border-color: var(--text-3); box-shadow: 0 0 0 3px var(--grey-soft); }
  .sync__side[data-side="a"] input:focus, .sync__side[data-side="a"] select:focus { border-color: var(--a); box-shadow: 0 0 0 3px var(--a-soft); }
  .sync__side[data-side="b"] input:focus, .sync__side[data-side="b"] select:focus { border-color: var(--b); box-shadow: 0 0 0 3px var(--b-soft); }
  .sync__inputs input.fallback { border-color: var(--bad); background: var(--bad-soft); }
  .sync__inputs input.fallback::placeholder { color: var(--bad); opacity: 1; }
  .sync__cap { border-top: 1px solid var(--border); padding-top: 8px; }
  /* Stack every card in one grid cell so the card is always as tall as the tallest step and the
     controls under it never move; hidden cards keep their space but are invisible and inert. */
  @media (min-width: 720px) {
    .synccycle .step-card { display: grid; }
    .synccycle .step-card > [data-card] { grid-area: 1 / 1; }
    .synccycle .step-card > [data-card][hidden] { display: block; visibility: hidden; }
  }
</style>

<script>
  // Cumulative: everything up to the current step stays visible; the current step's parts are emphasised.
  const AT: string[][] = [['stream'], ['m1'], ['noteB1', 'm2'], ['noteA1', 'subA', 'noteA2', 'm3'], ['noteB2', 'subB', 'm4', 'close']];
  const TA_B_SEEN_BY_A = '0x9c4e…';
  const TA_A_SEEN_BY_B = '0x27b1…';
  const A_CACHED_B_MANIFEST = 3;
  const B_CACHED_A_MANIFEST = 2;

  interface Shape { first: number; last: number; n: number; backlog: number; }
  /** Messages the sender puts in a bundle: from claim + 1 up to next − 1, at most max of them (Endpoint sync §4). */
  function shape(claim: number, next: number, max: number): Shape {
    const first = claim + 1;
    const last = next - 1;
    if (first > last) return { first: 0, last: 0, n: 0, backlog: 0 };
    const backlog = last - first + 1;
    const n = Math.min(backlog, max);
    return { first, last: first + n - 1, n, backlog };
  }
  const range = (s: Shape) => (s.n === 0 ? 'no messages' : s.n === 1 ? `message ${s.first}` : `messages ${s.first}…${s.last}`);

  // Which arrow each step's payload travels, and the chip colour for it (c = endpoint to endpoint).
  const TRAVEL: { part: string; tone: '' | 'a' | 'b' | 'g' }[][] = [[], [{ part: 'm1', tone: '' }], [{ part: 'm2', tone: '' }], [{ part: 'subA', tone: 'a' }, { part: 'm3', tone: '' }], [{ part: 'subB', tone: 'b' }, { part: 'm4', tone: 'g' }]];
  /** Greedy word wrap for the mono labels under the submit bundle arrows, which must fit between two lifelines. */
  function wrap(s: string, max: number): string[] {
    const lines: string[] = [];
    let cur = '';
    for (const w of s.split(' ').reduce<string[]>((acc, w) => { if (acc.length && acc[acc.length - 1] === '·') acc[acc.length - 1] += ' ' + w; else acc.push(w); return acc; }, [])) {
      if (cur && (cur + ' ' + w).length > max) { lines.push(cur); cur = w; } else cur = cur ? cur + ' ' + w : w;
    }
    if (cur) lines.push(cur);
    return lines;
  }

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('.sim.synccycle'))) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const role = (r: string) => root.querySelector<HTMLElement>(`[data-role="${r}"]`);
    let ready = false;
    const flash = (el: Element) => { if (!ready) return; el.classList.remove('changed'); void (el as HTMLElement).getBoundingClientRect(); el.classList.add('changed'); };
    const text = (r: string, s: string) => { const el = role(r); if (!el || el.textContent === s) return; el.textContent = s; flash(el); };
    /** Like text(), but wrapped onto tspans (11 px lines) when the label is wider than its lane. */
    const lines = (r: string, s: string, max: number) => {
      const el = role(r); if (!el || el.dataset.v === s) return;
      el.dataset.v = s;
      const x = el.getAttribute('x')!;
      el.innerHTML = wrap(s, max).map((l, k) => `<tspan x="${x}" dy="${k ? 11 : 0}">${l.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</tspan>`).join('');
      flash(el);
    };
    const tone = (r: string, t: '' | 'ok' | 'bad' | 'warn') => { const el = role(r); if (!el) return; for (const c of ['ok', 'bad', 'warn']) el.classList.toggle(c, c === t); };
    const log = $('[data-role="log"]');
    const parts = Array.from(root.querySelectorAll<SVGGElement>('g.part'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-in]'));
    const segs = Array.from(root.querySelectorAll<HTMLElement>('[data-role="track"] > i'));
    const chips = [role('chip1'), role('chip2')] as (SVGCircleElement | null)[];
    const prevBtn = $('[data-role="prev"]') as HTMLButtonElement;
    const nextBtn = $('[data-role="next"]') as HTMLButtonElement;
    /** Reads a number input; an empty or out-of-range field falls back to `lo` and is marked so the reader can see it. */
    const num = (k: string, lo: number) => {
      const el = inputs.find((i) => i.dataset.in === k)!;
      const raw = el.value.trim();
      const v = Math.floor(Number(raw));
      const fell = raw === '' || !Number.isFinite(v) || v < lo;
      const used = fell ? lo : v;
      if (el instanceof HTMLInputElement) {
        el.classList.toggle('fallback', fell);
        el.placeholder = fell ? String(used) : '';
        el.setAttribute('aria-invalid', fell ? 'true' : 'false');
        el.title = fell ? `empty or below ${lo}; using ${used}` : '';
      }
      return used;
    };
    let step = 0;

    function travel() {
      if (!ready || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      TRAVEL[step].forEach((t, k) => {
        const chip = chips[k]; if (!chip) return;
        const path = root.querySelector<SVGPathElement>(`g.part[data-part="${t.part}"] path`);
        if (!path) return;
        chip.style.offsetPath = `path('${path.getAttribute('d')}')`;
        chip.style.animationDelay = k ? '450ms' : '0ms';
        chip.setAttribute('class', `chip${t.tone ? ' ' + t.tone : ''}`);
        void chip.getBoundingClientRect();
        chip.classList.add('go');
      });
    }

    function render(moved = false) {
      const aRecv = num('aRecv', 0), aNext = num('aNext', 1), bRecv = num('bRecv', 0), bNext = num('bNext', 1), bMan = num('bMan', 1), maxB = num('maxB', 1);
      const claim = Math.max(0, aRecv + num('aClaim', -2));
      // A claim at or above B's next message id names a message B has not enqueued: B MAY start after its own
      // acknowledged id instead (Endpoint sync §4), which this sim takes to equal A's real received id.
      const fallback = claim >= bNext;
      const startAfter = fallback ? aRecv : claim;
      const forA = shape(startAfter, bNext, maxB);
      const forB = shape(bRecv, aNext, maxB);
      const manifestProof = bMan > A_CACHED_B_MANIFEST;

      // SVG
      const on = new Set(AT.slice(0, step + 1).flat());
      const now = new Set(AT[step]);
      for (const p of parts) { p.classList.toggle('on', on.has(p.dataset.part!)); p.classList.toggle('now', now.has(p.dataset.part!)); }
      role('hint')?.classList.toggle('is-hidden', step > 0);
      for (const c of cards) c.hidden = Number(c.dataset.card) !== step;
      const clock = role('clock'); if (clock) { clock.textContent = `step ${step} / 4`; clock.className = `pill ${step === 4 ? 'ok' : 'grey'}`; }
      prevBtn.disabled = step === 0;
      nextBtn.disabled = step === 4;
      const brief = (s: Shape, next: number) => (s.n === 0 ? 'no msgs' : s.backlog === 1 ? `msg ${s.first}` : s.n === s.backlog ? `msgs ${s.first}…${s.last} (all)` : `msgs ${s.first}…${s.last} of ${s.first}…${next - 1}`);
      text('m1-fields', `received=${claim} ACTIVE anchor=${TA_B_SEEN_BY_A} manifest=v${A_CACHED_B_MANIFEST}`);
      text('m2-fields', `${brief(forA, bNext)} · meta(${bRecv}, ACTIVE, ${bNext})${manifestProof ? ` · manifest v${bMan}` : ''}`);
      text('m3-fields', `${brief(forB, aNext)} · meta(${aRecv}, ACTIVE, ${aNext})`);

      // What Ledger A does with B's bundle (Channel state transitions §2). The request was unproven; this is where
      // state changes or does not. A run that starts at or below B's proven acknowledged id (here A's real received
      // id) fails A's verifier; one that starts past A's received id + 1 is a gap that bundle processing rejects.
      let aOutcome: 'ok' | 'empty' | 'stale' | 'over';
      if (forA.n === 0) aOutcome = 'empty';
      else if (forA.first === aRecv + 1) aOutcome = 'ok';
      else if (forA.first < aRecv + 1) aOutcome = 'stale';
      else aOutcome = 'over';
      const subA = aOutcome === 'ok' ? `recv ${aRecv}→${forA.last} · acked→${bRecv}${manifestProof ? ` · manifest→v${bMan}` : ''}`
        : aOutcome === 'empty' ? (manifestProof ? `manifest→v${bMan} · acked→${bRecv}` : 'nothing to submit')
        : aOutcome === 'stale' ? 'rejected by verifier' : 'rejected: message gap';
      lines('subA-fields', subA, 21);
      tone('subA-fields', aOutcome === 'ok' ? 'ok' : aOutcome === 'empty' ? (manifestProof ? 'ok' : 'warn') : 'bad');
      const bAccepts = forB.n > 0;
      lines('subB-fields', bAccepts ? `recv ${bRecv}→${forB.last} · acked→${aRecv}` : `acked→${aRecv} (if progress)`, 21);
      tone('subB-fields', bAccepts ? 'ok' : 'warn');
      const aRejected = aOutcome === 'stale' || aOutcome === 'over';
      segs.forEach((s, k) => { s.className = step > k + 1 ? 'done' : step === k + 1 ? 'now' : ''; if (k === 2 && step >= 3 && aRejected) s.className = 'bad'; });
      if (moved) travel();

      // Log: a mono summary line, then one plain line and the protocol facts, with the live numbers.
      const req = (r: number, ta: string, v: number) => `request(received ${r}, status ACTIVE, trust anchor ${ta}, manifest v${v})`;
      const meta = (r: number, n: number) => `meta(${r}, ACTIVE, ${n})`;
      const mono = step === 0 ? 'stream open · nothing exchanged yet'
        : step === 1 ? `① request(received=${claim}, ACTIVE, ${TA_B_SEEN_BY_A}, v${A_CACHED_B_MANIFEST})`
        : step === 2 ? `② request(received=${bRecv}, ACTIVE, ${TA_A_SEEN_BY_B}, v${B_CACHED_A_MANIFEST}) + bundle(${range(forA)}, ${meta(bRecv, bNext)}${manifestProof ? `, manifest v${bMan}` : ''})`
        : step === 3 ? `③ bundle(${range(forB)}, ${meta(aRecv, aNext)}) · half-close · submit at A → ${subA}`
        : `④ terminal message · call ended · submit at B → ${bAccepts ? `recv ${bRecv}→${forB.last} · acked→${aRecv}` : `acked→${aRecv} (if progress)`}`;
      let html = '';
      if (step === 0) {
        html = `Endpoint A opened a stream to Endpoint B for this channel, over TLS if B's manifest entry carries a certificate and in plaintext if it does not. Nothing has been exchanged yet. <strong>Edit the numbers on the right at any time;</strong> the bundles below are recomputed from them.`;
      } else if (step === 1) {
        html = `<strong>A → B:</strong> <code>${req(claim, TA_B_SEEN_BY_A, A_CACHED_B_MANIFEST)}</code>. Unproven, and nothing on Ledger B changes because of it.` + (claim !== aRecv ? ` <span class="warn">A's real received id is ${aRecv}; the request says ${claim}.</span>` : '');
      } else if (step === 2) {
        const backlog = (fallback ? `<span class="warn">A's claim of ${claim} names a message B has not enqueued (its next message id is ${bNext}). B may then send no messages or start after its own acknowledged id; here it starts after it, at ${aRecv + 1}.</span> ` : '')
          + (forA.backlog ? `B's outbound queue holds ${forA.backlog} message${forA.backlog === 1 ? '' : 's'} after id ${startAfter} (ids ${startAfter + 1}…${bNext - 1}). ` : `B has nothing after id ${startAfter} (its next message id is ${bNext}), so the bundle carries no messages. `)
          + (claim > aRecv && !fallback ? `<span class="warn">Because A over-claimed, ids ${aRecv + 1}…${Math.min(claim, bNext - 1)} that A still needs are left out.</span> ` : claim < aRecv ? `<span class="warn">Because A under-claimed, ids ${claim + 1}…${aRecv} that A already has are included again.</span> ` : '');
        const cap = forA.n && forA.n < forA.backlog ? `<strong>Only ${forA.n} go in</strong>, because Ledger A takes at most ${maxB} per bundle: this is a partial bundle, its proven last message is ${forA.last}, and ${forA.last + 1}…${bNext - 1} wait for a later cycle. ` : forA.n ? `All ${forA.n} fit under Ledger A's limit of ${maxB} per bundle; the proven last message is ${forA.last}. ` : '';
        html = `<strong>B → A:</strong> B's own <code>${req(bRecv, TA_A_SEEN_BY_B, B_CACHED_A_MANIFEST)}</code>, and the bundle for A = <strong>${range(forA)}</strong>. ${backlog}${cap}State-proven in the bundle: B's queue metadata (received ${bRecv}, status ACTIVE, next message id ${bNext})${manifestProof ? ` and B's endpoint manifest v${bMan}, which B must include because A reported only v${A_CACHED_B_MANIFEST}` : ''}.`;
      } else if (step === 3) {
        const verdict = aOutcome === 'ok'
          ? `<span class="ok">Ledger A accepts it.</span> The verifier checks the proof; the first id ${forA.first} follows Ledger A's received id ${aRecv}, the ids are contiguous, and the running hash reproduces the proven last message. Received id → ${forA.last}; acknowledged id → ${bRecv} (B's proven received id), so Ledger A deletes the replies and control messages B has acknowledged${manifestProof ? `; peer manifest → v${bMan}` : ''}.`
          : aOutcome === 'stale'
          ? `<span class="bad">Ledger A rejects it.</span> The run starts at ${forA.first}, at or below the acknowledged id that B's state proves (this sim takes it to equal A's real received id, ${aRecv}). Ledger A's verifier must fail such a bundle. <strong>Nothing on the ledger changes</strong>; the stale request cost bandwidth and, if submitted, a transaction fee, and the next cycle's request fixes the range. Had the run started above B's acknowledged id, Ledger A would have accepted it and skipped the messages it already has. Correctness never depended on the request.`
          : aOutcome === 'over'
          ? `<span class="bad">Ledger A rejects it.</span> The bundle starts at ${forA.first}, but Ledger A has only received up to ${aRecv}, so ids ${aRecv + 1}…${forA.first - 1} are missing: bundle processing rejects a gap, and the whole bundle with it. An over-claim harms only the over-claiming side, as a delay and never as a wrong delivery; a later correct request, or anyone's submission of a bundle that fills the gap, delivers the messages.`
          : manifestProof
          ? `<span class="ok">Ledger A accepts it</span> even with no messages: a manifest with version ${bMan} > ${A_CACHED_B_MANIFEST} is progress on its own, and the acknowledged id → ${bRecv}.`
          : `<span class="warn">Maybe nothing to submit:</span> no messages, no manifest and no trust anchor change. The bundle makes progress only if its acknowledgement does (B's proven received id ${bRecv} above Ledger A's acknowledged id). An endpoint should not submit a bundle that makes no progress: Ledger A would reject it, and the fee would still be paid.`;
        const forBtext = forB.n ? `${range(forB)}${forB.n < forB.backlog ? ` (${forB.n} of ${forB.backlog}, a partial bundle)` : ''}` : `no messages (B already has everything up to ${aNext - 1})`;
        html = `<strong>A → B:</strong> bundle for B = <strong>${forBtext}</strong>, with A's proven queue metadata (received ${aRecv}, status ACTIVE, next message id ${aNext}); no request, since a side sends its request only in its first message. A then half-closes. <strong>Separately, at Ledger A:</strong> ${verdict}`;
      } else {
        html = `<strong>B → A:</strong> a terminal message, with no request and no bundle, and B ends the call; the connection may persist. <strong>Separately, at Ledger B:</strong> `
          + (bAccepts ? `<span class="ok">Ledger B accepts A's bundle:</span> first id ${forB.first} follows ${bRecv}; received id → ${forB.last}, acknowledged id → ${aRecv}. ` : `A's bundle carried no messages, so it is worth submitting only if it makes progress another way, for example an acknowledged id of ${aRecv} when that is higher than Ledger B's current value. `)
          + (forA.n > 0 && forB.n > 0 ? `A brought ${forB.n} message${forB.n === 1 ? '' : 's'} and B brought ${forA.n}: each delivered a useful bundle, which the recommended peer selection weighs.` : `A brought ${forB.n} message${forB.n === 1 ? '' : 's'} and B brought ${forA.n}. The recommended peer selection weighs peers by the useful bundles they deliver and prefers peers that reciprocate; each endpoint keeps that weighting locally.`);
      }
      log.innerHTML = `<span class="line">${mono.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>${html}`;
    }

    for (const el of Array.from(root.querySelectorAll<Element>('text, .chip'))) el.addEventListener('animationend', () => { el.classList.remove('changed'); el.classList.remove('go'); });
    nextBtn.addEventListener('click', () => { step = Math.min(4, step + 1); render(true); });
    prevBtn.addEventListener('click', () => { step = Math.max(0, step - 1); render(true); });
    $('[data-role="reset"]').addEventListener('click', () => {
      step = 0;
      for (const i of inputs) { const d: Record<string, string> = { aRecv: '3', aNext: '9', aClaim: '0', bRecv: '7', bNext: '20', bMan: '3', maxB: '10' }; i.value = d[i.dataset.in!]; }
      render();
    });
    for (const i of inputs) i.addEventListener('input', () => render());
    render();
    ready = true;
  }
</script>
