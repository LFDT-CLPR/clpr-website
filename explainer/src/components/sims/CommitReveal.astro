---
/**
 * Channel registration by commit and reveal on two ledgers, with a real Keccak-256 computed in the
 * browser (self-tested at load; shows "(hash unavailable)" rather than a wrong value).
 *
 * Channel setup §1, §2, §4 (channels), Connector setup §1, §2, §3, §5 (connectors), CLPR Service
 * §2.5 (the administrator's close). Registration signatures are ledger-specific (Hiero ledger §5,
 * EVM ledger family §5). What the EVM reference contracts do differently (docs/lifecycle.md in
 * clpr-smart-contracts) is shown in a separate "Reference implementation" callout and never
 * blended into the specification's own claims.
 *
 * The public key is 64 random bytes standing in for an uncompressed secp256k1 key: no real
 * signature runs here, so the reveal signature is shown as a placeholder. Every hash on screen is genuine.
 */
import { channelSetup, connectorSetup, verifierIface, transitions, endpointSync, service, sol, pinned } from '../../lib/sources';
import Callout from '@kse/components/Callout.astro';
const { id = 'commit-reveal' } = Astro.props as { id?: string };

const LIFECYCLE = pinned('clpr-smart-contracts', 'docs/lifecycle.md', 'channel-commit-reveal');
const EVM_ID = pinned('clpr-spec', 'ledgers/evm/ledger-family.md', '4-channel-identity');
const EVM_SIG = pinned('clpr-spec', 'ledgers/evm/ledger-family.md', '5-registration-signatures');
const HIERO_SIG = pinned('clpr-spec', 'ledgers/hiero/ledger.md', '5-registration-signatures');
const steps = [
  {
    phase: 'Step 0 · off the ledgers',
    t: 'Pick a channel id and a keypair',
    plain: 'A channel has the same id on both ledgers; that id is what ties its two records together. Registration is open to any caller, so it runs in two phases, commit and reveal: the commit reserves the channel on both ledgers without revealing the id or the key. First the registrant picks the channel id, 32 bytes (here 32 random ones), and a keypair for this ledger. Nothing has touched a ledger yet. Every hash you will see is computed by this page with the hash the specification names; "New random id / keypair" rerolls both inputs.',
    proto: 'The channel id is 32 bytes chosen by the registrant, the same on both ledgers; within one CLPR Service it identifies at most one channel. A ledger MAY constrain how the id is derived, and the registrant MUST choose an id that satisfies both ledgers. The Protocol does not derive the id from a key, so the registrant MAY use a different key pair on each ledger, of a type that ledger supports, unless the two ledgers\' constraints require the same key. Several channels MAY connect the same pair of CLPR Services, each with its own id, verifier and queues.',
    refs: [{ h: channelSetup('1-channel-identity'), l: 'Channel setup §1' }, { h: channelSetup('2-registration'), l: 'Channel setup §2' }],
  },
  {
    phase: 'Step 1 · off the ledgers',
    t: 'The ownership commitment',
    plain: 'Hash the channel id and the public key together. The 32-byte result is the ownership commitment. Anyone may see it; nobody can read the id or the key back out of it.',
    proto: 'The ownership commitment binds a channel id to the registrant\'s key on one ledger: a hash of the channel id followed by the public key, in that ledger\'s key encoding. The value below is the specification\'s commitment, computed by this page.',
    refs: [{ h: channelSetup('2-registration'), l: 'Channel setup §2' }],
  },
  {
    phase: 'Step 2 · Ledger A · commit',
    t: 'Commit on Ledger A → PENDING',
    plain: 'The registrant sends only the commitment to Ledger A. The CLPR Service records it as pending. No channel exists yet: a pending commitment with no channel behind it is what the PENDING status means. A PENDING channel can do nothing: a bundle for it is rejected as for an unknown channel, no endpoint syncs it, and no message is sent on it.',
    proto: 'The commit takes the ownership commitment as its only input; the channel id and the key are first presented at the reveal. Registering a commitment that is already pending or completed has no further effect, and a ledger MAY reject it. An endpoint MUST NOT initiate a sync cycle for a channel that is PENDING on its own ledger, and a responder whose channel is PENDING sends no bundle.',
    refs: [{ h: channelSetup('21-registerchannel'), l: 'Channel setup §2.1' }, { h: transitions('1-channel-status'), l: 'Channel state transitions §1' }, { h: transitions('2-bundle-processing'), l: 'Channel state transitions §2' }, { h: endpointSync('53-channel-status'), l: 'Endpoint sync §5.3' }],
  },
  {
    phase: 'Step 3 · Ledger B · commit',
    t: 'Commit on Ledger B → PENDING',
    plain: 'The same commit goes to Ledger B, independently. Both commitments are now on file, and neither shows the id or the key.',
    proto: 'The registrant commits on both ledgers before revealing on either. With a different key pair on each ledger the two commitments differ; this page reuses one keypair so there is a single hash to follow.',
    refs: [{ h: channelSetup('2-registration'), l: 'Channel setup §2' }, { h: channelSetup('21-registerchannel'), l: 'Channel setup §2.1' }],
  },
  {
    phase: 'Step 4 · meanwhile',
    t: 'Someone is watching Ledger A',
    plain: 'An observer reads Ledger A and sees the commit transaction. All it carries is the 32-byte hash. The hash yields neither the channel id nor the key, so the observer cannot complete this commitment: the reveal must present the id and the key that hash to it, and a signature made with that key.',
    proto: 'The commit reserves the channel without revealing the channel id or the key. At the reveal the CLPR Service rejects the call unless the hash of the presented id and key is a pending commitment and the signature proves control of the key.',
    refs: [{ h: channelSetup('2-registration'), l: 'Channel setup §2' }, { h: channelSetup('22-completechannel'), l: 'Channel setup §2.2' }],
  },
  {
    phase: 'Step 5 · Ledger A · reveal',
    t: 'Reveal on Ledger A → ACTIVE',
    plain: 'Now the registrant reveals on Ledger A: the channel id, the public key, a signature proving it holds the matching private key, the address of a verifier for Ledger B\'s proofs, and proofs obtained from Ledger B of its ledger configuration and, optionally, its endpoint manifest. The CLPR Service recomputes the hash, checks the signature, and has the verifier check the proofs. If everything holds, the channel exists, ACTIVE.',
    proto: 'The CLPR Service MUST reject the reveal if the hash of id and key is not a pending commitment, a channel with the id already exists, the signature does not prove control of the key, the id breaks a constraint of this ledger, the address is not a verifier, the verifier\'s configuration check fails, or the returned configuration has no throttles or an invalid timestamp. Otherwise it creates the channel, ACTIVE, with its channel context, its verifier binding, the peer\'s chain id, configuration, throttles, initial trust anchor and endpoint manifest (all taken from the verifier\'s output), and the initial shared state. The commitment is kept, recorded as completed. The message signed, the signature scheme and the key encoding are ledger-specific.',
    refs: [{ h: channelSetup('22-completechannel'), l: 'Channel setup §2.2' }, { h: channelSetup('5-initial-peer-state'), l: 'Channel setup §5' }, { h: verifierIface('2-verifyconfig'), l: 'Verifier interface §2' }, { h: HIERO_SIG, l: 'Hiero ledger §5' }, { h: EVM_SIG, l: 'EVM ledger family §5' }],
  },
  {
    phase: 'Step 6 · Ledger B · reveal',
    t: 'Reveal on Ledger B → ACTIVE',
    plain: 'The same reveal on Ledger B, naming a verifier for Ledger A\'s proofs, with proofs obtained from A. Each verifier checks the other ledger\'s proofs, which is why the two are different contracts.',
    proto: 'The verifier named at the reveal is either a contract on this ledger that implements its verifier API, or a verifier the ledger itself provides, as its Ledger Specifications define. The CLPR Service MUST reject an address at which there is neither.',
    refs: [{ h: channelSetup('4-verifier-binding'), l: 'Channel setup §4' }, { h: channelSetup('22-completechannel'), l: 'Channel setup §2.2' }],
  },
  {
    phase: 'Step 7 · done',
    t: 'Both ACTIVE; the verifier is fixed for life',
    plain: 'Both sides are ACTIVE and syncing may begin. The verifier each side named cannot be changed later; if the other ledger\'s proof scheme changes so that the verifier can no longer check its bundles, a new channel with a new verifier is needed. The registrant has no authority over the channel once it exists: its key served only to coordinate the registration.',
    proto: 'No operation changes the verifier binding, so applications can evaluate a channel\'s verifier once. The administrator\'s close depends on the status: on a PENDING channel it removes the named commitment; on an ACTIVE or PAUSED channel it is the administrative close; on a DRAINED channel it is the recovery close; on a CLOSING or CLOSED channel it is rejected.',
    refs: [{ h: channelSetup('4-verifier-binding'), l: 'Channel setup §4' }, { h: channelSetup('6-shared-channel-state'), l: 'Channel setup §6' }, { h: service('25-closing-a-channel'), l: 'CLPR Service §2.5' }],
  },
];
const ledgers = [
  { k: 'a', x: 16, name: 'Ledger A', peer: 'B', col: 'var(--a)', box: 'd-a' },
  { k: 'b', x: 422, name: 'Ledger B', peer: 'A', col: 'var(--b)', box: 'd-b' },
];
---
<div class="sim commitreveal" id={id}>
  <div class="sim__head"><div><span class="kind">Step-through</span><h3>Registering a channel on two ledgers by commit and reveal</h3></div><span class="pill grey" data-role="clock">step 0 / 7</span>
    <span class="sim__track seg" data-role="track" aria-hidden="true"><i data-tone="c"></i><i data-tone="a"></i><i data-tone="b"></i><i data-tone="bad"></i><i data-tone="a"></i><i data-tone="b"></i><i data-tone="ok"></i></span></div>
  <div class="sim__body">
    <div class="choices cr__tabs" role="group" aria-label="Which registration to show">
      <button class="btn" type="button" data-tab="channel" aria-pressed="true">Channel registration</button>
      <button class="btn" type="button" data-tab="connector" aria-pressed="false">Connectors use the same trick</button>
    </div>

    <div data-panel="channel">
      <div class="sim__scroll">
      <svg viewBox="0 0 760 362" role="img" aria-label="Two ledgers side by side. A registrant at the top sends a commitment to each, then reveals on each; an attacker at the bottom watches Ledger A and sees only the commitment.">
        <defs>
          <marker id={`${id}-arr`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--c)" /></marker>
          <marker id={`${id}-arr-ok`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--ok)" /></marker>
          <marker id={`${id}-arr-bad`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--bad)" /></marker>
        </defs>

        <g><rect x="295" y="8" width="170" height="46" rx="8" class="d-c" /><text x="380" y="27" class="t b center">Registrant</text><text x="380" y="44" class="t small center">any account, no permission</text></g>

        <g class="part" data-part="regA"><path d="M297,50 L192,88" class="line c" marker-end={`url(#${id}-arr)`} /><text x="212" y="62" class="t small center">commit: the hash only</text></g>
        <g class="part" data-part="revA"><path d="M297,50 L192,88" class="line ok" stroke-width="2.5" marker-end={`url(#${id}-arr-ok)`} /><text x="212" y="62" class="t small center">reveal: id, key, proofs</text></g>
        <g class="part" data-part="regB"><path d="M463,50 L568,88" class="line c" marker-end={`url(#${id}-arr)`} /><text x="548" y="62" class="t small center">commit: the hash only</text></g>
        <g class="part" data-part="revB"><path d="M463,50 L568,88" class="line ok" stroke-width="2.5" marker-end={`url(#${id}-arr-ok)`} /><text x="548" y="62" class="t small center">reveal: id, key, proofs</text></g>

        {ledgers.map((L) => (
          <g data-ledger={L.k}>
            <rect x={L.x} y="92" width="322" height="188" rx="12" class="d-surface" stroke-dasharray="6 5" />
            <text x={L.x + 16} y="112" class="t b" style={`fill:${L.col}`}>{L.name}</text>
            <rect x={L.x + 240} y="98" width="72" height="20" rx="10" class="d-grey" data-role={`${L.k}-pill`} />
            <text x={L.x + 276} y="112" class="t small center b cr__st" data-role={`${L.k}-st`}>none</text>
            <rect x={L.x + 14} y="122" width="294" height="88" rx="8" class={L.box} fill-opacity="0.35" />
            <text x={L.x + 26} y="140" class="t b">CLPR Service</text>
            <rect x={L.x + 26} y="148" width="270" height="54" rx="6" class="d-surface" />
            <text x={L.x + 36} y="164" class="t small" data-role={`${L.k}-r1`}>no channel record</text>
            <text x={L.x + 36} y="180" class="t mono" data-role={`${L.k}-r2`}></text>
            <text x={L.x + 36} y="196" class="t mono" data-role={`${L.k}-r3`}></text>
            <g class="part" data-part={`ver${L.k.toUpperCase()}`}><rect x={L.x + 14} y="220" width="136" height="50" rx="6" class="d-surface" /><text x={L.x + 82} y="239" class="t small center">Verifier for {L.peer}'s proofs</text><text x={L.x + 82} y="256" class="t small center" style="fill:var(--ok)">config proof ✓</text></g>
            <g class="part" data-part={`prf${L.k.toUpperCase()}`}><rect x={L.x + 160} y="220" width="148" height="50" rx="6" class={L.k === 'a' ? 'd-b' : 'd-a'} /><text x={L.x + 234} y="239" class="t small center">proofs fetched from {L.peer}</text><text x={L.x + 234} y="256" class="t small center">config · manifest</text></g>
          </g>
        ))}

        <g class="cr__env" data-role="env-b" data-at="reg"><rect width="156" height="16" rx="4" class="d-c" /><text x="78" y="12" class="t mono center cr__envtext"></text></g>
        <g class="cr__env" data-role="env-a" data-at="reg"><rect width="156" height="16" rx="4" class="d-c" /><text x="78" y="12" class="t mono center cr__envtext"></text></g>

        <g class="part" data-part="atk"><rect x="262" y="306" width="236" height="50" rx="8" class="d-bad" /><text x="380" y="325" class="t b center">Attacker watching Ledger A</text><text x="380" y="342" class="t small center mono" data-role="atk-sees">sees only the hash</text></g>
        <g class="part" data-part="atkWatch"><path d="M177,280 L300,306" class="line bad dash" /><text x="130" y="324" class="t small center">reads the commit: a hash only</text></g>
        <g class="part" data-part="atkX"><path d="M460,306 L583,280" class="line bad dash" marker-end={`url(#${id}-arr-bad)`} /><text x="521" y="299" class="t b center" style="fill:var(--bad);font-size:18px">✕</text><text x="630" y="324" class="t small center">learns neither id nor key</text></g>
      </svg>
      </div>
      <p class="sim__scroll-note">Wider than a phone; scroll it sideways if you need to.</p>

      <div class="sim__controls">
        <button class="btn" type="button" data-role="prev">◀ Prev</button>
        <button class="btn primary" type="button" data-role="next">Next ▶</button>
        <button class="btn" type="button" data-role="reset">Reset</button>
        <span class="spacer"></span>
        <button class="btn" type="button" data-role="reroll">New random id / keypair</button>
      </div>
      <div class="sim__log" data-role="log">The registrant holds a channel id and a keypair. Neither ledger knows anything yet.</div>

      <div class="steps" style="margin-top:10px">
        <div class="step-card" data-role="card">
          {steps.map((s, i) => (
            <div data-card={i} hidden={i !== 0}>
              <div class="phase">{s.phase}</div>
              <h4>{s.t}</h4>
              <p>{s.plain}</p>
              <p class="proto"><strong>In protocol terms.</strong> <span set:html={s.proto} /></p>
              <p class="small" style="margin:6px 0 0">Source: {s.refs.map((r, j) => (<><a href={r.h} rel="noopener">{r.l}</a>{j < s.refs.length - 1 ? ' · ' : ''}</>))}</p>
            </div>
          ))}
        </div>
        <div class="cr__vals">
          <div class="cr__row"><b>channel id</b><span><code data-role="v-chan">…</code> <span class="small">32 random bytes</span></span></div>
          <div class="cr__row"><b>public key</b><span><code data-role="v-pub">…</code> <span class="small">64 random bytes standing in for an uncompressed secp256k1 key</span></span></div>
          <div class="cr__row" data-from="1"><b>ownership commitment</b><span><code data-role="v-commit">…</code> <span class="small">a hash of the channel id followed by the public key</span></span></div>
          <div class="cr__row" data-from="5"><b>signature</b><span><code>(placeholder)</code> <span class="small">no real signature runs on this page; the message signed and the scheme are ledger-specific</span></span></div>
          <details class="cr__full"><summary class="small">Full hex, to check with your own keccak256</summary><pre data-role="full"></pre></details>
        </div>
      </div>
    </div>

    <div data-panel="connector" hidden>
      <p class="small" style="margin:0 0 10px">A connector is registered with the same two phases, commit and reveal, on each ledger. Its id is derived rather than chosen, from the channel id, the operator's public key and a 32-byte salt. Everything below is computed live from the channel id and public key of the other tab.</p>
      <div class="cr__vals">
        <div class="cr__row"><b>channel id</b><span><code data-role="c-chan">…</code></span></div>
        <div class="cr__row"><b>public key</b><span><code data-role="c-pub">…</code></span></div>
        <div class="cr__row"><b>salt</b><span><code data-role="c-salt">…</code> <button class="btn" type="button" data-role="salt-random">random salt</button> <button class="btn" type="button" data-role="salt-zero">zero salt</button> <span class="small">different salts let one operator register several connectors on the same channel</span></span></div>
        <div class="cr__row"><b>connector id</b><span><code data-role="c-id">…</code> <span class="small">a hash of the channel id, the public key and the salt; with the same key encoding and salt it is the same on both ledgers, and it belongs to this one channel</span></span></div>
        <div class="cr__row"><b>ownership commitment</b><span><code data-role="c-commit">…</code> <span class="small">a hash of the connector id followed by the public key; the commit carries it, and a ledger may also require the channel id there</span></span></div>
      </div>
      <p class="small" style="margin:10px 0 0"><strong>Reveal.</strong> The operator presents the channel, the connector id, the public key, the salt, a signature proving control of the key, the connector's contract on this ledger and the connector's admin; a ledger may require more, such as the stake. The CLPR Service re-derives the id and rejects the reveal if the commitment is not pending, the channel does not exist on this ledger, the connector is already registered on it, the signature fails, the contract is not deployed on this ledger, or the deployment's stake requirement is not met. Otherwise it creates the connector record and keeps the commitment, recorded as completed. A connector carries messages only if it is registered on <em>both</em> ledgers, on the same channel with the same id: on the source ledger it authorises messages, on the destination it pays for executing them. A DATA message that names a connector not registered on the destination is answered with <code>CONNECTOR_NOT_FOUND</code>. The connector's admin may remove it on one ledger, but not while it has messages in flight there.</p>
      <p class="small" style="margin:6px 0 0">Source: <a href={connectorSetup('1-connector-identity')} rel="noopener">Connector setup §1</a> · <a href={connectorSetup('2-registration')} rel="noopener">§2</a> · <a href={connectorSetup('3-connectors-on-both-ledgers')} rel="noopener">§3</a> · <a href={connectorSetup('5-removal')} rel="noopener">§5</a>.</p>
    </div>

    <p class="small" style="margin:8px 0 0"><strong>On EVM ledgers the channel id is constrained.</strong> The EVM Ledger Specifications derive it from the two ledgers' chain ids, the registrant's key and a salt, and the CLPR Service rejects any other id at the reveal; a channel with an EVM ledger on either side uses that derived id on both ledgers. The EVM registration signature is also bound to the address of the CLPR Service on which the registration completes. See <a href={EVM_ID} rel="noopener">EVM ledger family §4</a> and <a href={EVM_SIG} rel="noopener">§5</a>, and <a href={HIERO_SIG} rel="noopener">Hiero ledger §5</a> for the Hiero signatures.</p>

    <Callout kind="impl">
      <p>The EVM reference contracts in <a href={LIFECYCLE} rel="noopener">clpr-smart-contracts (lifecycle notes)</a> differ from the specification in two places that matter here.</p>
      <ul style="margin-bottom:0">
        <li><strong>The commit also names the channel id.</strong> The reference contracts' commit takes the channel id in the clear next to the commitment, only to keep an index from id to commitment so that the owner's close can remove an abandoned pending commitment; the id is not checked until the reveal. In the specification the commit carries the commitment alone.</li>
        <li><strong>The commitment is deleted at the reveal.</strong> The reference contracts delete the pending commitment when the channel is completed (<a href={sol('src/logic/ChannelLogic.sol')} rel="noopener">channel logic</a>); the specification keeps it, recorded as completed.</li>
      </ul>
    </Callout>

    <p class="small" style="margin:8px 0 0">Source: <a href={channelSetup('2-registration')} rel="noopener">Channel setup §2</a> · <a href={channelSetup('4-verifier-binding')} rel="noopener">§4</a> · <a href={channelSetup('6-shared-channel-state')} rel="noopener">§6</a> · <a href={service('25-closing-a-channel')} rel="noopener">CLPR Service §2.5</a> · <a href={LIFECYCLE} rel="noopener">lifecycle notes</a> (EVM reference contracts). The hash function is implemented in this page and self-tested against standard vectors at load.</p>
  </div>
</div>
<style>
  /* Arrows appear only on their step; the boxes that will fill in later stay as a faint skeleton. */
  .commitreveal .part { opacity: 0; transition: opacity 250ms; }
  .commitreveal .part[data-part^="ver"], .commitreveal .part[data-part^="prf"], .commitreveal .part[data-part="atk"] { opacity: 0.12; }
  .commitreveal .part.on { opacity: 1; }
  /* After the reveal the attacker stays faintly on the map, cross included, so the story still reads. */
  .commitreveal .part.faint { opacity: 0.35; }
  /* The solid arrows draw on along their length when their step lands. */
  .commitreveal .part[data-part^="reg"] path, .commitreveal .part[data-part^="rev"] path { stroke-dasharray: 130; stroke-dashoffset: 130; transition: stroke-dashoffset 350ms ease 80ms; }
  .commitreveal .part.on[data-part^="reg"] path, .commitreveal .part.on[data-part^="rev"] path { stroke-dashoffset: 0; }
  /* The commitment: one token per ledger, travelling from the registrant to its ledger. */
  .commitreveal .cr__env { opacity: 0; transform: translate(302px, 60px); transition: transform 450ms ease, opacity 250ms; }
  .commitreveal .cr__env[data-role="env-b"] { transform: translate(306px, 64px); }
  .commitreveal .cr__env[data-at="a"] { transform: translate(166px, 128px); }
  .commitreveal .cr__env[data-at="b"] { transform: translate(572px, 128px); }
  .commitreveal .cr__env.shown { opacity: 1; }
  .commitreveal .cr__envtext { font-size: 10px; }
  .commitreveal .cr__st { transform-box: fill-box; transform-origin: center; }
  .commitreveal .cr__st.pulse { animation: cr-pop 600ms ease; }
  @keyframes cr-pop { 50% { transform: scale(1.3); } }
  /* Progress track: each segment takes the colour of the actor that acts at that step. */
  .commitreveal .sim__track.seg > i.now { opacity: 0.55; }
  .commitreveal .sim__track.seg > i[data-tone="a"].done, .commitreveal .sim__track.seg > i[data-tone="a"].now { background: var(--a); }
  .commitreveal .sim__track.seg > i[data-tone="b"].done, .commitreveal .sim__track.seg > i[data-tone="b"].now { background: var(--b); }
  .commitreveal .sim__track.seg > i[data-tone="c"].done, .commitreveal .sim__track.seg > i[data-tone="c"].now { background: var(--c); }
  .commitreveal .sim__track.seg > i[data-tone="bad"].done, .commitreveal .sim__track.seg > i[data-tone="bad"].now { background: var(--bad); }
  .commitreveal .sim__track.seg > i[data-tone="ok"].done, .commitreveal .sim__track.seg > i[data-tone="ok"].now { background: var(--ok); }
  /* Controls and log sit under the drawing as one bordered block. */
  .commitreveal .sim__body .sim__controls { border: 1px solid var(--border); border-radius: 8px 8px 0 0; margin: 10px 0 0; }
  .commitreveal .sim__body .sim__log { border: 1px solid var(--border); border-top: 0; border-radius: 0 0 8px 8px; padding: 8px 14px; min-height: 0; }
  .cr__tabs { margin: 0 0 12px; }
  .cr__vals { font-size: 0.88rem; border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; background: var(--surface); min-width: 0; }
  .cr__row { display: grid; grid-template-columns: minmax(0, 13em) minmax(0, 1fr); gap: 4px 10px; padding: 5px 0; border-bottom: 1px solid var(--border); align-items: baseline; }
  .cr__row[hidden] { display: none; }
  .cr__row[data-from]:not([hidden]) { animation: cr-row 220ms ease-out; }
  @keyframes cr-row { from { opacity: 0; transform: translateY(4px); } }
  .cr__row code.flash { animation: cr-flash 600ms ease-out; }
  @keyframes cr-flash { from { background: var(--ok-soft); border-color: var(--ok); } }
  .cr__row:last-of-type { border-bottom: 0; }
  .cr__row b { color: var(--text-2); font-weight: 600; font-family: var(--mono); font-size: 0.8rem; overflow-wrap: anywhere; }
  .cr__row code { overflow-wrap: anywhere; }
  .cr__row .small { display: block; margin-left: 0; }
  .cr__row .btn { font-size: 0.78rem; padding: 3px 8px; margin-right: 4px; }
  .cr__full { margin-top: 6px; }
  .cr__full summary { cursor: pointer; }
  .cr__full pre { font-size: 0.72rem; white-space: pre-wrap; overflow-wrap: anywhere; margin: 6px 0 0; }
  @media (max-width: 560px) { .cr__row { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>

<script>
  // ---------- Keccak-256, self-contained. Keccak-f[1600], rate 136 bytes, pad10*1 with the
  // original Keccak domain byte 0x01 (SHA-3 would use 0x06). Lanes are little-endian uint64,
  // held as BigInt: slow by hashing-library standards, plenty for a handful of hashes.
  const M64 = (1n << 64n) - 1n;
  const RC = [
    0x0000000000000001n, 0x0000000000008082n, 0x800000000000808an, 0x8000000080008000n,
    0x000000000000808bn, 0x0000000080000001n, 0x8000000080008081n, 0x8000000000008009n,
    0x000000000000008an, 0x0000000000000088n, 0x0000000080008009n, 0x000000008000000an,
    0x000000008000808bn, 0x800000000000008bn, 0x8000000000008089n, 0x8000000000008003n,
    0x8000000000008002n, 0x8000000000000080n, 0x000000000000800an, 0x800000008000000an,
    0x8000000080008081n, 0x8000000000008080n, 0x0000000080000001n, 0x8000000080008008n,
  ];
  // Rotation offsets r[x][y], indexed ROT[x][y].
  const ROT = [[0, 36, 3, 41, 18], [1, 44, 10, 45, 2], [62, 6, 43, 15, 61], [28, 55, 25, 21, 56], [27, 20, 39, 8, 14]];
  const rotl = (v: bigint, n: number): bigint => (n === 0 ? v : ((v << BigInt(n)) | (v >> BigInt(64 - n))) & M64);
  function keccakF(A: bigint[]): void {
    for (let r = 0; r < 24; r++) {
      const C = [0, 1, 2, 3, 4].map((x) => A[x] ^ A[x + 5] ^ A[x + 10] ^ A[x + 15] ^ A[x + 20]);
      for (let x = 0; x < 5; x++) {
        const D = C[(x + 4) % 5] ^ rotl(C[(x + 1) % 5], 1);
        for (let y = 0; y < 25; y += 5) A[x + y] ^= D;
      }
      const B: bigint[] = new Array(25).fill(0n);
      for (let x = 0; x < 5; x++) for (let y = 0; y < 5; y++) B[y + 5 * ((2 * x + 3 * y) % 5)] = rotl(A[x + 5 * y], ROT[x][y]);
      for (let y = 0; y < 25; y += 5) for (let x = 0; x < 5; x++) A[x + y] = B[x + y] ^ (~B[((x + 1) % 5) + y] & M64 & B[((x + 2) % 5) + y]);
      A[0] ^= RC[r];
    }
  }
  function keccak256(msg: Uint8Array): Uint8Array {
    const rate = 136;
    const padded = new Uint8Array(Math.ceil((msg.length + 1) / rate) * rate);
    padded.set(msg);
    padded[msg.length] ^= 0x01;
    padded[padded.length - 1] ^= 0x80;
    const A: bigint[] = new Array(25).fill(0n);
    for (let off = 0; off < padded.length; off += rate) {
      for (let i = 0; i < 17; i++) {
        let lane = 0n;
        for (let b = 7; b >= 0; b--) lane = (lane << 8n) | BigInt(padded[off + i * 8 + b]);
        A[i] ^= lane;
      }
      keccakF(A);
    }
    const out = new Uint8Array(32);
    for (let i = 0; i < 4; i++) { let lane = A[i]; for (let b = 0; b < 8; b++) { out[i * 8 + b] = Number(lane & 0xffn); lane >>= 8n; } }
    return out;
  }

  const enc = new TextEncoder();
  const hex = (b: Uint8Array): string => Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
  const cat = (...parts: Uint8Array[]): Uint8Array => { const o = new Uint8Array(parts.reduce((n, p) => n + p.length, 0)); let k = 0; for (const p of parts) { o.set(p, k); k += p.length; } return o; };
  const rnd = (n: number): Uint8Array => crypto.getRandomValues(new Uint8Array(n));
  // Self-test against the standard Keccak-256 vectors. If this fails, no hash is ever shown.
  let HASH_OK = false;
  try {
    HASH_OK = hex(keccak256(new Uint8Array(0))) === 'c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470'
      && hex(keccak256(enc.encode('abc'))) === '4e03657aea45a94fc7d47ba826c8d667c0d1e6e33a64a036ec44f58fa12d6c45';
  } catch { HASH_OK = false; }
  const K = (b: Uint8Array): Uint8Array | null => (HASH_OK ? keccak256(b) : null);
  const UNAVAILABLE = '(hash unavailable)';
  const short = (b: Uint8Array): string => '0x' + hex(b.subarray(0, 4)) + '…' + hex(b.subarray(b.length - 3));
  const hs = (b: Uint8Array | null): string => (b ? short(b) : UNAVAILABLE);
  const hf = (b: Uint8Array | null): string => (b ? '0x' + hex(b) : UNAVAILABLE);

  // Which SVG parts are visible at each step 0..7 (not cumulative: each step is a full picture).
  const SHOW: string[][] = [
    [], [], ['regA'], ['regB'], ['atk', 'atkWatch', 'atkX'],
    ['revA', 'verA', 'prfA'], ['verA', 'prfA', 'revB', 'verB', 'prfB'], ['verA', 'prfA', 'verB', 'prfB'],
  ];
  // From the first reveal on, the attacker's part of the picture stays faintly visible.
  const FAINT = new Set(['atk', 'atkWatch', 'atkX']);
  type St = 'none' | 'PENDING' | 'ACTIVE';
  const stateAt = (step: number, pendingAt: number, activeAt: number): St => (step >= activeAt ? 'ACTIVE' : step >= pendingAt ? 'PENDING' : 'none');

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('.sim.commitreveal'))) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const text = (role: string, s: string) => { const el = root.querySelector<HTMLElement>(`[data-role="${role}"]`); if (el) el.textContent = s; };
    const log = $('[data-role="log"]');
    const parts = Array.from(root.querySelectorAll<SVGGElement>('g.part'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('.cr__row[data-from]'));
    const segs = Array.from(root.querySelectorAll<HTMLElement>('[data-role="track"] > i'));
    const clock = $('[data-role="clock"]');
    const prevBtn = $('[data-role="prev"]') as HTMLButtonElement;
    const nextBtn = $('[data-role="next"]') as HTMLButtonElement;
    const envs = { a: $('[data-role="env-a"]'), b: $('[data-role="env-b"]') };
    // One-shot animations: the class comes off when the animation ends, so it can fire again.
    root.addEventListener('animationend', (e) => { const el = e.target as HTMLElement; el.classList.remove('flash'); el.classList.remove('pulse'); });
    let first = true;
    // A short hex value that flashes when it changes (not on the first paint).
    const code = (role: string, s: string) => { const el = root.querySelector<HTMLElement>(`[data-role="${role}"]`); if (!el || el.textContent === s) return; el.textContent = s; if (!first) el.classList.add('flash'); };
    const TOTAL = 7;
    let step = 0;
    let chan = rnd(32);
    let pub = rnd(64);
    let salt = new Uint8Array(32);

    function values() {
      const commit = K(cat(chan, pub));
      const conId = K(cat(chan, pub, salt));
      const conCommit = conId ? K(cat(conId, pub)) : null;
      return { commit, conId, conCommit };
    }

    const lastSt: Record<'a' | 'b', St> = { a: 'none', b: 'none' };
    function setLedger(k: 'a' | 'b', st: St, commit: Uint8Array | null) {
      const pill = $(`[data-role="${k}-pill"]`);
      pill.setAttribute('class', st === 'ACTIVE' ? 'd-ok' : st === 'PENDING' ? 'd-grey' : 'd-surface');
      text(`${k}-st`, st);
      if (st !== lastSt[k] && st !== 'none') $(`[data-role="${k}-st"]`).classList.add('pulse');
      lastSt[k] = st;
      // The commitment token: at the registrant until the commit lands on this ledger; revealed at the reveal.
      const env = envs[k];
      env.classList.toggle('shown', step >= 1);
      env.dataset.at = st === 'none' ? 'reg' : k;
      env.querySelector('rect')!.setAttribute('class', st === 'ACTIVE' ? 'd-ok' : 'd-c');
      env.querySelector('text')!.textContent = st === 'ACTIVE' ? `reveal ${short(chan)}` : `commit ${hs(commit)}`;
      if (st === 'none') { text(`${k}-r1`, 'no channel record'); text(`${k}-r2`, ''); text(`${k}-r3`, ''); }
      else if (st === 'PENDING') { text(`${k}-r1`, 'PENDING · a commitment, no channel'); text(`${k}-r2`, `commitment ${hs(commit)}`); text(`${k}-r3`, 'channel id ?  public key ?  (hidden)'); }
      else { text(`${k}-r1`, 'ACTIVE · commitment kept'); text(`${k}-r2`, `channel id ${short(chan)}`); text(`${k}-r3`, 'verifier fixed · peer config stored'); }
    }

    function render() {
      const v = values();
      const aSt = stateAt(step, 2, 5);
      const bSt = stateAt(step, 3, 6);
      setLedger('a', aSt, v.commit);
      setLedger('b', bSt, v.commit);
      const on = new Set(SHOW[step]);
      const faint = step >= 5;
      for (const p of parts) {
        p.classList.toggle('on', on.has(p.dataset.part!));
        p.classList.toggle('faint', faint && FAINT.has(p.dataset.part!));
      }
      for (const c of cards) c.hidden = Number(c.dataset.card) !== step;
      for (const r of rows) r.hidden = Number(r.dataset.from) > step;
      for (let i = 0; i < segs.length; i++) {
        segs[i].classList.toggle('done', i + 1 < step || step === TOTAL);
        segs[i].classList.toggle('now', i + 1 === step && step < TOTAL);
      }
      const clockText = `step ${step} / ${TOTAL}`;
      if (clock.textContent !== clockText && !first) clock.classList.add('pulse');
      clock.textContent = clockText;
      clock.classList.toggle('ok', step === TOTAL);
      clock.classList.toggle('grey', step !== TOTAL);
      prevBtn.disabled = step === 0;
      nextBtn.disabled = step === TOTAL;
      code('v-chan', short(chan)); code('v-pub', short(pub)); code('v-commit', hs(v.commit));
      text('atk-sees', `sees only ${hs(v.commit)}`);
      code('c-chan', short(chan)); code('c-pub', short(pub)); code('c-salt', short(salt));
      code('c-id', hs(v.conId)); code('c-commit', hs(v.conCommit));
      text('full', [
        `channel id            = 0x${hex(chan)}`,
        `public key            = 0x${hex(pub)}`,
        `ownership commitment  = ${hf(v.commit)}`,
      ].join('\n'));
      const c = hs(v.commit);
      const LOG: string[] = [
        `The registrant holds channel id <code>${short(chan)}</code> and a keypair. Neither ledger knows anything yet. Press <strong>Next</strong>.`,
        `<strong>ownership commitment = ${c}</strong>, the specification\'s commitment, computed by this page.`,
        `Ledger A: <strong>PENDING</strong>: commitment ${c} recorded, no channel yet. Ledger B: nothing yet.`,
        `Ledger A: <strong>PENDING</strong>. Ledger B: <strong>PENDING</strong>. Both hold the same 32-byte hash; neither knows the id or the key.`,
        `<span class="bad">The attacker holds ${c} and nothing else:</span> not the channel id, not the public key, not the private key. It cannot complete this commitment.`,
        `Ledger A: <span class="ok">ACTIVE</span> for channel id ${short(chan)}; the commitment is kept, recorded as completed; the verifier is fixed. Ledger B: still PENDING.`,
        `Ledger B: <span class="ok">ACTIVE</span> too. The same channel id now exists on both ledgers, each with its own verifier.`,
        `Done: two ACTIVE channel records, one channel id ${short(chan)}, two verifiers. The registrant holds no authority over the channel. Syncing may begin.`,
      ];
      log.innerHTML = HASH_OK ? LOG[step] : `<span class="bad">The hash self-test failed in this browser;</span> hash values are shown as "${UNAVAILABLE}". ` + LOG[step];
      const st = `A: ${aSt} · B: ${bSt}`;
      const LINE: string[] = [
        `step 0 · off the ledgers · channel id ${short(chan)} · ${st}`,
        `step 1 · ownership commitment = ${c} · ${st}`,
        `step 2 · A: commit ${c} · ${st}`,
        `step 3 · B: commit ${c} · ${st}`,
        `step 4 · attacker sees ${c} only · ${st}`,
        `step 5 · A: reveal ${short(chan)}, … · ${st}`,
        `step 6 · B: reveal ${short(chan)}, … · ${st}`,
        `step 7 · done · ${st}`,
      ];
      const line = document.createElement('span');
      line.className = 'line';
      line.textContent = LINE[step];
      log.prepend(line);
      first = false;
    }

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    function showTab(tab: string) {
      for (const x of tabs) x.setAttribute('aria-pressed', String(x.dataset.tab === tab));
      for (const p of panels) p.hidden = p.dataset.panel !== tab;
    }
    for (const b of tabs) b.addEventListener('click', () => showTab(b.dataset.tab!));
    // The step controls live inside the channel panel, so they cannot be pressed from the connector tab.
    nextBtn.addEventListener('click', () => { step = Math.min(TOTAL, step + 1); render(); });
    prevBtn.addEventListener('click', () => { step = Math.max(0, step - 1); render(); });
    $('[data-role="reset"]').addEventListener('click', () => { step = 0; render(); });
    $('[data-role="reroll"]').addEventListener('click', () => { chan = rnd(32); pub = rnd(64); render(); });
    $('[data-role="salt-random"]').addEventListener('click', () => { salt = rnd(32); render(); });
    $('[data-role="salt-zero"]').addEventListener('click', () => { salt = new Uint8Array(32); render(); });
    render();
  }
</script>
