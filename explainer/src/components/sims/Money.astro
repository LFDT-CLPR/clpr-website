---
/**
 * Connector economics on the destination ledger, as the Recommendations describe them (Channel
 * economics §1 and §2, Stakes and bonds §2). A deployment may differ.
 *   The destination connector pays the execution cost plus one Service-wide margin to the bundle
 *   submitter; no share goes to the Service except through the administrator fallback.
 *   CONNECTOR_UNDERFUNDED: the message is not dispatched, the local connector is slashed, and the
 *   source connector is slashed again when the REPLY reaches the source ledger.
 *   CONNECTOR_NOT_FOUND: no slash on the destination, the submitter absorbs the cost; the source
 *   connector is slashed when the REPLY arrives.
 *   SUCCESS, APPLICATION_ERROR: no slash.
 * Penalties go to the submitter of the bundle being processed. Endpoints are never slashed.
 * The penalty and stake amounts here are illustrative; the page shows no parameter or formula.
 */
import Refs from '@kse/components/Refs.astro';
const { id = 'money-sim', detail = false } = Astro.props as { id?: string; detail?: boolean };
const refs = [
  { doc: 'economics', anchor: '1-execution-charges', label: 'Channel economics §1' },
  { doc: 'economics', anchor: '2-payment-to-the-bundle-submitter', label: 'Channel economics §2' },
  { doc: 'stakes', anchor: '21-when-a-connector-is-slashed', label: 'Stakes and bonds §2.1' },
  { doc: 'stakes', anchor: '22-penalty', label: 'Stakes and bonds §2.2' },
  { doc: 'stakes', anchor: '23-proceeds', label: 'Stakes and bonds §2.3' },
  { doc: 'openIssues', anchor: 'oi-5-calibration-of-the-connector-stake', label: 'Open issues OI-5' },
];
// The defaults, rendered at build time so the card is complete before the script runs.
// The script's render() produces the same strings for the same inputs; keep the two in step.
const DEF = { gas: 4, margin: 10, balance: 20 };
const defCost = DEF.gas; // 400k gas at 100,000 gas per unit
const defCharge = +(defCost * (1 + DEF.margin / 100)).toFixed(2);
const defFill = `${(Math.min(defCharge, DEF.balance) / Math.max(DEF.balance, defCharge, 1)) * 100}%`;
---
<div class="sim money" id={id}>
  <div class="sim__head"><div><span class="kind">Simulation</span><h3>A message arrives on Ledger B. Who pays whom?</h3></div><span class="pill ok" data-role="status">SUCCESS</span></div>
  <div class="sim__body">
    <div class="steps two" style="--l:.9fr;--r:1.1fr">
      <div class="money__inputs">
        <p class="small" style="margin:0">Amounts are in "units" of Ledger B's native token. One unit buys 100,000 gas. Charging and slashing follow the recommended design; a deployment may differ. The model is simplified: the charge is the gas the application uses plus the margin, and the connector is underfunded when its balance cannot cover it. Each ledger measures and collects the charge in its own way.</p>
        <label class="range"><span>Gas the application uses</span><input type="range" min="1" max="20" value={DEF.gas} data-in="gas" id={`${id}-gas`} /><output data-out="gas" for={`${id}-gas`}>{DEF.gas * 100}k gas</output></label>
        <label class="range"><span>Margin (one value for the whole Service)</span><input type="range" min="0" max="50" value={DEF.margin} data-in="margin" id={`${id}-margin`} /><output data-out="margin" for={`${id}-margin`}>{DEF.margin}%</output></label>
        <label class="range"><span>Destination connector balance</span><input type="range" min="0" max="40" value={DEF.balance} data-in="balance" id={`${id}-balance`} /><output data-out="balance" for={`${id}-balance`}>{DEF.balance} units</output></label>
        <label class="range money__check"><input type="checkbox" data-in="missing" /><span>the connector was never registered on Ledger B</span></label>
        {detail && (
          <ul class="small money__slash">
            <li>Destination, no local connector: no slash; the submitter absorbs the cost; reply <code>CONNECTOR_NOT_FOUND</code>.</li>
            <li>Destination, connector cannot pay: the local connector is slashed; the message is not dispatched; reply <code>CONNECTOR_UNDERFUNDED</code>.</li>
            <li>Source, reply <code>CONNECTOR_NOT_FOUND</code> or <code>CONNECTOR_UNDERFUNDED</code>: the source connector is slashed.</li>
            <li>Source, reply <code>SUCCESS</code> or <code>APPLICATION_ERROR</code>: no slash.</li>
          </ul>
        )}
      </div>
      <div class="result" data-role="result">
        <h4 data-role="title">Happy path</h4>
        <div data-role="meter">
          <div class="money__meter" aria-hidden="true"><i class="track" style="width:100%"></i><i class="fill" style={`width:${defFill}`}></i><i class="over" style="left:100%;width:0"></i></div>
          <p class="money__meter-cap" data-out="meter">charge {defCharge} · balance {DEF.balance}</p>
        </div>
        <div class="row"><b>execution cost</b><span data-out="cost">{defCost} units (what executing the message costs)</span></div>
        <div class="row"><b>connector charged</b><span data-out="charge">{defCharge} units: the execution cost plus the margin</span></div>
        <div class="row"><b>submitter receives</b><span data-out="paid">{defCharge} units</span></div>
        <div class="row"><b>submitter's net</b><span data-out="net"><span class="money__pos">+{(defCharge - defCost).toFixed(2)} units</span>; the margin</span></div>
        <div class="row"><b>balance after</b><span data-out="after">{(DEF.balance - defCharge).toFixed(2)} units</span></div>
        <div class="row"><b>reply to Ledger A</b><span data-out="reply"><span class="pill ok">SUCCESS</span> (or APPLICATION_ERROR if the application failed; no slash either way)</span></div>
        <div class="row"><b>back on Ledger A</b><span data-out="source">the reply is delivered to the sending application; the source connector pays for that delivery, and no connector is slashed</span></div>
      </div>
    </div>
    <Refs refs={[...refs]} />
  </div>
  <div class="sim__controls">
    <button class="btn" type="button" data-role="reset">Reset to defaults</button>
  </div>
  <div class="sim__log sim__log--tall" data-role="log">
    <span class="line" data-role="line">charge {defCharge} units · balance {DEF.balance} units · reply SUCCESS</span>
    <span data-role="prose">The connector is charged the message's execution cost plus the margin, and the submitter receives it. No share goes to the Service or its administrator, except as a fallback when payment to the submitter fails: each charge is paid to whoever submitted the bundle, and when the reply arrives the source connector pays for its delivery to the Ledger A submitter in the same way. The margin covers the submitter's overhead and gives it a reason to submit; drag the balance down to see what happens when the promise to pay is broken.</span>
  </div>
</div>

<style>
  .money__inputs { display: grid; gap: 10px; align-content: start; }
  .money .range { display: flex; flex-wrap: wrap; gap: 4px 8px; }
  .money .range > span { flex: 1 1 100%; }
  .money .range input[type="range"] { flex: 1 1 140px; width: auto; }
  .money .range output { min-width: 7ch; text-align: right; }
  .money .money__check { flex-wrap: nowrap; align-items: start; }
  .money .money__check > span { flex: 1 1 auto; }
  .money__slash { margin: 0; padding-left: 1.1em; display: grid; gap: 4px; }
  .money .result { border-left: 4px solid var(--ok); }
  .money .result.bad { border-left-color: var(--bad); }
  .money .row span { font-variant-numeric: tabular-nums; }
  /* The shared phone rule for .result .row is overridden by a later rule of equal specificity in global.css. */
  @media (max-width: 520px) { .money .result .row { grid-template-columns: 1fr; gap: 2px; } }
  .money__meter { position: relative; height: 8px; margin: 2px 0; border-radius: 4px; overflow: hidden; }
  .money__meter > i { position: absolute; top: 0; bottom: 0; left: 0; display: block; border-radius: 4px; transition: width 250ms, left 250ms; }
  .money__meter > .track { background: var(--grey-soft); }
  .money__meter > .fill { background: var(--money); }
  .money__meter > .over { background: var(--bad); }
  .money__meter-cap { font-family: var(--mono); font-size: 0.75rem; color: var(--text-3); margin: 0 0 8px; }
  .money__pos { color: var(--ok); }
  .money__neg { color: var(--bad); }
  .money [data-out] { border-radius: 3px; }
  .money [data-out].changed { animation: money-flash 600ms ease-out; }
  @keyframes money-flash { from { background-color: var(--a-soft); } }
</style>

<script>
  for (const root of Array.from(document.querySelectorAll<HTMLElement>('.sim.money'))) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const inp = (n: string) => root.querySelector<HTMLInputElement>(`[data-in="${n}"]`)!;
    const out = (n: string) => root.querySelector<HTMLElement>(`[data-out="${n}"]`)!;
    const STAKE = 20; const FINE = 5; // illustrative stake and penalty
    const DEFAULTS: Record<string, string> = { gas: '4', margin: '10', balance: '20' };
    const status = $('[data-role="status"]');
    const result = $('[data-role="result"]');
    const title = $('[data-role="title"]');
    const meter = $('[data-role="meter"]');
    const mTrack = meter.querySelector<HTMLElement>('.track')!;
    const mFill = meter.querySelector<HTMLElement>('.fill')!;
    const mOver = meter.querySelector<HTMLElement>('.over')!;
    const line = $('[data-role="line"]');
    const prose = $('[data-role="prose"]');
    const signed = (v: number) => `${v < 0 ? '-' : '+'}${Math.abs(v).toFixed(2)}`;
    let silent = true; // no flashes on the first render: it only confirms the server-rendered defaults

    // Write a value and flash it when it actually changed.
    function set(name: string, html: string) {
      const el = out(name);
      const before = el.innerHTML;
      el.innerHTML = html;
      if (silent || el.innerHTML === before) return;
      el.classList.remove('changed'); void el.offsetWidth; el.classList.add('changed');
    }
    function setStatus(text: string, kind: 'ok' | 'bad') {
      if (status.textContent === text) return;
      status.textContent = text; status.className = `pill ${kind}`;
      if (!silent) status.classList.add('pulse');
    }
    function drawMeter(charge: number, balance: number, missing: boolean) {
      meter.hidden = missing;
      const scale = Math.max(balance, charge, 1);
      mTrack.style.width = `${(balance / scale) * 100}%`;
      mFill.style.width = `${(Math.min(charge, balance) / scale) * 100}%`;
      mOver.style.left = `${(balance / scale) * 100}%`;
      mOver.style.width = `${(Math.max(0, charge - balance) / scale) * 100}%`;
      set('meter', `${balance < charge ? 'needed' : 'charge'} ${charge} · balance ${balance}`);
    }
    function render() {
      const gasK = Number(inp('gas').value) * 100; // thousands
      const margin = Number(inp('margin').value);
      const balance = Number(inp('balance').value);
      const missing = inp('missing').checked;
      set('gas', `${gasK}k gas`); set('margin', `${margin}%`); set('balance', `${balance} units`);
      const cost = gasK / 100; const charge = +(cost * (1 + margin / 100)).toFixed(2);
      set('cost', `${cost} units (what executing the message costs)`);
      drawMeter(charge, balance, missing);
      result.classList.toggle('bad', missing || balance < charge);
      if (missing) {
        title.textContent = 'Connector not found';
        set('charge', 'nothing; there is no connector to charge');
        set('paid', '0');
        set('net', `<span class="money__neg">${signed(-cost)} units</span> (absorbed; nothing on Ledger B can reimburse it)`);
        set('after', 'none');
        set('reply', '<span class="pill bad">CONNECTOR_NOT_FOUND</span>');
        set('source', `the source connector that authorized the message is slashed from its locked stake, and the penalty goes to the submitter of the bundle that carries the reply to Ledger A`);
        setStatus('CONNECTOR_NOT_FOUND', 'bad');
        line.textContent = `no connector on Ledger B; nothing charged; no slash on Ledger B; submitter absorbs ${cost} units`;
        prose.textContent = 'The message was authorized on Ledger A by a connector with no counterpart on Ledger B. The application is not called, and the message still gets its one REPLY. With no local connector there is nothing to slash on Ledger B, so the submitter there is not compensated. The source connector is slashed for having promised something it could not deliver.';
      } else if (balance < charge) {
        title.textContent = 'Connector underfunded';
        set('charge', `${charge} units needed, only ${balance} available`);
        set('paid', `${FINE} units, the penalty from the connector's locked stake (an illustrative amount)`);
        set('net', `<span class="${FINE - cost >= 0 ? 'money__pos' : 'money__neg'}">${signed(FINE - cost)} units</span>`);
        set('after', `balance ${balance}, stake ${STAKE - FINE} (was ${STAKE})`);
        set('reply', '<span class="pill bad">CONNECTOR_UNDERFUNDED</span>');
        set('source', 'the source connector is slashed too when the reply arrives, and the penalty goes to the Ledger A submitter. Penalties escalate with each slash and end in a ban that forfeits the remaining stake.');
        setStatus('CONNECTOR_UNDERFUNDED', 'bad');
        line.textContent = `charge ${charge} units > balance ${balance}; not dispatched; penalty ${FINE} from stake`;
        prose.textContent = 'The message is not dispatched. (On EVM ledgers the application gets only the gas the connector can pay for, and the connector is underfunded when that is none.) The connector promised to pay and cannot, so its stake is slashed and the penalty paid to the submitter, and the failure travels home as the reply, where the source connector is slashed as well. How large a stake should be to cover the losses a connector can cause is an open issue.';
      } else {
        title.textContent = 'Happy path';
        set('charge', `${charge} units: the execution cost plus the margin`);
        set('paid', `${charge} units`);
        set('net', `<span class="money__pos">${signed(charge - cost)} units</span>; the margin`);
        set('after', `${(balance - charge).toFixed(2)} units`);
        set('reply', '<span class="pill ok">SUCCESS</span> (or APPLICATION_ERROR if the application failed; no slash either way)');
        set('source', 'the reply is delivered to the sending application; the source connector pays for that delivery, and no connector is slashed');
        setStatus('SUCCESS', 'ok');
        line.textContent = `charge ${charge} units · balance ${balance} units · reply SUCCESS`;
        prose.textContent = 'The connector is charged the execution cost of the message plus the margin, and the submitter receives it. No share goes to the Service or its administrator, except as a fallback when payment to the submitter fails: each charge is paid to whoever submitted the bundle, and when the reply arrives the source connector pays for its delivery to the Ledger A submitter in the same way. The margin covers the submitter\'s overhead and gives it a reason to submit; drag the balance down to see what happens when the promise to pay is broken.';
      }
    }
    for (const el of Array.from(root.querySelectorAll('input'))) el.addEventListener('input', render);
    $('[data-role="reset"]').addEventListener('click', () => {
      for (const k of Object.keys(DEFAULTS)) inp(k).value = DEFAULTS[k];
      inp('missing').checked = false;
      render();
    });
    root.addEventListener('animationend', (e) => { const host = (e.target as Element).closest('.pulse'); if (host) host.classList.remove('pulse'); });
    render();
    silent = false;
  }
</script>
