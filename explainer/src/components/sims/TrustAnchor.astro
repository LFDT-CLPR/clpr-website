---
/**
 * Trust anchors, per Verifier interface §1 and §4 (stored with the channel, changed only by bundle
 * processing; trust anchor change versus update; several changes in one bundle), Endpoint sync §5.1
 * (transition bundles, catch-up) and the "Trust anchor changes" section of each proof scheme.
 *
 * Two modes. "Changing anchor" follows the qbft-epoch scheme: the source's validator set changes
 * V1 → V2 → …, the simulation calls the stretch one set seals blocks an epoch, and the anchor holds
 * one set with the epoch number as its id. "Fixed anchor" follows hints-wraps: the anchor is the
 * source's ledger id and never changes, because each roster's key is linked to it. Nothing here is
 * cryptographic; the outcomes follow the specification's rules for accepting, rejecting and changing.
 *
 * Every drawn state is a class (epoch boxes, arrows, verdict, Channel tint) so the shared SVG
 * transitions animate it; a small "bundle" chip rides along the top edge of the three boxes on
 * each submit, Endpoint to CLPR Service to its verifier: green and back to rest at the Service on
 * accept, red and back to the Endpoint on revert, grey and still on "not sent".
 */
import { verifierIface, transitions, endpointSync, channelSetup, service, openIssues, pinned } from '../../lib/sources';
const { id = 'trust-anchor' } = Astro.props as { id?: string };
const MAX = 7;
const epochs = Array.from({ length: MAX }, (_, i) => i + 1);
const scheme = (path: string, anchor = '7-trust-anchor-changes') => pinned('clpr-spec', path, anchor);
const LINKS = {
  viface1: verifierIface('1-verifier-contracts-and-trust-anchors'),
  viface3: verifierIface('3-verifybundle'),
  viface4: verifierIface('4-trust-anchor-changes'),
  catchup: endpointSync('51-trust-anchor-catch-up'),
  progress: transitions('3-progress'),
  processing: transitions('2-bundle-processing'),
  context: channelSetup('3-channel-context'),
  submit: service('52-checks-before-submitting'),
  verifierChoice: service('61-verifier-choice'),
  ledgers: pinned('clpr-spec', 'ledgers/README.md', 'proof-schemes'),
  hintsWraps: scheme('ledgers/hiero/proof-schemes/hints-wraps.md'),
  hints: scheme('ledgers/hiero/proof-schemes/hints.md'),
  qbftEpoch: scheme('ledgers/besu/proof-schemes/qbft-epoch.md'),
  qbftEpochTrust: scheme('ledgers/besu/proof-schemes/qbft-epoch.md', '2-trust-model'),
  qbftEpochLimit: scheme('ledgers/besu/proof-schemes/qbft-epoch.md', '5-encoding-algorithm'),
  hintsWrapsTrust: scheme('ledgers/hiero/proof-schemes/hints-wraps.md', '2-trust-model'),
  oi6: openIssues('oi-6-qbft-epoch-catch-up-across-a-validator-change'),
  qbftHeader: scheme('ledgers/besu/proof-schemes/qbft-header.md'),
  qbftContract: scheme('ledgers/besu/proof-schemes/qbft-contract.md'),
};
---
<div class="sim trustanchor" id={id} data-links={JSON.stringify(LINKS)}>
  <div class="sim__head">
    <div><span class="kind">Simulation</span><h3>Trust anchors: keeping up with the source's signers</h3></div>
    <span class="pill ok" data-role="state">anchor current</span>
  </div>
  <div class="sim__body">
    <div class="choices" role="group" aria-label="Proof scheme">
      <span class="small" style="align-self:center">Proof scheme:</span>
      <div class="seg">
        <button class="btn" type="button" data-mode="single" aria-pressed="true">A changing anchor (qbft-epoch)</button>
        <button class="btn" type="button" data-mode="fixed" aria-pressed="false">A fixed anchor (hints-wraps)</button>
      </div>
      <span class="small" style="align-self:center" data-role="mode-note">one validator set at a time, with the epoch as its id</span>
    </div>
    <div class="sim__scroll">
      <svg viewBox="0 0 760 336" role="img" aria-labelledby={`${id}-title`}>
      <title id={`${id}-title`}>Top: the source ledger's signers by epoch. Bottom: the endpoint submits each bundle to the destination's CLPR Service, which holds the channel's stored trust anchor and calls the destination's verifier.</title>
      <defs>
        <marker id={`${id}-arr`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--text-3)" /></marker>
      </defs>

      <!-- Source timeline -->
      <text x="20" y="18" class="t b" style="fill:var(--b)">Source ledger: who signs its blocks</text>
      <text x="740" y="18" class="t small" style="text-anchor:end" data-role="queue">outbound queue: 2 pending messages</text>
      {epochs.map((e) => {
        const x = 20 + (e - 1) * 104;
        return (
          <g data-epoch={e}>
            <text x={x + 48} y="40" class="t small center muted">epoch {e}</text>
            <rect x={x} y="46" width="96" height="42" rx="8" class={`ta__ebox ${e === 1 ? 'now' : 'future'}`} data-role="ebox" />
            {e > 1 && <rect x={x + 6} y="52" width="8" height="8" rx="1" fill="var(--text-3)" />}
            <text x={x + 48} y="66" class={`t b center${e === 1 ? '' : ' muted'}`} data-role="ename">V{e}</text>
            <text x={x + 48} y="81" class="t small center" data-role="enote">{e === 1 ? 'signing now' : ''}</text>
          </g>
        );
      })}
      <rect data-role="trusted" class="ta__trusted" x="20" y="96" width="96" height="4" rx="2" />
      <text x="92" y="114" class="t small center ta__ok" data-role="trusted-label">trusted by the destination</text>
      <rect x="20" y="126" width="8" height="8" rx="1" fill="var(--text-3)" />
      <text x="34" y="134" class="t small muted" data-role="marker-note">the block where the set changes: sealed by the previous validator set, names the next one</text>

      <!-- Endpoint -->
      <g>
        <rect x="20" y="152" width="200" height="128" rx="10" class="d-c" />
        <text x="30" y="172" class="t b">Endpoint</text>
        <text x="30" y="190" class="t small" data-role="ep-status">online, sees epoch 1</text>
        <text x="30" y="207" class="t small">source's anchor ids so far:</text>
        <text x="30" y="223" class="t mono" data-role="ep-record">1</text>
        <text x="30" y="244" class="t small" data-role="ep-remote">remote anchor id 1: current</text>
        <text x="30" y="261" class="t small" data-role="ep-todo"></text>
      </g>
      <line x1="220" y1="216" x2="248" y2="216" class="line" marker-end={`url(#${id}-arr)`} data-role="arr1" />

      <!-- Destination ledger: the CLPR Service holds the channel, receives the bundle and calls its Verifier -->
      <g>
        <rect x="250" y="152" width="222" height="128" rx="10" class="d-a ta__ch ok" data-role="ch-box" />
        <text x="262" y="172" class="t b">Destination CLPR Service</text>
        <text x="262" y="190" class="t mono" data-role="ch-anchor">trust anchor: V1</text>
        <text x="262" y="206" class="t mono" data-role="ch-id">trust anchor id: 1</text>
        <text x="262" y="225" class="t small">its verifier accepts</text>
        <g data-role="ch-pills">
          <g data-pill="0"><rect x="262" y="233" width="52" height="20" rx="10" class="d-ok" /><text x="288" y="247" class="t small center b ta__ok">V1</text></g>
          <g data-pill="1" class="ta__pill off"><rect x="322" y="233" width="52" height="20" rx="10" class="d-ok" /><text x="348" y="247" class="t small center b ta__ok">V2</text></g>
        </g>
        <text x="262" y="271" class="t small muted">opaque bytes to the Service</text>
      </g>
      <line x1="472" y1="216" x2="490" y2="216" class="line" marker-end={`url(#${id}-arr)`} data-role="arr2" />
      <rect x="250" y="292" width="222" height="38" rx="8" class="d-grey" />
      <text x="262" y="308" class="t small b">channel context: never changes</text>
      <text x="262" y="323" class="t mono">channel id · Service address</text>

      <!-- Verifier call: the destination's verifier, called by the Service -->
      <g>
        <rect x="492" y="152" width="252" height="128" rx="10" class="d-surface" />
        <text x="504" y="172" class="t b">Destination verifier</text>
        <text x="504" y="188" class="t small">checks the bundle under the anchor</text>
        <text x="504" y="207" class="t small" data-role="v-bundle">bundle: none yet</text>
        <text x="504" y="223" class="t small" data-role="v-proof"></text>
        <text x="504" y="239" class="t small" data-role="v-returns"></text>
        <text x="504" y="255" class="t small" data-role="v-store"></text>
        <g data-role="verdict" class="ta__verdict empty">
          <rect x="504" y="260" width="130" height="18" rx="9" data-role="verdict-box" />
          <text x="569" y="273" class="t small center b" data-role="verdict-text">verdict</text>
        </g>
      </g>
      <text x="120" y="304" class="t small center muted" data-role="sync-label">requests report anchor id 1</text>
      <text x="120" y="322" class="t small center muted">(unproven: a cue, not evidence)</text>

      <!-- The bundle chip rides along the top edge of the three boxes (Endpoint, CLPR Service, verifier);
           it is drawn last so it paints above them. -->
      <g transform="translate(200,151)" aria-hidden="true">
        <g data-role="chip" class="ta__chip off">
          <rect x="-27" y="-8" width="54" height="16" rx="8" />
          <text x="0" y="4" class="t mono center">bundle</text>
        </g>
      </g>
      </svg>
    </div>
    <p class="sim__scroll-note">Wider than a phone; scroll it sideways if you need to.</p>
    <div class="ta__stats" data-role="stats">
      <span class="pill grey">transactions sent <b data-stat="tx">0</b></span>
      <span class="pill bad">reverted (fee wasted) <b data-stat="wasted">0</b></span>
      <span class="pill ok">messages delivered <b data-stat="delivered">0</b></span>
      <span class="pill b">waiting on the source <b data-stat="pending">2</b></span>
      <span class="small">the timeline ends at epoch {MAX}.</span>
    </div>
  </div>
  <div class="sim__controls">
    <div class="group">
      <span class="kicker">Source</span>
      <button class="btn" type="button" data-ev="rotate">Source changes its signers (next epoch)</button>
    </div>
    <div class="group">
      <span class="kicker">Endpoint</span>
      <button class="btn" type="button" data-ev="normal">Submits a normal bundle</button>
      <button class="btn" type="button" data-ev="late">Submits a late bundle (sealed by the previous authority)</button>
      <button class="btn primary" type="button" data-ev="transition">Submits a transition bundle</button>
      <button class="btn" type="button" data-ev="batch">Submits one batched catch-up bundle</button>
      <button class="btn danger" type="button" data-ev="inject">Compromised endpoint injects an anchor</button>
    </div>
    <div class="group">
      <span class="kicker">Outage</span>
      <label class="range">N <input type="range" min="1" max="4" value="2" data-role="n" aria-label="Number of epochs the endpoint is offline" /></label>
      <button class="btn" type="button" data-ev="offline">Endpoint goes offline for <span data-role="n-label">2</span> <span data-role="n-unit">epochs</span></button>
      <button class="btn" type="button" data-ev="back">Endpoint comes back</button>
      <span class="spacer"></span>
      <button class="btn" type="button" data-ev="reset">Reset</button>
    </div>
  </div>
  <div class="sim__log sim__log--tall" data-role="log"></div>
  <div class="sim__body trustanchor__panels">
    <div class="steps two">
      <div class="result">
        <h4>What the trust anchor is, per proof scheme</h4>
        <p><strong>hints-wraps</strong> (Hiero, checked by Hiero's built-in verifier). The anchor is the source's ledger id, and its id, the ledger id, never changes: the WRAPS proof in each signature covers roster changes. A verifier may keep a cache hint and return it as a trust anchor update, with the same id; a hint never changes whether a bundle is accepted.</p>
        <p><strong>hints</strong> (Hiero, checked by EVM verifier contracts). The anchor is the hash of the current hinTS verification key, which changes with the roster; every change of key is a trust anchor change. Some of its transition bundles carry no messages, no queue metadata and no manifest.</p>
        <p><strong>qbft-epoch</strong> (an EVM ledger running QBFT, checked by EVM verifier contracts). The anchor is the validator set of an anchored epoch, and its id is the epoch number. A bundle carrying several epoch boundary headers advances the anchor by that many epochs; a bundle carries a limited number of them, and catching up across a large validator change is an open issue (OI-6).</p>
        <p><strong>qbft-header</strong> and <strong>qbft-contract</strong> (an EVM ledger running QBFT, checked by EVM verifier contracts and by Hiero's built-in verifier). The anchor is a trusted validator set, read from block headers or from a validator contract, and the block at which it was last confirmed; its id is that block number. It moves forward when a bundle proves a different set.</p>
        <p class="small">A verifier contract combines one proof scheme of the source ledger with the verifier API of the destination ledger. The first mode of the simulation follows qbft-epoch and numbers the validator sets V1, V2 and so on; the second follows hints-wraps, with V1, V2 as successive rosters.</p>
      </div>
      <div class="result">
        <h4>What can and cannot change the anchor</h4>
        <ul class="small" style="margin:0;padding-left:1.1rem">
          <li>The trust anchor and its id are stored with the channel, set at channel setup from the verifier's configuration check, and afterwards changed only by bundle processing, from what the verifier returns. No administrative operation changes them. A verifier behind an upgradeable contract can still change what it accepts, so applications evaluate who controls its upgrades.</li>
          <li>A trust anchor change has a new id. The bundle must verify under the current anchor and contain a proven commitment to the new one; a returned anchor that is not a proven successor must not change which proofs the verifier accepts. This is what stops a compromised endpoint from injecting a signer.</li>
          <li>A trust anchor update keeps the id and changes nothing the verifier accepts, for example a cache. An update alone does not make progress.</li>
          <li>The CLPR Service replaces the anchor and its id before it processes any message of the bundle, and verifies every later bundle under the new value. The id is empty exactly when the anchor is.</li>
          <li>A bundle with no messages that changes the anchor is valid: the change is progress on its own.</li>
          <li>The channel context (the channel id and the peer CLPR Service's address) is stored separately and never changes.</li>
          <li>The drawing merges two endpoints: the source ledger's endpoint builds the bundle for the peer's request, and the destination's endpoint submits it.</li>
        </ul>
      </div>
    </div>
    <p class="small" style="margin:10px 0 0">Source: <a href={LINKS.viface1} rel="noopener">Verifier interface §1</a> · <a href={LINKS.viface4} rel="noopener">§4</a> · <a href={LINKS.catchup} rel="noopener">Endpoint sync §5.1</a> · <a href={LINKS.processing} rel="noopener">Channel state transitions §2</a> · <a href={LINKS.progress} rel="noopener">§3</a> · <a href={LINKS.context} rel="noopener">Channel setup §3</a> · <a href={LINKS.verifierChoice} rel="noopener">CLPR Service §6.1</a> · <a href={LINKS.ledgers} rel="noopener">proof schemes</a>: <a href={LINKS.hintsWraps} rel="noopener">hints-wraps</a>, <a href={LINKS.hints} rel="noopener">hints</a>, <a href={LINKS.qbftEpoch} rel="noopener">qbft-epoch</a> (<a href={LINKS.oi6} rel="noopener">OI-6</a>), <a href={LINKS.qbftHeader} rel="noopener">qbft-header</a>, <a href={LINKS.qbftContract} rel="noopener">qbft-contract</a>.</p>
  </div>
</div>

<style is:global>
  /* Global (not scoped) so the state classes the script toggles on SVG elements always match;
     every selector is prefixed with .trustanchor so nothing leaks. */
  .trustanchor .sim__scroll > svg { min-width: 760px; }
  .trustanchor .ta__ebox { fill: var(--surface); stroke: var(--border-2); stroke-width: 1; transform-box: fill-box; transform-origin: center; }
  .trustanchor .ta__ebox.past { fill: var(--grey-soft); }
  .trustanchor .ta__ebox.future { stroke-dasharray: 5 4; }
  .trustanchor .ta__ebox.now { fill: var(--b-soft); stroke: var(--b); stroke-width: 2.5; }
  .trustanchor .ta__ebox.pop { animation: ta-pop 500ms ease; }
  @keyframes ta-pop { 50% { transform: scale(1.06); } }
  .trustanchor .ta__trusted { fill: var(--ok); transition: x 300ms ease, width 300ms ease; }
  .trustanchor [data-role="trusted-label"] { transition: transform 300ms ease; }
  .trustanchor .ta__ok { fill: var(--ok); }
  .trustanchor .ta__pill { transition: opacity 250ms; }
  .trustanchor .ta__pill.off { opacity: 0; }
  .trustanchor .ta__ch.ok { fill: var(--ok-soft); stroke: var(--ok); }
  .trustanchor .ta__ch.bad { fill: var(--bad-soft); stroke: var(--bad); }
  .trustanchor .ta__verdict rect { fill: var(--grey-soft); stroke: var(--border-2); }
  .trustanchor .ta__verdict text { fill: var(--text-2); }
  .trustanchor .ta__verdict.empty rect { fill: none; stroke: var(--border-2); stroke-dasharray: 3 3; }
  .trustanchor .ta__verdict.empty text { fill: var(--text-3); font-weight: 400; }
  .trustanchor .ta__verdict.ok rect { fill: var(--ok-soft); stroke: var(--ok); }
  .trustanchor .ta__verdict.ok text { fill: var(--ok); }
  .trustanchor .ta__verdict.bad rect { fill: var(--bad-soft); stroke: var(--bad); }
  .trustanchor .ta__verdict.bad text { fill: var(--bad); }
  .trustanchor .ta__chip { transition: opacity 250ms; }
  .trustanchor .ta__chip.off { opacity: 0; }
  .trustanchor .ta__chip rect { fill: var(--c-soft); stroke: var(--c); stroke-width: 1.5; }
  .trustanchor .ta__chip text { fill: var(--text); }
  .trustanchor .ta__chip.ok rect { fill: var(--ok-soft); stroke: var(--ok); }
  .trustanchor .ta__chip.bad rect { fill: var(--bad-soft); stroke: var(--bad); }
  .trustanchor .ta__chip.grey rect { fill: var(--grey-soft); stroke: var(--border-2); }
  .trustanchor .ta__chip.grey text { fill: var(--text-3); }
  .trustanchor .ta__stats { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin: 8px 0 0; }
  .trustanchor .ta__stats b { display: inline-block; min-width: 1.2em; text-align: right; font-variant-numeric: tabular-nums; }
  .trustanchor .ta__stats b.chg { animation: ta-flip 240ms ease-out; }
  @keyframes ta-flip { from { transform: translateY(-0.6em); opacity: 0; } }
  .trustanchor .sim__controls .group { flex: 1 1 100%; }
  .trustanchor .trustanchor__panels { border-top: 1px solid var(--border); }
  .trustanchor .result p { margin: 0 0 8px; }
  .trustanchor .result p:last-child { margin-bottom: 0; }
  .trustanchor .sim__log .proto { margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--border-2); font-size: 0.88rem; }
  .trustanchor .sim__log .refs { margin-top: 4px; font-size: 0.8rem; color: var(--text-3); }
  .trustanchor .sim__log .refs a { color: inherit; }
</style>

<script>
  type Mode = 'single' | 'fixed';
  type Verdict = 'accepted' | 'reverted' | 'suppressed';
  interface Last { bundle: string; proof: string; returns: string; store: string; verdict: Verdict }
  interface Msg { plain: string; proto: string; refs: [string, string][] }
  const MAX = 7;
  const CAP = 5; // trust anchor changes per catch-up bundle in this simulation
  const MARKER: Record<Mode, string> = {
    single: 'the block where the set changes: sealed by the previous validator set, names the next one',
    fixed: 'where the roster changes: its new key is linked to the ledger id by the WRAPS proof',
  };
  const NOTE: Record<Mode, string> = {
    single: 'one validator set at a time, with the epoch as its id',
    fixed: 'the ledger id, which every roster\'s key is linked to',
  };
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SERVICE_X = 160; // chip travel, in viewBox units from its start over the Endpoint
  const VERIFIER_X = 400;
  const VERDICT_MS = REDUCED ? 0 : 480; // when the chip reaches the Verifier
  const replay = (el: Element, cls: string) => { el.classList.remove(cls); void (el as HTMLElement).offsetWidth; el.classList.add(cls); };

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('.sim.trustanchor'))) {
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const links = JSON.parse(root.dataset.links || '{}') as Record<string, string>;
    const log = $('[data-role="log"]');
    const nIn = root.querySelector<HTMLInputElement>('[data-role="n"]')!;
    const nLabel = $('[data-role="n-label"]'); const nUnit = $('[data-role="n-unit"]');
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-ev]'));
    const btn = (ev: string) => buttons.find((b) => b.dataset.ev === ev)!;
    const chip = $('[data-role="chip"]');
    const arr1 = $('[data-role="arr1"]'); const arr2 = $('[data-role="arr2"]');
    const verdict = $('[data-role="verdict"]'); const verdictText = $('[data-role="verdict-text"]');
    const timers = new Set<number>();
    let chipAnim: Animation | null = null;

    let mode: Mode = 'single';
    let s = 1;            // source epoch: blocks are sealed by V<s>
    let cur = 1;          // anchor: V<cur> (single); the ledger id, accepting every roster so far (fixed)
    let seen = 1;         // last source epoch the endpoint observed
    let offline = false;
    let pending: number[] = [1, 1]; // epoch in which each pending message was sent
    let tx = 0, wasted = 0, delivered = 0;
    let last: Last | null = null;
    let shown: Last | null = null; // the bundle the chip has already travelled for
    let shownS = 1;                // the epoch box last shown as "signing now"
    let before = 'V1';             // the anchor as it read when the current action started

    // In the fixed mode every roster so far is accepted, because each roster's key is linked to the ledger id.
    const set = () => (mode === 'single' ? [cur] : Array.from({ length: s }, (_, i) => i + 1));
    const words = () => (mode === 'single' ? `V${cur}` : 'ledger id');
    const idWords = () => (mode === 'single' ? String(cur) : 'ledger id');
    const accepts = (v: number) => set().includes(v);
    const gapAt = (epoch: number) => (mode === 'single' ? epoch - cur : 0);
    const gap = () => gapAt(s);
    const steps = () => (mode === 'single' ? s - cur : 0); // trust anchor changes the source can currently prove
    const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
    const later = (fn: () => void, ms: number) => { const t = window.setTimeout(() => { timers.delete(t); fn(); }, ms); timers.add(t); };
    const clearMotion = () => { for (const t of timers) clearTimeout(t); timers.clear(); if (chipAnim) { chipAnim.cancel(); chipAnim = null; } };
    const setNum = (el: HTMLElement, text: string) => { if (el.textContent !== text) { el.textContent = text; replay(el, 'chg'); } };
    const start = () => { before = words(); };

    function deliverUpTo(epoch: number): number {
      const k = pending.filter((e) => e <= epoch).length;
      pending = pending.filter((e) => e > epoch);
      delivered += k;
      return k;
    }
    function line(): string {
      const anchor = before === words() ? words() : `${before} -> ${words()}`;
      const tail = last ? (last.verdict === 'accepted' ? 'accepted' : last.verdict === 'reverted' ? 'reverted' : 'not sent') : offline ? 'endpoint offline' : 'no bundle';
      return `epoch ${s} · anchor ${anchor} · id ${idWords()} · tx ${tx} · ${tail}`;
    }
    function say(m: Msg) {
      const refs = m.refs.map(([k, l]) => `<a href="${links[k]}" rel="noopener">${l}</a>`).join(' · ');
      log.innerHTML = `<span class="line">${line()}</span><div>${m.plain}</div><div class="proto"><strong>Protocol.</strong> ${m.proto}</div><div class="refs">Source: ${refs}</div>`;
    }
    const setVerdict = (cls: string, text: string) => { verdict.setAttribute('class', `ta__verdict ${cls}`); verdictText.textContent = text; };

    /** The chip leaves the Endpoint on every submit; where it ends, and its colour, is the verdict. */
    function travel(v: Verdict) {
      clearMotion();
      chip.setAttribute('class', `ta__chip ${v === 'accepted' ? 'ok' : v === 'reverted' ? 'bad' : 'grey'}`);
      arr1.setAttribute('class', v === 'suppressed' ? 'line' : 'line c');
      const atVerifier = () => {
        arr2.setAttribute('class', v === 'accepted' ? 'line ok' : v === 'reverted' ? 'line bad' : 'line');
        setVerdict(v === 'accepted' ? 'ok' : v === 'reverted' ? 'bad' : 'grey', v === 'accepted' ? 'accepted' : v === 'reverted' ? 'reverted, fee lost' : 'not sent');
      };
      // Endpoint → CLPR Service → its verifier; accepted, it comes back to rest at the Service.
      const end = v === 'accepted' ? SERVICE_X : 0;
      if (REDUCED) { chip.style.transform = `translateX(${end}px)`; atVerifier(); return; }
      const out = [{ transform: 'translateX(0)' }, { transform: `translateX(${SERVICE_X}px)`, offset: 0.25 }, { transform: `translateX(${VERIFIER_X}px)`, offset: 0.5 }, { transform: `translateX(${VERIFIER_X}px)`, offset: 0.62 }];
      const frames = v === 'suppressed'
        ? [{ transform: 'translateX(0)' }, { transform: 'translateX(22px)' }, { transform: 'translateX(0)' }]
        : [...out, { transform: `translateX(${end}px)` }];
      chip.style.transform = 'translateX(0)';
      chipAnim = chip.animate(frames, { duration: v === 'suppressed' ? 420 : 950, easing: 'ease-in-out', fill: 'forwards' });
      later(atVerifier, v === 'suppressed' ? 200 : VERDICT_MS);
    }
    function idle() {
      clearMotion();
      chip.setAttribute('class', 'ta__chip off'); chip.style.transform = '';
      arr1.setAttribute('class', 'line'); arr2.setAttribute('class', 'line');
      setVerdict('empty', 'verdict');
    }

    function render() {
      const trusted = set();
      for (const g of Array.from(root.querySelectorAll<SVGGElement>('g[data-epoch]'))) {
        const e = Number(g.dataset.epoch);
        const box = g.querySelector<SVGRectElement>('[data-role="ebox"]')!;
        const name = g.querySelector<SVGTextElement>('[data-role="ename"]')!;
        const note = g.querySelector<SVGTextElement>('[data-role="enote"]')!;
        box.setAttribute('class', `ta__ebox ${e === s ? 'now' : e < s ? 'past' : 'future'}`);
        if (e === s && s !== shownS) replay(box, 'pop');
        name.setAttribute('class', 't b center' + (e > s ? ' muted' : ''));
        note.textContent = e === s ? 'signing now' : e < s ? 'past' : '';
      }
      shownS = s;
      const lo = Math.min(...trusted), hi = Math.min(MAX, Math.max(...trusted));
      const x0 = 20 + (lo - 1) * 104, x1 = 20 + (hi - 1) * 104 + 96;
      const bar = $('[data-role="trusted"]');
      bar.setAttribute('x', String(x0)); bar.setAttribute('width', String(x1 - x0));
      bar.style.setProperty('x', `${x0}px`); bar.style.setProperty('width', `${x1 - x0}px`);
      $('[data-role="trusted-label"]').style.transform = `translateX(${Math.max(92, Math.min(668, (x0 + x1) / 2)) - 92}px)`;
      $('[data-role="queue"]').textContent = `outbound queue: ${plural(pending.length, 'pending message')}`;

      $('[data-role="ep-status"]').textContent = offline ? `OFFLINE since epoch ${seen}` : `online, sees epoch ${s}`;
      $('[data-role="ep-record"]').textContent = mode === 'single' ? Array.from({ length: seen }, (_, i) => i + 1).join(' → ') : 'ledger id, fixed';
      const g = gapAt(seen);
      $('[data-role="ep-remote"]').textContent = mode === 'single' ? `remote anchor id ${cur}: ${g === 0 ? 'current' : `behind by ${g}`}` : 'remote anchor: the ledger id';
      $('[data-role="ep-todo"]').textContent = offline ? 'not syncing' : g === 0 ? 'normal bundles will verify' : `needs ${plural(g, 'transition')} first`;

      $('[data-role="ch-anchor"]').textContent = `trust anchor: ${words()}`;
      $('[data-role="ch-id"]').textContent = `trust anchor id: ${idWords()}`;
      for (const p of Array.from(root.querySelectorAll<SVGGElement>('[data-pill]'))) {
        const i = Number(p.dataset.pill);
        if (mode === 'fixed') {
          p.setAttribute('class', `ta__pill${i === 0 ? '' : ' off'}`);
          if (i === 0) p.querySelector('text')!.textContent = s === 1 ? 'V1' : `V1–V${s}`;
          continue;
        }
        p.setAttribute('class', `ta__pill${i < trusted.length ? '' : ' off'}`);
        if (i < trusted.length) p.querySelector('text')!.textContent = `V${trusted[i]}`;
      }
      $('[data-role="ch-box"]').setAttribute('class', `d-a ta__ch ${gap() > 0 ? 'bad' : 'ok'}`);
      $('[data-role="sync-label"]').textContent = mode === 'single' ? `requests report anchor id ${cur}` : 'requests report the ledger id';

      $('[data-role="v-bundle"]').textContent = last ? `bundle: ${last.bundle}` : 'bundle: none yet';
      $('[data-role="v-proof"]').textContent = last ? last.proof : '';
      $('[data-role="v-returns"]').textContent = last ? last.returns : '';
      $('[data-role="v-store"]').textContent = last ? last.store : '';
      if (last && last !== shown) { shown = last; travel(last.verdict); }
      else if (!last && shown) { shown = null; idle(); }

      const state = $('[data-role="state"]');
      const stateText = offline ? 'endpoint offline' : gap() > 0 ? `anchor behind by ${gap()}` : 'anchor current';
      if (state.textContent !== stateText) {
        state.textContent = stateText; state.className = 'pill ' + (offline ? 'grey' : gap() > 0 ? 'bad' : 'ok'); replay(state, 'pulse');
      }

      setNum($('[data-stat="tx"]'), String(tx));
      setNum($('[data-stat="wasted"]'), String(wasted));
      setNum($('[data-stat="delivered"]'), String(delivered));
      setNum($('[data-stat="pending"]'), String(pending.length));

      const room = MAX - s;
      nIn.max = String(Math.max(1, Math.min(4, room)));
      if (Number(nIn.value) > Number(nIn.max)) nIn.value = nIn.max;
      nLabel.textContent = nIn.value; nUnit.textContent = Number(nIn.value) === 1 ? 'epoch' : 'epochs';
      const stale = pending.some((e) => e <= s - 1); // something sealed by the previous authority is left to prove
      const gate = (ev: string, disabled: boolean, why: string) => { const b = btn(ev); b.disabled = disabled; if (disabled) b.title = why; else b.removeAttribute('title'); };
      const off = 'the endpoint is offline';
      gate('rotate', s >= MAX, `the timeline ends at epoch ${MAX}`);
      gate('normal', offline, off);
      gate('late', offline || s < 2 || !stale, offline ? off : s < 2 ? 'the source has not rotated yet' : 'nothing sealed by the previous authority is left to prove');
      gate('transition', offline, off);
      gate('batch', offline || steps() < 2, offline ? off : mode === 'fixed' ? 'this proof scheme has no trust anchor changes' : 'fewer than two changes to catch up on');
      gate('offline', offline || room < 1, offline ? 'the endpoint is already offline' : `the timeline ends at epoch ${MAX}`);
      gate('back', !offline, 'the endpoint is online');
      for (const b of Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-mode]'))) b.setAttribute('aria-pressed', String(b.dataset.mode === mode));
      $('[data-role="mode-note"]').textContent = NOTE[mode];
      $('[data-role="marker-note"]').textContent = MARKER[mode];
    }

    function intro(): Msg {
      return mode === 'single'
        ? {
            plain: `The channel was set up with V1 as its trust anchor, taken from the verifier's check of the configuration proof. The source is in epoch 1 and seals its blocks with V1. This mode follows the qbft-epoch scheme: the anchor holds one validator set, and its id is the epoch number. Try: change the source's signers, then submit a normal bundle.`,
            proto: `The CLPR Service stores the trust anchor and its id with the channel and passes the anchor to the verifier with every bundle. To the Service the anchor is opaque bytes, and the verifier keeps no per-channel state. The verifier accepts a proof only from an authority included in the anchor it is given, or from one proven within the same bundle to succeed it.`,
            refs: [['viface1', 'Verifier interface §1'], ['viface4', 'Verifier interface §4'], ['qbftEpoch', 'qbft-epoch §7']],
          }
        : {
            plain: `The channel's trust anchor is the source's ledger id. This mode follows the hints-wraps scheme, which Hiero's built-in verifier uses to check another Hiero ledger: each roster signs with its own key, and the WRAPS proof in every signature links that key to the ledger id. Try: change the source's roster a few times, then submit bundles.`,
            proto: `The anchor is set at channel setup, from the ledger id against which the configuration proof was verified, and its id, the ledger id, never changes. A verifier of this scheme reports no trust anchor change; one bound to a single ledger id may store a cache hint with the channel as a trust anchor update, which keeps the same id.`,
            refs: [['hintsWraps', 'hints-wraps §7'], ['hintsWrapsTrust', 'hints-wraps §2'], ['ledgers', 'proof schemes'], ['viface1', 'Verifier interface §1']],
          };
    }

    function reset() {
      s = 1; cur = 1; seen = 1; offline = false; pending = [1, 1]; tx = 0; wasted = 0; delivered = 0; last = null;
      before = words();
      render();
      say(intro());
    }

    function rotate() {
      if (s >= MAX) return;
      start();
      const old = s;
      s += 1;
      pending.push(s, s);
      if (!offline) seen = s;
      last = null;
      render();
      const stuck = !accepts(s);
      say(mode === 'single'
        ? {
            plain: `The source's validator set changed from V${old} to V${s}: epoch ${s} has begun, and every block from now on is sealed by V${s}. Applications queued 2 more messages. Nothing changed on the destination, whose channel still trusts ${words()}.${offline ? ' The endpoint is offline and has not noticed.' : stuck ? ` A normal bundle sealed by V${s} would now fail to verify: a transition bundle has to go first.` : ''}`,
            proto: `In the qbft-epoch scheme the anchored set changes only at epoch boundaries. Each boundary header lists the validator set, and its seals link it to the set before it. That header is the evidence a transition bundle carries: verifiable under the current anchor, with a proven commitment to the next set. When a trust anchor holds a single authority, proofs from the previous one stop verifying as soon as the change is accepted.`,
            refs: [['qbftEpochTrust', 'qbft-epoch §2'], ['qbftEpoch', 'qbft-epoch §7'], ['viface4', 'Verifier interface §4']],
          }
        : {
            plain: `The source's roster changed from V${old} to V${s}, and its blocks are now signed with V${s}'s key. Applications queued 2 more messages. Nothing changes on the destination: the channel's trust anchor is the source's ledger id, and V${s}'s signatures verify against it.${offline ? ' The endpoint is offline and has not noticed.' : ''}`,
            proto: `In the hints-wraps scheme the WRAPS proof in each signature covers roster changes, so the trust anchor id stays the ledger id for the life of the channel. No transition bundle is needed.`,
            refs: [['hintsWraps', 'hints-wraps §7'], ['hintsWrapsTrust', 'hints-wraps §2']],
          });
    }

    function submitNormal(late: boolean) {
      start();
      const v = late ? s - 1 : s;
      const verb = mode === 'single' ? 'sealed' : 'signed';
      const kind = late ? `late, ${verb} by V${v}` : `normal, ${verb} by V${v}`;
      const k = pending.filter((e) => e <= v).length;
      if (k === 0) {
        last = { bundle: kind, proof: 'nothing new to prove', returns: 'pre-check: no progress', store: '', verdict: 'suppressed' };
        render();
        say({
          plain: late
            ? `A proof ${verb} by V${v} could only prove messages that existed before the change, and those were all delivered already. No progress criterion holds, so the endpoint does not send the bundle.`
            : `There is nothing new to deliver, so no progress criterion holds and the endpoint does not send the bundle. Had it sent one, the CLPR Service would have rejected it for lack of progress, and the fee would be lost.`,
          proto: `An endpoint SHOULD NOT submit a bundle that makes no progress. The CLPR Service checks the progress criteria after the verifier call and rejects a bundle that meets none; a rejected bundle still costs its submitter the transaction fee.`,
          refs: [['progress', 'Channel state transitions §3'], ['submit', 'CLPR Service §5.2']],
        });
        return;
      }
      tx += 1;
      if (accepts(v)) {
        deliverUpTo(v);
        last = { bundle: kind, proof: `state proof at epoch ${v}, ${plural(k, 'message')}`, returns: 'no new trust anchor', store: 'anchor unchanged', verdict: 'accepted' };
        render();
        if (!late) {
          say({
            plain: `The endpoint proves the source's current state with a proof ${verb} by V${v}. The verifier checks it under the stored trust anchor (${words()}), so ${plural(k, 'message')} ${k === 1 ? 'is' : 'are'} delivered. No new trust anchor came back: nothing changes.`,
            proto: `The verifier returns the bundle's messages and the source's queue metadata, with an empty new trust anchor, so the stored anchor stays as it is. The CLPR Service then runs the rest of bundle processing: the limits, progress, the replay defence, the running hash, the acknowledgement and dispatch.`,
            refs: [['processing', 'Channel state transitions §2'], ['viface3', 'Verifier interface §3']],
          });
        } else if (mode === 'single') {
          say({
            plain: `This bundle was built before the change: its proof is sealed by V${v}. The channel still trusts V${v}, so it is accepted and ${plural(k, 'older message')} ${k === 1 ? 'is' : 'are'} delivered. It worked only because the transition bundle has not landed yet.`,
            proto: `With a single authority in the trust anchor, proofs from the previous authority stop verifying as soon as the change is accepted. The Protocol sets no deadline for submitting a trust anchor change.`,
            refs: [['viface4', 'Verifier interface §4']],
          });
        } else {
          say({
            plain: `This bundle was built before the roster change and is signed with V${v}'s key. Its signature still verifies against the ledger id, so it is accepted and ${plural(k, 'older message')} ${k === 1 ? 'is' : 'are'} delivered. With a fixed anchor nothing goes stale.`,
            proto: `A hints-wraps verifier checks every signature against the ledger id; the WRAPS proof links each roster's key to it.`,
            refs: [['hintsWraps', 'hints-wraps §7']],
          });
        }
      } else {
        wasted += 1;
        last = { bundle: kind, proof: `state proof at epoch ${v}, ${plural(k, 'message')}`, returns: `fails: V${v} is not in the anchor`, store: 'anchor unchanged', verdict: 'reverted' };
        render();
        const movedOn = v < Math.min(...set());
        if (late && movedOn) {
          say({
            plain: `<span class="bad">Rejected.</span> A bundle sealed by V${v} arrived after the anchor moved on. V${v} is no longer trusted, so the verifier fails, the bundle is rejected and the fee is lost. Nothing else is harmed: the messages are still on the source, and a fresh proof can deliver them.`,
            proto: `When a trust anchor holds a single authority, proofs from the previous authority stop verifying as soon as the change is accepted. A rejected bundle changes nothing on the channel and costs the submitter its fee.`,
            refs: [['viface4', 'Verifier interface §4'], ['processing', 'Channel state transitions §2']],
          });
        } else {
          say({
            plain: `<span class="bad">Stuck.</span> The proof is sealed by V${v}, but the channel trusts only ${words()}. The verifier fails, the whole bundle is rejected, and the submitter paid the fee for nothing. ${plural(pending.length, 'message')} wait on the source until a transition bundle brings the anchor forward.`,
            proto: `A sender MUST NOT send a bundle that does not verify under the trust anchor the request identifies. When no normal bundle verifies because that anchor is behind the sender's ledger, the sender MUST send a transition bundle instead. This button shows what happens when an endpoint ignores that.`,
            refs: [['catchup', 'Endpoint sync §5.1'], ['processing', 'Channel state transitions §2']],
          });
        }
      }
    }

    function transition() {
      start();
      if (steps() < 1) {
        last = { bundle: 'transition', proof: mode === 'single' ? 'no change to prove yet' : 'this scheme has no changes', returns: 'pre-check: no progress', store: '', verdict: 'suppressed' };
        render();
        say(mode === 'single'
          ? {
              plain: `Nothing to change: the source is still in epoch ${s}, so no boundary header naming a new set exists yet. The endpoint does not send the bundle.`,
              proto: `A trust anchor change needs a bundle that verifies under the current anchor and contains a proven commitment to the new one. Without that evidence there is nothing to build, and the trust anchor change criterion of progress could not hold.`,
              refs: [['viface4', 'Verifier interface §4'], ['progress', 'Channel state transitions §3']],
            }
          : {
              plain: `There is nothing to change: the anchor is the ledger id, and a verifier of this scheme reports no trust anchor change. A verifier may return a cache hint as a trust anchor update, which keeps the same id; an update alone makes no progress, so a bundle carrying only that would be rejected.`,
              proto: `A trust anchor update keeps the stored id and MUST NOT change which proofs the verifier accepts. A hints-wraps hint never changes whether a bundle is accepted.`,
              refs: [['hintsWraps', 'hints-wraps §7'], ['viface4', 'Verifier interface §4']],
            });
        return;
      }
      tx += 1;
      const old = cur;
      cur += 1;
      last = {
        bundle: 'transition, 0 messages',
        proof: `sealed by V${old}, commits to V${cur}`,
        returns: `new anchor ${words()}, id ${cur}`,
        store: 'stored before any message',
        verdict: 'accepted',
      };
      render();
      const more = gap() > 0 ? ` The source is already at epoch ${s}, so ${plural(gap(), 'more transition bundle')} ${gap() === 1 ? 'is' : 'are'} needed, each verified under the anchor the previous one installed, one sync cycle each.` : ' The anchor is current again: normal bundles will verify.';
      say({
        plain: `The endpoint sends the boundary header at which the set changed to V${cur}: sealed by V${old}, which the channel trusts, and naming V${cur}. The verifier checks the seals against V${old} and returns V${cur} as the new trust anchor, with a new id. The CLPR Service stores both before it processes any message of the bundle. From now on only V${cur} is accepted. The bundle carried no messages and still makes progress, by the change itself.${more}`,
        proto: `A trust anchor change returns an id that differs from the stored one, and it makes progress on its own. The CLPR Service replaces the anchor and its id before processing any message of the bundle, and verifies every later bundle under the new value. Catch-up takes one cycle per transition bundle.`,
        refs: [['viface4', 'Verifier interface §4'], ['catchup', 'Endpoint sync §5.1'], ['progress', 'Channel state transitions §3'], ['qbftEpoch', 'qbft-epoch §7']],
      });
    }

    function batch() {
      const missed = steps();
      if (missed < 2) return;
      start();
      const n = Math.min(missed, CAP);
      const left = missed - n;
      tx += 1;
      const old = cur;
      cur += n;
      const k = deliverUpTo(cur);
      last = {
        bundle: `catch-up, ${plural(k, 'message')}`,
        proof: `${n} boundary headers: V${old} → V${cur}`,
        returns: `only the last anchor ${words()}, id ${cur}`,
        store: 'stored before any message',
        verdict: 'accepted',
      };
      render();
      say({
        plain: `One bundle instead of ${n + 1}. It carries ${n} boundary headers in order; the verifier checks each against the set the previous one established and returns only the last, ${words()}, as the new anchor. The intermediate sets are never stored. ${plural(k, 'message')} proven under V${cur} ${k === 1 ? 'rides' : 'ride'} along in the same bundle.${left > 0 ? ` The endpoint missed ${missed} changes and this simulation caps a bundle at ${CAP} of them, so ${plural(left, 'more')} ${left === 1 ? 'follows' : 'follow'} in the next one.` : ''}`,
        proto: `A verifier MAY accept several consecutive changes in one bundle, verifying each against the authority the previous one established, and return only the last; the bundle MAY also carry messages proven under that last authority. In the qbft-epoch scheme a bundle with several boundary headers advances the anchor by that many epochs. The producer caps how many it carries, and catching up over several bundles across a large validator change can fail; that limit is open issue OI-6.`,
        refs: [['viface4', 'Verifier interface §4'], ['qbftEpoch', 'qbft-epoch §7'], ['qbftEpochLimit', 'qbft-epoch §5'], ['oi6', 'Open issues OI-6'], ['catchup', 'Endpoint sync §5.1']],
      });
    }

    function inject() {
      start();
      tx += 1; wasted += 1;
      last = { bundle: 'forged: names its own successor', proof: `no commitment proven under ${words()}`, returns: 'fails: successor not proven', store: 'anchor unchanged', verdict: 'reverted' };
      render();
      say({
        plain: `<span class="ok">Blocked.</span> A compromised endpoint submits a bundle that names a signer of its own choosing as the successor, with no commitment proven under ${words()}. The verifier finds no proven successor and fails; the anchor is untouched and the submitter paid the fee. Only bundle processing, from what the verifier returns, changes a trust anchor; no administrative operation can set it.`,
        proto: `A trust anchor change contains a proven commitment to the new trust anchor, made under the current one. A returned trust anchor that is not a proven successor MUST NOT change which proofs the verifier accepts. The anchor is set at channel setup and changed only by bundle processing.`,
        refs: [['viface4', 'Verifier interface §4'], ['viface1', 'Verifier interface §1']],
      });
    }

    function goOffline() {
      const n = Math.min(Number(nIn.value), MAX - s);
      if (offline || n < 1) return;
      start();
      offline = true;
      const from = s;
      for (let i = 0; i < n; i++) { s += 1; pending.push(s, s); }
      last = null;
      render();
      say({
        plain: `The endpoint stops. While it is away the source changes its signers ${n === 1 ? 'once' : `${n} times`} (V${from} → V${s}) and applications keep sending: ${2 * n} more messages queue up. The destination's anchor cannot move on its own; it is still ${words()}.${mode === 'fixed' ? ' Here that is enough: every roster is linked to the ledger id.' : ' Bring the endpoint back to see what it has to do.'}`,
        proto: `The trust anchor changes only through bundle processing, and the Protocol sets no deadline for submitting a trust anchor change.`,
        refs: [['viface1', 'Verifier interface §1'], ['viface4', 'Verifier interface §4']],
      });
    }

    function comeBack() {
      if (!offline) return;
      start();
      offline = false;
      seen = s;
      last = null;
      render();
      const g = gap();
      if (g === 0) {
        say({
          plain: mode === 'fixed'
            ? `The endpoint is back. The peer's request reports the ledger id as its trust anchor id, and every bundle the endpoint can build verifies under it: normal bundles flow at once and carry the messages queued while it was away.`
            : `The endpoint is back. The peer's request reports trust anchor id ${cur}, which is current: normal bundles will verify straight away.`,
          proto: `A sender MUST NOT send a bundle that does not verify under the trust anchor identified in the request; here a normal bundle does.`,
          refs: [['catchup', 'Endpoint sync §5.1']],
        });
        return;
      }
      say({
        plain: `The endpoint is back. The peer's request reports trust anchor id ${cur} (unproven, a hint), and the source is at epoch ${s}: the anchor is ${g === 1 ? 'one change' : `${g} changes`} behind, so no normal bundle of the current state verifies under ${words()}. The endpoint must first send ${g === 1 ? 'a transition bundle' : `transition bundles in order, each verifying under the anchor the previous one installed`}${steps() >= 2 ? ', or one bundle that carries several changes, which this proof scheme allows' : ''}.`,
        proto: `When no normal bundle verifies under the requested anchor because it is behind the sender's ledger, the sender MUST send a transition bundle instead; several changes behind, it sends them in order. Catch-up takes one cycle per transition bundle, and normal bundles resume once the requestor's anchor is current enough. When an anchor changes, and how its id is formed, is defined by each proof scheme.`,
        refs: [['catchup', 'Endpoint sync §5.1'], ['viface4', 'Verifier interface §4']],
      });
    }

    const handlers: Record<string, () => void> = {
      rotate, normal: () => submitNormal(false), late: () => submitNormal(true), transition, batch, inject, offline: goOffline, back: comeBack, reset,
    };
    for (const b of buttons) b.addEventListener('click', () => handlers[b.dataset.ev!]());
    for (const b of Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-mode]'))) {
      b.addEventListener('click', () => { mode = b.dataset.mode as Mode; reset(); });
    }
    nIn.addEventListener('input', () => { nLabel.textContent = nIn.value; nUnit.textContent = Number(nIn.value) === 1 ? 'epoch' : 'epochs'; });
    reset();
  }
</script>
