---
/**
 * The bundle processing algorithm (Channel state transitions §2, Steps 1 to 14) and the progress
 * criteria (§3) applied to one concrete inbound bundle, one step at a time, on a channel whose
 * stored state is shown on screen. The verifier's part is Verifier interface §3.
 *
 * Running hashes are real SHA-256 (WebCrypto), chained as Messaging §4 defines: each step hashes
 * the previous running hash followed by the SHA-256 of the payload bytes, from 32 zero bytes. The
 * payload bytes are the UTF-8 text of each message, a simplification of the canonical protobuf
 * encoding the protocol hashes. The stored running hash H42 is computed the same way over 42
 * placeholder payloads, so every number on screen is genuine.
 *
 * "Fault injection" alters the bundle before it is submitted. Every rejection shows which step
 * rejects, that the submitting account paid the transaction fee, and that no channel state
 * changed. The one exception, a reply out of order, pauses the channel at Step 9 (§6).
 *
 * Where the EVM reference implementation differs (clpr-smart-contracts/docs/bundle-flow.md), the
 * note at the bottom says so; the steps themselves follow the specification.
 */
import { ledgerConfig, manifest, messaging, bundle, verifierIface, transitions, stakes, economics, service, sol, pinned } from '../../lib/sources';
const { id = 'bundle-verify' } = Astro.props as { id?: string };
const links = {
  processing: transitions('2-bundle-processing'),
  progress: transitions('3-progress'),
  statuses: transitions('1-channel-status'),
  transitionsTable: transitions('4-status-transitions'),
  closing: transitions('5-closing-and-draining'),
  pause: transitions('6-pause-and-resume'),
  queue: messaging('2-message-identifiers-and-queue'),
  payload: messaging('3-payload-encoding'),
  runningHash: messaging('4-running-hash'),
  delivery: messaging('6-delivery-to-the-application'),
  replies: messaging('7-replies'),
  ordering: messaging('8-response-ordering'),
  ack: messaging('9-acknowledgement'),
  bundleContent: bundle('1-bundle-content'),
  partial: bundle('3-partial-bundles'),
  proof: bundle('4-proof-requirements'),
  verifyBundle: verifierIface('3-verifybundle'),
  anchorChange: verifierIface('4-trust-anchor-changes'),
  rejection: verifierIface('5-rejection'),
  throttles: ledgerConfig('3-throttles'),
  configSend: ledgerConfig('52-sending'),
  configRecv: ledgerConfig('53-receiving'),
  peerManifest: manifest('4-peer-manifest'),
  charges: economics('1-execution-charges'),
  payment: economics('2-payment-to-the-bundle-submitter'),
  slashing: stakes('21-when-a-connector-is-slashed'),
  submission: service('5-bundle-submission'),
};
const faults = [
  { k: 'none', label: 'no fault' },
  { k: 'a', label: '(a) verifier reverts' },
  { k: 'b', label: '(b) no progress' },
  { k: 'c', label: '(c) oversized payload' },
  { k: 'd', label: '(d) gap in ids' },
  { k: 'e', label: '(e) tampered payload' },
  { k: 'f', label: '(f) reply out of order' },
];
---
<div class="sim bundleverify" id={id} data-links={JSON.stringify(links)}>
  <div class="sim__head">
    <div><span class="kind">Simulation</span><h3>One inbound bundle, checked step by step</h3></div>
    <div class="bv__pills"><span class="pill grey" data-role="fault">no fault</span><span class="pill grey" data-role="counter">step 0 of 19</span><span class="pill ok" data-role="status">ACTIVE</span></div>
  </div>
  <div class="sim__body">
    <div class="bv__grid">
      <section class="bv__panel" aria-label="Our channel, stored state">
        <h4>Our channel (Ledger B) <span class="bv__sub">stored state, updated as the steps run</span></h4>
        <dl class="bv__kv">
          <div><dt>status</dt><dd data-f="status">ACTIVE</dd></div>
          <div><dt>received_message_id</dt><dd data-f="received">42</dd></div>
          <div><dt>received_running_hash</dt><dd data-f="rhash"><code class="computing">computing…</code></dd></div>
          <div><dt>acked_message_id</dt><dd data-f="acked">17</dd></div>
          <div><dt>next_message_id</dt><dd data-f="next">21</dd></div>
          <div><dt>trust_anchor_id</dt><dd data-f="anchorId">epoch 7</dd></div>
          <div><dt>peer manifest version</dt><dd data-f="manifestV">3</dd></div>
          <div><dt>our own throttles</dt><dd><code class="nw">max_messages_per_bundle 10</code> · <code class="nw">max_message_payload_bytes 64</code></dd></div>
        </dl>
      </section>
      <section class="bv__panel" aria-label="The inbound bundle">
        <h4>The bundle from Ledger A <span class="bv__sub">as the verifier returns it</span></h4>
        <dl class="bv__kv">
          <div><dt>metadata</dt><dd data-f="sync"><code class="nw">received_message_id 19</code> · ACTIVE · <code class="nw">next_message_id 47</code></dd></div>
          <div><dt>last_message_id</dt><dd data-f="anchorMsg">46</dd></div>
          <div><dt>last_message_running_hash</dt><dd data-f="anchorHash"><code class="computing">computing…</code></dd></div>
          <div><dt>new_trust_anchor_id</dt><dd data-f="newAnchor">(empty)</dd></div>
          <div><dt>new_endpoint_manifest</dt><dd data-f="newManifest">(absent)</dd></div>
          <div><dt>messages</dt><dd data-f="count">4</dd></div>
        </dl>
        <div class="bv__msgs" data-role="bundle"><span class="bv__empty" data-role="reverted" hidden>verifier reverted: nothing returned</span></div>
      </section>
    </div>
    <section class="bv__panel bv__qpanel" aria-label="Our outbound queue">
      <h4>Our outbound queue (to Ledger A) <span class="bv__sub">what we sent and have not finished with</span></h4>
      <div class="bv__msgs" data-role="queue"><span class="bv__empty" data-role="qempty" hidden>empty</span></div>
    </section>
  </div>
  <div class="sim__controls" role="group" aria-label="Fault injection">
    <span class="kicker">Before submitting:</span>
    <span class="group">{faults.map((f) => <button class={`btn${f.k === 'none' ? '' : ' danger'}`} type="button" data-fault={f.k} aria-pressed={f.k === 'none' ? 'true' : 'false'}>{f.label}</button>)}</span>
    <span class="spacer"></span>
    <label class="range"><input type="checkbox" data-opt="rotate" /> also carry a trust anchor change (epoch 7 → 8)</label>
    <label class="range"><input type="checkbox" data-opt="manifest" /> also carry manifest v4</label>
  </div>
  <div class="sim__controls">
    <button class="btn" type="button" data-role="prev" disabled>◀ Prev</button>
    <button class="btn primary" type="button" data-role="next">Next ▶</button>
    <button class="btn" type="button" data-role="reset">Reset</button>
  </div>
  <div class="sim__body">
    <div class="sim__track seg bv__track" data-role="track" aria-hidden="true">{Array.from({ length: 20 }, () => <i></i>)}</div>
    <div class="steps two" style="--l:1.35fr;--r:.85fr">
      <div class="step-card" data-role="card"></div>
      <ol class="step-list" data-role="list" aria-label="Bundle processing steps"></ol>
    </div>
  </div>
  <div class="sim__log" data-role="log">Computing the running hashes…</div>
  <div class="bv__notes">
    <aside class="callout impl">
      <span class="label">Reference implementation</span>
      <p class="small" style="margin:0">The EVM reference contracts run these checks in their own order, set out in their <a href={pinned('clpr-smart-contracts', 'docs/bundle-flow.md')} rel="noopener">bundle flow notes</a>. <a href={sol('src/libraries/service/BundleLib.sol')} rel="noopener">The contracts</a> check progress before the message limits, compares the recomputed running hash with the source's latest running hash in the queue metadata, so a bundle must end at the source's latest message, enqueues a due configuration update before deleting acknowledged messages, and rejects a bundle with a reply out of order on a CLOSING channel.</p>
    </aside>
    <p class="small" style="margin:8px 0 0">Source: <a href={links.processing} rel="noopener">Channel state transitions §2</a> · <a href={links.progress} rel="noopener">§3</a> · <a href={links.pause} rel="noopener">§6</a> · <a href={links.verifyBundle} rel="noopener">Verifier interface §3</a> · <a href={links.runningHash} rel="noopener">Messaging §4</a> · <a href={links.ordering} rel="noopener">§8</a> · <a href={links.ack} rel="noopener">§9</a> · <a href={links.slashing} rel="noopener">Stakes and bonds §2.1</a> · <a href={links.charges} rel="noopener">Channel economics §1</a>. Running hashes are real SHA-256 over the UTF-8 text of each message; the protocol hashes the canonical protobuf bytes of each message. Charging and slashing follow the recommended design, which a deployment may change. The dispatch steps show the specification's delivery order: resolve the connector, apply the charging policy, then invoke the application. The reference contracts on EVM ledgers collect the charge after the call.</p>
  </div>
</div>

<style is:global>
  /* Global (not scoped) because the message rows, tables and list items are created at runtime;
     every selector is prefixed with .bundleverify so nothing leaks. */
  .bundleverify .bv__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
  @media (min-width: 720px) { .bundleverify .bv__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .bundleverify .bv__panel { border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; background: var(--bg-2); min-width: 0; }
  .bundleverify .bv__qpanel { margin-top: 10px; }
  .bundleverify .bv__panel h4 { margin: 0 0 6px; font-size: 0.92rem; }
  .bundleverify .bv__sub { display: block; font-weight: 400; font-size: 0.78rem; color: var(--text-3); }
  .bundleverify .bv__kv { margin: 0; font-size: 0.82rem; }
  .bundleverify .bv__kv > div { display: flex; flex-wrap: wrap; gap: 2px 10px; padding: 3px 0; border-bottom: 1px dashed var(--border); }
  .bundleverify .bv__kv > div:last-child { border-bottom: 0; }
  .bundleverify .bv__kv dt { font-family: var(--mono); font-size: 0.74rem; color: var(--text-3); flex: 0 0 11.5em; }
  .bundleverify .bv__kv dd { margin: 0; flex: 1 1 10em; min-width: 0; overflow-wrap: anywhere; transition: color 250ms; }
  .bundleverify .bv__kv dd.chg { color: var(--ok); font-weight: 700; animation: bv-flash 700ms ease; }
  .bundleverify .bv__kv dd.chg::after { content: ' ●'; font-size: 0.6em; vertical-align: middle; }
  .bundleverify .bv__kv dd.was::after { content: ' ●'; font-size: 0.6em; vertical-align: middle; color: var(--ok); opacity: 0.7; }
  .bundleverify .bv__kv dd.bad, .bundleverify .bv__kv dd.chg.bad { color: var(--bad); font-weight: 700; }
  .bundleverify .bv__kv code { font-size: 0.75rem; }
  .bundleverify .bv__kv code.nw { white-space: nowrap; }
  .bundleverify .bv__kv code.computing { animation: bv-shimmer 900ms ease-in-out infinite alternate; }
  @keyframes bv-flash { from { background: var(--ok-soft); } }
  @keyframes bv-shimmer { from { opacity: 0.4; } to { opacity: 1; } }
  /* The pills always take their own row in the head, so a long fault label never changes the head's height. */
  .bundleverify .bv__pills { display: flex; flex-basis: 100%; flex-wrap: wrap; gap: 6px; }
  .bundleverify .bv__msgs { display: flex; flex-direction: column; gap: 5px; margin-top: 8px; min-height: 2em; }
  /* Reserve room for four rows (a row measures 36 px), so picking a fault with fewer rows (or none,
     when the verifier reverts) does not move the control bar under the pointer. At desktop width
     the bundle panel also reserves the three extra lines its rows wrap onto at most, when a mark
     or the oversized payload appears (measured 236 px for fault c at 1280 px). */
  .bundleverify .bv__msgs { min-height: calc(4 * 2.3rem + 3 * 5px); }
  @media (min-width: 720px) { .bundleverify .bv__msgs[data-role="bundle"] { min-height: calc(4 * 2.3rem + 3 * 5px + 3 * 1.65rem); } }
  .bundleverify .bv__msgs.is-reverted .bv__msg { display: none; }
  .bundleverify .bv__msg { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 7px; border: 1px solid var(--border-2); border-radius: 8px; padding: 5px 8px; background: var(--surface); font-size: 0.8rem; transition: opacity 250ms, border-color 250ms, background-color 250ms, transform 250ms, box-shadow 250ms; }
  .bundleverify .bv__msg b { font-variant-numeric: tabular-nums; }
  .bundleverify .bv__msg code { font-size: 0.74rem; }
  .bundleverify .bv__msg .meta { color: var(--text-3); font-size: 0.72rem; }
  .bundleverify .bv__msg .marks { margin-left: auto; display: inline-flex; flex-wrap: wrap; gap: 4px; }
  .bundleverify .bv__msg.cur { border-color: var(--text); border-width: 2px; box-shadow: var(--shadow); transform: translateX(4px); }
  .bundleverify .bv__msg.done { opacity: 0.55; }
  .bundleverify .bv__msg.bad { border-color: var(--bad); background: var(--bad-soft); }
  .bundleverify .bv__msg::after { content: ''; position: absolute; left: 8px; right: 8px; top: 50%; height: 1px; background: var(--text-2); transform: scaleX(0); transform-origin: left; transition: transform 300ms ease; pointer-events: none; }
  .bundleverify .bv__msg.del { opacity: 0.6; border-style: dashed; }
  .bundleverify .bv__msg.del::after { transform: scaleX(1); }
  .bundleverify .bv__msg.fresh { border-color: var(--ok); animation: bv-slide 220ms ease-out; }
  @keyframes bv-slide { from { opacity: 0; transform: translateY(-6px); } }
  .bundleverify .bv__empty { color: var(--text-3); font-size: 0.8rem; font-style: italic; align-self: center; }
  .bundleverify .bv__track { margin: 0 0 10px; }
  .bundleverify .sim__track.seg > i.skip { background: var(--grey); opacity: 0.6; }
  @media (max-width: 479px) {
    .bundleverify .bv__kv > div { flex-direction: column; gap: 0; }
    .bundleverify .bv__kv dt, .bundleverify .bv__kv dd { flex: 0 0 auto; }
  }
  .bundleverify .step-card table { font-size: 0.8rem; margin: 6px 0 8px; }
  .bundleverify .step-card th, .bundleverify .step-card td { padding: 4px 6px; white-space: normal; vertical-align: middle; }
  .bundleverify .step-card td code { font-size: 0.72rem; white-space: nowrap; }
  .bundleverify .step-card .verdict { font-weight: 700; }
  .bundleverify .step-card .verdict.is-pass { color: var(--ok); }
  .bundleverify .step-card .verdict.is-reject, .bundleverify .step-card .verdict.is-pause { color: var(--bad); }
  .bundleverify .step-card .verdict.is-skip { color: var(--text-3); }
  .bundleverify .step-list li { cursor: pointer; }
  .bundleverify .step-list li.is-nr { cursor: default; opacity: 0.5; }
  .bundleverify .step-list li.is-nr:hover { background: transparent; }
  .bundleverify .step-list li .ev.is-pass { color: var(--ok); }
  .bundleverify .step-list li .ev.is-skip { color: var(--text-3); }
  .bundleverify .step-list li .ev.is-reject, .bundleverify .step-list li .ev.is-pause { color: var(--bad); }
  .bundleverify .step-list li .ev.is-nr { color: var(--text-3); font-weight: 500; text-transform: none; letter-spacing: 0; }
  .bundleverify .bv__notes { padding: 10px 14px 14px; border-top: 1px solid var(--border); }
  .bundleverify .bv__notes .callout { margin: 0; padding: 10px 14px; }
  .bundleverify .sim__log .k { font-family: var(--mono); font-size: 0.8em; }
</style>

<script>
  import { scrollListTo } from '@kse/lib/scroll';
  type MType = 'DATA' | 'REPLY' | 'CONTROL';
  type Outcome = 'SUCCESS' | 'APPLICATION_ERROR' | 'CONNECTOR_UNDERFUNDED';
  type Verdict = 'info' | 'pass' | 'skip' | 'reject' | 'pause' | 'done';
  interface BMsg { id: number; type: MType; text: string; meta: string; replyTo?: number; outcome?: Outcome; connector?: string }
  interface QItem { id: number; type: MType; label: string; note: string; acked: boolean; del?: string; fresh?: boolean }
  interface State { status: string; received: number; rhash: string; acked: number; next: number; anchorId: string; manifestV: number; queue: QItem[] }
  interface Step {
    n: string; label: string; title: string; where: string; plain: string; proto: string; refs: [string, string][];
    extra?: string; verdict: Verdict; state: State; changed: string[]; log: string; cur?: number; bad?: number; dispatched: number[];
  }
  interface Sync { received: number; status: string; next: number }
  interface Scenario { key: string; verifierReverts?: boolean; msgs: BMsg[]; sender: BMsg[]; sync: Sync; anchorId: number; rotate: boolean; manifest: boolean }
  interface Hashes { stored: string; computed: string[]; sender: string[]; last: string }

  const MAX_MSGS = 10;
  const MAX_BYTES = 64;
  const enc = new TextEncoder();
  const ZERO = new Uint8Array(32);
  async function sha256(b: Uint8Array): Promise<Uint8Array> { return new Uint8Array(await crypto.subtle.digest('SHA-256', b as BufferSource)); }
  async function chain(seed: Uint8Array, texts: string[]): Promise<Uint8Array[]> {
    let h = seed; const out: Uint8Array[] = [];
    // h[k] = SHA-256(h[k-1] ‖ SHA-256(p[k])) (Messaging §4).
    for (const t of texts) { const payloadHash = await sha256(enc.encode(t)); const buf = new Uint8Array(64); buf.set(h); buf.set(payloadHash, 32); h = await sha256(buf); out.push(h); }
    return out;
  }
  const hex = (b: Uint8Array, n = 6) => Array.from(b.slice(0, n)).map((x) => x.toString(16).padStart(2, '0')).join('') + '…';
  const bytes = (t: string) => enc.encode(t).length;
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const clone = <T,>(x: T): T => JSON.parse(JSON.stringify(x));

  // The peer's 42 earlier messages, as placeholders, so that H42 is a genuine chain value.
  const PREFIX_TEXTS = Array.from({ length: 42 }, (_, i) => `msg ${i + 1}`);
  const HONEST: BMsg[] = [
    { id: 43, type: 'DATA', text: 'ping', meta: 'via c1 → PingPong', connector: 'c1', outcome: 'SUCCESS' },
    { id: 44, type: 'DATA', text: 'pay Bo 5', meta: 'via c1 → Bank', connector: 'c1', outcome: 'APPLICATION_ERROR' },
    { id: 45, type: 'REPLY', text: 'reply(18) SUCCESS', meta: 'answers our #18', replyTo: 18 },
    { id: 46, type: 'DATA', text: 'pay Cy 2', meta: 'via c2 → Bank', connector: 'c2', outcome: 'CONNECTOR_UNDERFUNDED' },
  ];
  const SYNC: Sync = { received: 19, status: 'ACTIVE', next: 47 };
  function scenario(key: string, rotate: boolean, manifest: boolean): Scenario {
    const base: Scenario = { key, msgs: clone(HONEST), sender: clone(HONEST), sync: { ...SYNC }, anchorId: 46, rotate, manifest };
    if (key === 'a') base.verifierReverts = true;
    if (key === 'b') {
      const stale: BMsg[] = [40, 41, 42].map((id) => ({ id, type: 'DATA', text: `msg ${id}`, meta: 'already processed', connector: 'c1', outcome: 'SUCCESS' }));
      base.msgs = stale; base.sender = clone(stale); base.sync = { received: 17, status: 'ACTIVE', next: 43 }; base.anchorId = 42;
    }
    if (key === 'c') { const t = 'pay Bo 5 and Dee 3 and Ed 4 and Fay 1 and Gus 2 and Hal 9 and Ivy 6 and Jo 7 and Kay 8'; base.msgs[1].text = t; base.sender[1].text = t; }
    if (key === 'd') { base.msgs = base.msgs.slice(1); base.sender = base.sender.slice(1); }
    if (key === 'e') { base.msgs[1].text = 'pay Mallory 500'; }
    if (key === 'f') { base.msgs[2] = { id: 45, type: 'REPLY', text: 'reply(20) SUCCESS', meta: 'answers our #20', replyTo: 20 }; base.sender[2] = clone(base.msgs[2]); }
    return base;
  }

  let prefixP: Promise<Uint8Array[]> | null = null;
  let honestP: Promise<Uint8Array[]> | null = null;
  function getPrefix() { return (prefixP ??= chain(ZERO, PREFIX_TEXTS)); }
  async function getHonest() { return (honestP ??= chain((await getPrefix())[41], HONEST.map((m) => m.text))); }
  async function prepare(sc: Scenario): Promise<Hashes> {
    const prefix = await getPrefix(); const honest = await getHonest();
    const before = (id: number) => (id === 1 ? ZERO : id - 1 <= 42 ? prefix[id - 2] : honest[id - 1 - 43]);
    const stored = prefix[41];
    // Only the messages the channel has not received are hashed (Step 7 runs over "new").
    const computed = await chain(stored, sc.msgs.filter((m) => m.id > 42).map((m) => m.text));
    const senderChain = await chain(before(sc.sender[0].id), sc.sender.map((m) => m.text));
    return { stored: hex(stored), computed: computed.map((h) => hex(h)), sender: senderChain.map((h) => hex(h)), last: hex(senderChain[senderChain.length - 1]) };
  }

  const PILL: Record<MType, string> = { DATA: 'c', REPLY: 'b', CONTROL: 'grey' };
  const FEE = 'The submitting account paid the transaction fee and is not reimbursed.';
  const NOCHANGE = 'No channel state changed: processing is atomic, so every effect of the earlier steps, including a manifest or trust anchor replacement, is discarded.';
  const STORED_RECEIVED = 42;

  function build(sc: Scenario, H: Hashes): { steps: Step[]; canon: { n: string; label: string }[] } {
    const stored: State = {
      status: 'ACTIVE', received: STORED_RECEIVED, rhash: H.stored, acked: 17, next: 21, anchorId: 'epoch 7', manifestV: 3,
      queue: [
        { id: 18, type: 'DATA', label: 'pay Cy 2', note: 'to Bank on A · via c1', acked: false },
        { id: 19, type: 'CONTROL', label: 'ConfigUpdate', note: 'our new throttles', acked: false },
        { id: 20, type: 'DATA', label: 'ping', note: 'to PingPong on A · via c1', acked: false },
      ],
    };
    // The messages of the bundle that this side has not received yet ("new" in Step 6).
    const fresh = sc.msgs.filter((m) => m.id > STORED_RECEIVED);
    const canon: { n: string; label: string }[] = [
      { n: '0', label: 'bundle submitted' }, { n: '1', label: 'pre-checks' }, { n: '2', label: 'verify' }, { n: '3', label: 'limits' },
      { n: '4', label: 'progress' }, { n: '5', label: 'manifest and trust anchor' }, { n: '6', label: 'replay defence' }, { n: '7', label: 'running hash' },
      { n: '8', label: 'acknowledgement check' }, { n: '9', label: 'response ordering' }, { n: '10', label: 'acknowledgement' }, { n: '11', label: 'auto-resume' },
      { n: '12', label: 'configuration propagation' },
      ...fresh.map((m) => ({ n: '13', label: `dispatch #${m.id} (${m.type})` })), { n: '13', label: 'advance received id and hash' },
      { n: '14', label: 'status' }, { n: '✓', label: 'bundle processed' },
    ];
    const steps: Step[] = [];
    let st = clone(stored);
    let dispatched: number[] = [];
    const n = sc.msgs.length;
    const last = sc.msgs[n - 1];
    const idsText = sc.msgs.map((m) => m.id).join(', ');
    const tidy = (s: State) => { s.queue = s.queue.filter((q) => !q.del); for (const q of s.queue) q.fresh = false; };
    const push = (s: Omit<Step, 'state' | 'dispatched'> & { state?: State }) => {
      steps.push({ ...s, state: s.state ?? clone(st), dispatched: [...dispatched] });
      tidy(st);
    };
    const reject = (base: Omit<Step, 'state' | 'dispatched' | 'verdict' | 'changed' | 'log'>, log: string) => {
      steps.push({ ...base, verdict: 'reject', state: clone(stored), changed: [], log: `<span class="bad">Rejected at the ${base.label} step.</span> ${log} ${FEE} ${NOCHANGE}`, dispatched: [] });
    };
    const WHERE = 'Channel state transitions §2';

    // 0 — submission
    push({
      n: '0', label: 'bundle submitted', title: 'A bundle is submitted as a transaction', where: 'before processing',
      plain: 'An endpoint has received a bundle from Ledger A\'s side and now submits it to our ledger as an ordinary transaction. Any account may submit a bundle. Everything that follows runs inside that transaction, and processing is atomic: if any step rejects the bundle, every effect of the earlier steps is discarded. On the left is what our ledger already knows about this channel; on the right, what the verifier will return for the bundle.',
      proto: 'Any caller can submit a bundle for a channel. The CLPR Service treats the bundle as opaque bytes. The stored channel state the algorithm checks against: the status, the trust anchor and its id, the peer manifest version, and the queue counters: the received message id and running hash, the acknowledged message id and the next message id.',
      refs: [['processing', 'Channel state transitions §2'], ['bundleContent', 'Bundle §1'], ['queue', 'Messaging §2']], verdict: 'info', changed: [], log: 'Nothing has happened yet. Press Next to run the first step, or pick a fault first.',
    });

    // 1 — pre-checks
    push({
      n: '1', label: 'pre-checks', title: 'The channel exists, is not CLOSED, and the bundle is not too large', where: WHERE,
      plain: 'Three cheap checks before anything is verified. The channel must exist: a PENDING claim has no channel record, so its bundles are rejected as for an unknown channel. It must not be CLOSED. And the bundle\'s bytes must be within the bundle size limit this ledger publishes in its own throttles.',
      proto: 'Reject "channel not found" (which includes PENDING), "channel closed", or "bundle too large" when the bundle is larger than our own bundle size limit. All three pass here.',
      refs: [['processing', 'Channel state transitions §2'], ['statuses', 'Channel state transitions §1'], ['throttles', 'Ledger configuration §3']], extra: '<p class="verdict is-pass">channel ACTIVE, bundle within the size limit → continue</p>',
      verdict: 'pass', changed: [], log: 'Nothing changed.',
    });

    // 2 — verifier
    if (sc.verifierReverts) {
      reject({
        n: '2', label: 'verify', title: 'The verifier fails', where: WHERE,
        plain: 'The CLPR Service hands the bundle to the channel\'s verifier contract, together with the trust anchor stored with the channel (epoch 7) and the channel context. The proof is not valid under that trust anchor, so the verifier fails and returns nothing. Nothing else is looked at.',
        proto: 'The call to the verifier fails → reject "verification failed". A verifier signals rejection only by failing; it does not report partial results. The channel\'s state and status do not change, and the submitter bears the cost of the submission.',
        refs: [['processing', 'Channel state transitions §2'], ['verifyBundle', 'Verifier interface §3'], ['rejection', 'Verifier interface §5']], extra: '<p class="verdict is-reject">verifier failed → bundle rejected</p>', bad: undefined,
      }, 'The proof does not verify under trust anchor "epoch 7".');
      return { steps, canon };
    }
    push({
      n: '2', label: 'verify', title: 'The verifier checks the proof and returns the bundle content', where: WHERE,
      plain: 'The CLPR Service hands the bundle to the channel\'s verifier contract, together with the trust anchor stored with the channel (epoch 7) and the channel context. The verifier checks the proof and returns the abstract bundle content: Ledger A\'s queue metadata, the messages, the id and running hash of the last message, and any trust anchor change or newer endpoint manifest. The CLPR Service never reads proof bytes itself; everything on the right of the screen is what the verifier returned.',
      proto: `The verifier returns the queue metadata, the ${n} messages, the id of the last message (${sc.anchorId}) and its running hash, a new trust anchor with its id (${sc.rotate ? 'epoch 8' : 'none'}) and a newer endpoint manifest (${sc.manifest ? 'version 4' : 'none'}). The Service then checks that the new trust anchor and its id are both empty or both set. The verifier binds the content to the channel; it does not check the running hash, the message ids against our state, replay or response ordering. Those are the Service's own checks, below.`,
      refs: [['processing', 'Channel state transitions §2'], ['verifyBundle', 'Verifier interface §3'], ['bundleContent', 'Bundle §1']], extra: '<p class="verdict is-pass">verifier returned normally → continue</p>',
      verdict: 'pass', changed: [], log: 'Nothing changed yet; the verifier only reads. The returned values are now on the right.',
    });

    // 3 — limits
    const sizes = sc.msgs.map((m) => [m, bytes(m.text)] as [BMsg, number]);
    const tooBig = sizes.find(([m, b]) => m.type === 'DATA' && b > MAX_BYTES);
    const sizeTable = `<table><thead><tr><th>#</th><th>type</th><th>bytes</th><th>≤ ${MAX_BYTES}?</th></tr></thead><tbody>${sizes.map(([m, b]) => { const applies = m.type === 'DATA'; const ok = !applies || b <= MAX_BYTES; return `<tr><td>${m.id}</td><td>${m.type}</td><td>${b}</td><td><span class="pill ${!applies ? 'grey' : ok ? 'ok' : 'bad'}">${!applies ? 'n/a' : ok ? 'yes' : 'no'}</span></td></tr>`; }).join('')}</tbody></table><p class="small" style="margin:0 0 6px">messages: ${n}, limit ${MAX_MSGS} <span class="pill ${n <= MAX_MSGS ? 'ok' : 'bad'}">${n <= MAX_MSGS ? 'yes' : 'no'}</span></p>`;
    if (tooBig || n > MAX_MSGS) {
      const bad = tooBig ? tooBig[0].id : undefined;
      reject({
        n: '3', label: 'limits', title: 'A DATA message is larger than we accept', where: WHERE,
        plain: `Message ${bad} is a DATA message of ${tooBig![1]} bytes, more than the ${MAX_BYTES}-byte payload limit this ledger publishes. The limit is checked for the bundle as a whole: one oversized DATA message rejects the entire bundle, not just that message.`,
        proto: `A DATA message whose payload is larger than our own payload limit (${MAX_BYTES} bytes) → reject "payload too large". The source CLPR Service must already refuse such a message at enqueue, against our published value; the destination applies its own value here.`,
        refs: [['processing', 'Channel state transitions §2'], ['throttles', 'Ledger configuration §3']], extra: sizeTable + '<p class="verdict is-reject">oversized DATA payload → bundle rejected</p>', bad,
      }, `Message ${bad} exceeds the payload limit.`);
      return { steps, canon };
    }
    push({
      n: '3', label: 'limits', title: 'Not too many messages, no DATA message too big', where: WHERE,
      plain: `Two limits from the throttles this ledger publishes in its own configuration: at most ${MAX_MSGS} messages in a bundle, counting any we have already received, and no DATA message above ${MAX_BYTES} payload bytes. The payload limit applies only to DATA messages.`,
      proto: `The bundle carries ${n} messages, within the limit of ${MAX_MSGS}, and no DATA payload is above ${MAX_BYTES} bytes. Either violation rejects the entire bundle.`,
      refs: [['processing', 'Channel state transitions §2'], ['throttles', 'Ledger configuration §3']], extra: sizeTable + '<p class="verdict is-pass">within limits → continue</p>',
      verdict: 'pass', changed: [], log: 'Nothing changed.',
    });

    // 4 — progress
    const closingSet = ['CLOSING', 'DRAINED', 'CLOSED'];
    const c1 = n > 0 && sc.anchorId > st.received;
    const c2 = sc.rotate;
    const c3 = sc.manifest && 4 > st.manifestV;
    const c4 = sc.sync.received > st.acked;
    const c5a = closingSet.includes(sc.sync.status) && ['ACTIVE', 'PAUSED'].includes(st.status);
    const crit = [
      ['1', 'New messages', `the bundle ends at ${sc.anchorId}; we have received through ${st.received}`, c1],
      ['2', 'Trust anchor change', sc.rotate ? 'new id epoch 8; stored epoch 7' : 'no new trust anchor', c2],
      ['3', 'Manifest update', sc.manifest ? 'version 4 proven; version 3 stored' : 'no manifest in the bundle', c3],
      ['4', 'Acknowledgement', `the peer has received ours through ${sc.sync.received}; acknowledged through ${st.acked}`, c4],
      ['5a', 'Peer closing', `peer ${sc.sync.status}, own status ${st.status}`, c5a],
      ['5b', 'Drain', `own status ${st.status}, not CLOSING`, false],
      ['5c', 'Close', `own status ${st.status}, not DRAINED`, false],
    ] as [string, string, string, boolean][];
    const held = crit.filter((c) => c[3]);
    const critTable = `<table><thead><tr><th>criterion</th><th>holds?</th></tr></thead><tbody>${crit.map(([, name, why, ok]) => `<tr><td><b>${name}</b><br/><span class="small">${esc(why)}</span></td><td><span class="pill ${ok ? 'ok' : 'grey'}">${ok ? 'yes' : 'no'}</span></td></tr>`).join('')}</tbody></table>`;
    if (!held.length) {
      reject({
        n: '4', label: 'progress', title: 'The bundle changes nothing: no progress', where: `${WHERE}, §3`,
        plain: `The proof is genuine, but the bundle carries messages ${idsText}, which we already have, and queue metadata that acknowledges nothing new. None of the progress criteria holds, so the bundle is rejected. Endpoints should not submit such bundles: a rejected bundle still costs the submitter its transaction fee.`,
        proto: `No progress criterion holds, evaluated against the channel's state before the bundle: the bundle ends at ${sc.anchorId}, which we already have; no trust anchor change; no newer manifest; the peer acknowledges nothing beyond ${st.acked}; the peer is not closing → reject "no progress".`,
        refs: [['processing', 'Channel state transitions §2'], ['progress', 'Channel state transitions §3'], ['submission', 'CLPR Service §5']], extra: critTable + '<p class="verdict is-reject">no criterion holds → no progress</p>',
      }, 'No progress criterion holds.');
      return { steps, canon };
    }
    push({
      n: '4', label: 'progress', title: 'Does this bundle make progress?', where: `${WHERE}, §3`,
      plain: 'Before doing any more work, the CLPR Service asks whether the bundle changes anything at all. At least one progress criterion must hold, or the bundle is rejected. One is enough: a bundle with no messages that only changes the trust anchor, or only brings a newer endpoint manifest, is valid.',
      proto: 'The criteria are evaluated against the channel\'s state before the bundle. A bundle without queue metadata (it then carries no messages) can only make progress by a trust anchor change or a manifest update; it stops once they are installed and changes no acknowledgement, status or message id.',
      refs: [['processing', 'Channel state transitions §2'], ['progress', 'Channel state transitions §3']], extra: critTable + `<p class="verdict is-pass">${held.length} criteri${held.length === 1 ? 'on holds' : 'a hold'} → continue</p>`,
      verdict: 'pass', changed: [], log: `Criteria that hold: ${held.map((c) => c[1].toLowerCase()).join(', ')}. Nothing changed.`,
    });

    // 5 — manifest and trust anchor
    const changed5: string[] = [];
    if (sc.manifest) { st.manifestV = 4; changed5.push('manifestV'); }
    if (sc.rotate) { st.anchorId = 'epoch 8'; changed5.push('anchorId'); }
    push({
      n: '5', label: 'manifest and trust anchor', title: changed5.length ? 'Install what the bundle proves, before any message' : 'No newer manifest, no trust anchor change: skip', where: WHERE,
      plain: changed5.length
        ? `${sc.manifest ? 'The bundle proves Ledger A\'s endpoint manifest at version 4, newer than the version 3 we hold, so it replaces our peer manifest as a whole. ' : ''}${sc.rotate ? 'The bundle proves that Ledger A\'s signing authority has moved to epoch 8, with a commitment proven under epoch 7, so the stored trust anchor and its id are replaced. ' : ''}Both take effect before any message of the bundle is processed, so every message is attributed to the authority that proved it.`
        : 'A bundle can carry a newer endpoint manifest of Ledger A, or a trust anchor change. This one carries neither, so the peer manifest stays at version 3 and the trust anchor stays "epoch 7". (Tick the options above to see them applied.)',
      proto: `If the bundle carries an endpoint manifest with a higher version than the stored one, install it as the peer manifest${sc.manifest ? ' (3 → 4)' : ''}. If it carries a new trust anchor, store it and its id${sc.rotate ? ' ("epoch 7" → "epoch 8")' : ''}. Only bundle processing changes the trust anchor; no administrative operation does. If a later step rejects the bundle, these replacements are discarded with it.`,
      refs: [['processing', 'Channel state transitions §2'], ['peerManifest', 'Endpoint manifest §4'], ['anchorChange', 'Verifier interface §4']], extra: changed5.length ? '<p class="verdict is-pass">installed before any message is processed</p>' : '<p class="verdict is-skip">nothing to install → skipped</p>',
      verdict: changed5.length ? 'pass' : 'skip', changed: changed5,
      log: changed5.length ? [sc.manifest ? '<span class="k">peer manifest version</span> 3 → 4' : '', sc.rotate ? '<span class="k">trust_anchor_id</span> epoch 7 → epoch 8' : ''].filter(Boolean).join(' · ') + '. If a later step rejects the bundle, this is discarded with it.' : 'Nothing changed.',
    });

    // 6 — replay defence
    const firstId = sc.anchorId - n + 1;
    let gapWhy = '';
    if (sc.sync.next < st.received + 1) gapWhy = 'replay';
    else if (n > 0 && (sc.anchorId < n || sc.anchorId >= sc.sync.next)) gapWhy = 'invalid message range';
    else if (n > 0 && (sc.anchorId < st.received || sc.anchorId > st.received + n)) gapWhy = 'message gap';
    if (gapWhy) {
      reject({
        n: '6', label: 'replay defence', title: 'The ids do not line up: a message is missing', where: WHERE,
        plain: `We have received Ledger A's messages through ${st.received}, so the next one we need is ${st.received + 1}. This bundle carries ${n} messages ending at ${sc.anchorId}, so it starts at ${firstId}: message ${st.received + 1} is missing. Every message in it is genuine and the proof is valid, but a bundle cannot skip a message, so it is rejected.`,
        proto: `The bundle's ${n} messages end at ${sc.anchorId}, more than ${n} beyond the ${st.received} we have received, so at least one message is missing → reject "${gapWhy}". The messages carry consecutive ids that end at the last message's id. This check is the CLPR Service's own and does not depend on the verifier.`,
        refs: [['processing', 'Channel state transitions §2'], ['partial', 'Bundle §3']], extra: `<p class="verdict is-reject">starts at ${firstId}, ${st.received + 1} needed → bundle rejected</p>`, bad: sc.msgs[0]?.id,
      }, `The bundle starts at ${firstId}; message ${st.received + 1} is missing.`);
      return { steps, canon };
    }
    const skipped = sc.msgs.filter((m) => m.id <= st.received);
    push({
      n: '6', label: 'replay defence', title: skipped.length ? 'Messages we already have are skipped' : 'Exactly the next messages, with no gaps', where: WHERE,
      plain: skipped.length
        ? `We have received Ledger A's messages through ${st.received}. The bundle carries ${idsText}, all of which we already have. That is allowed: a bundle can start with messages already received, and every later step skips them. ${fresh.length ? '' : 'Nothing new is left to process; the bundle made progress by its other content.'}`
        : `We have received Ledger A's messages through ${st.received}. The bundle runs from ${firstId} to ${sc.anchorId}: exactly the next ones, with no gap. A bundle may also start with messages we already have, which are skipped; it can never skip a message we have not had.`,
      proto: `The peer's next message id (${sc.sync.next}) is beyond what we have received, so this is no replay; the last message, ${sc.anchorId}, is one the peer has sent; and the bundle neither ends before the messages we hold nor starts after the next one we need (${st.received + 1}). New messages: ${fresh.length ? fresh.map((m) => m.id).join(', ') : 'none'}.`,
      refs: [['processing', 'Channel state transitions §2'], ['partial', 'Bundle §3']], extra: `<p class="verdict is-pass">${fresh.length ? `new: ${fresh.map((m) => m.id).join(', ')}` : 'no new message'} → continue</p>`,
      verdict: 'pass', changed: [], log: 'Nothing changed.',
    });

    // 7 — running hash
    const computedLast = H.computed.length ? H.computed[H.computed.length - 1] : H.stored;
    const match = computedLast === H.last;
    let firstDiff = -1;
    const rows = fresh.map((m, k) => {
      const senderIdx = sc.sender.findIndex((s) => s.id === m.id);
      const same = senderIdx >= 0 && H.sender[senderIdx] === H.computed[k];
      if (!same && firstDiff < 0) firstDiff = k;
      return `<tr><td>#${m.id}</td><td><code style="color:${same ? 'inherit' : 'var(--bad)'}">${H.computed[k]}</code></td><td>${same ? '<span class="pill grey">recomputed</span>' : '<span class="pill bad">differs</span>'}</td></tr>`;
    });
    const chainTable = `<table><thead><tr><th>after</th><th>running hash</th><th></th></tr></thead><tbody><tr><td>#${st.received} (stored)</td><td><code>${H.stored}</code></td><td><span class="pill grey">start</span></td></tr>${rows.join('')}<tr><td>#${sc.anchorId} (proven)</td><td><code>${H.last}</code></td><td>${match ? '<span class="pill ok">matches</span>' : '<span class="pill bad">does not match</span>'}</td></tr></tbody></table>`;
    if (!match) {
      const badMsg = fresh[Math.max(firstDiff, 0)];
      reject({
        n: '7', label: 'running hash', title: 'The chain does not reproduce the proven running hash', where: WHERE,
        plain: `Starting from the running hash we stored after message ${st.received}, we recompute the chain over the new messages. Message ${badMsg.id} reads "${esc(badMsg.text)}", which is not what Ledger A enqueued, so from there on every running hash differs, and the last one does not equal the running hash that Ledger A's state proof proves for message ${sc.anchorId}. One mismatch rejects the whole bundle.`,
        proto: `Recompute from the stored running hash over the payload bytes of each new message; the result (${computedLast}) differs from the proven running hash of the last message (${H.last}) → reject "running hash mismatch". The proof covers the last message's queue entry, so the endpoint cannot adjust it, and the messages before it are bound by the chain.`,
        refs: [['processing', 'Channel state transitions §2'], ['runningHash', 'Messaging §4'], ['proof', 'Bundle §4']], extra: chainTable + '<p class="verdict is-reject">hash mismatch → bundle rejected</p>', bad: badMsg.id,
      }, 'The recomputed running hash does not equal the proven one.');
      return { steps, canon };
    }
    push({
      n: '7', label: 'running hash', title: 'Recompute the running hash chain and compare the last link', where: WHERE,
      plain: fresh.length
        ? `Starting from the running hash we stored after message ${st.received}, we recompute the chain over the new messages, one step per message. Only the final value is compared, with the running hash that Ledger A's state proof proves for message ${sc.anchorId}. Anything altered, dropped, reordered or inserted on the way would change it. It matches.`
        : `No message is new, so the chain stays at the running hash we stored after message ${st.received}. It must still equal the running hash proven for the bundle's last message, ${sc.anchorId}. It does.`,
      proto: `Starting from the stored running hash, each new message extends the chain with its payload bytes; the result must equal the proven running hash of message ${sc.anchorId}. This guards against a verifier that authenticates a proof but returns garbled messages; it cannot guard against a verifier that fabricates a matching hash. Here the payload bytes are the UTF-8 text shown; the protocol hashes the canonical protobuf bytes of each message.`,
      refs: [['processing', 'Channel state transitions §2'], ['runningHash', 'Messaging §4'], ['payload', 'Messaging §3']], extra: chainTable + '<p class="verdict is-pass">recomputed running hash = proven → continue</p>',
      verdict: 'pass', changed: [], log: 'Nothing changed yet: the recomputed running hash is stored after dispatch.',
    });

    // 8 — acknowledgement check
    push({
      n: '8', label: 'acknowledgement check', title: 'The acknowledgement neither moves back nor runs ahead', where: WHERE,
      plain: `Ledger A's queue metadata says it has received our messages through ${sc.sync.received}. That may not be lower than the ${st.acked} it acknowledged before, and it may not acknowledge a message we never sent: our last is ${st.next - 1}. It is within bounds.`,
      proto: `The peer's acknowledgement (${sc.sync.received}) must be at least the one stored (${st.acked}) and at most our latest message id (${st.next - 1}); otherwise reject "invalid acknowledgement".`,
      refs: [['processing', 'Channel state transitions §2'], ['ack', 'Messaging §9']], extra: `<p class="verdict is-pass">${st.acked} ≤ ${sc.sync.received} ≤ ${st.next - 1} → continue</p>`,
      verdict: 'pass', changed: [], log: 'Nothing changed.',
    });

    // 9 — response ordering, over all new messages before any dispatch
    const waiting = st.queue.filter((q) => q.type === 'DATA').map((q) => q.id);
    const replies = fresh.filter((m) => m.type === 'REPLY');
    let violation: BMsg | undefined;
    let expectedAt: number | undefined;
    for (const r of replies) {
      if (r.replyTo === waiting[0]) waiting.shift();
      else { violation = r; expectedAt = waiting[0]; break; }
    }
    if (violation) {
      const paused = clone(st); paused.status = 'PAUSED';
      steps.push({
        n: '9', label: 'response ordering', title: `REPLY ${violation.id} is out of order: PAUSED`, where: `${WHERE}, §6`,
        plain: `Message ${violation.id} claims to answer our message ${violation.replyTo}, but the oldest DATA message still waiting for an answer is ${expectedAt ?? 'none'}. Each side answers in the order it receives, so this shows that Ledger A's outbound queue is inconsistent. The channel is PAUSED and processing stops here: no message of this bundle is dispatched, and the received message id and running hash do not move. The first bundle without a violation resumes the channel on its own; the administrator can also close it.`,
        proto: `Every REPLY must answer the oldest unanswered DATA message in our outbound queue, walking past REPLY and CONTROL messages (it answers ${violation.replyTo}; the oldest is ${expectedAt}). On a violation an ACTIVE channel becomes PAUSED and the Service returns: nothing is dispatched. The manifest and trust anchor replacements still take effect; the Service MAY also apply the acknowledgement, which this model does not. On a CLOSING or DRAINED channel the Service MAY reject the bundle instead. While PAUSED, applications cannot send and queued messages still sync.`,
        refs: [['ordering', 'Messaging §8'], ['pause', 'Channel state transitions §6'], ['transitionsTable', 'Channel state transitions §4']], extra: `<p class="verdict is-pause">reply(${violation.replyTo}) ≠ oldest unanswered #${expectedAt} → channel PAUSED, nothing processed</p>`,
        verdict: 'pause', state: paused, changed: ['status'], cur: violation.id, bad: violation.id, dispatched: [],
        log: `<span class="bad">Channel PAUSED.</span> The bundle is not rejected, but nothing in it is processed: the acknowledgement stays ${st.acked}, the received message id stays ${st.received}, our queue is as it was. ${changed5.length ? 'The manifest and trust anchor replacements are kept. ' : ''}Contrast with the other faults: a failed check rejects the bundle and leaves the status alone; PAUSED is reserved for response ordering violations.`,
      });
      return { steps, canon };
    }
    push({
      n: '9', label: 'response ordering', title: replies.length ? 'Every REPLY answers the oldest unanswered DATA message' : 'No REPLY in this bundle', where: `${WHERE}, §6`,
      plain: replies.length
        ? `Before anything is dispatched, the CLPR Service checks every REPLY among the new messages. Message ${replies.map((r) => r.id).join(', ')} answers our message ${replies.map((r) => r.replyTo).join(', ')}, and that is the oldest DATA message in our outbound queue still waiting for an answer. The order holds.`
        : 'Before anything is dispatched, the CLPR Service checks every REPLY among the new messages against the oldest unanswered DATA message in its outbound queue. There is no REPLY to check here.',
      proto: 'Each REPLY must answer the oldest unanswered DATA message in the outbound queue; the walk skips REPLY and CONTROL messages. The check runs over all new messages before any is dispatched.',
      refs: [['ordering', 'Messaging §8'], ['processing', 'Channel state transitions §2']], extra: `<p class="verdict ${replies.length ? 'is-pass' : 'is-skip'}">${replies.length ? 'in order → continue' : 'nothing to check'}</p>`,
      verdict: replies.length ? 'pass' : 'skip', changed: [], log: 'Nothing changed.',
    });

    // 10 — acknowledgement
    const prevAcked = st.acked;
    st.acked = sc.sync.received;
    const deleted: QItem[] = []; const retained: QItem[] = [];
    for (const q of st.queue) {
      if (q.id <= st.acked) { q.acked = true; if (q.type !== 'DATA') { q.del = 'deleted on ack'; deleted.push(q); } else retained.push(q); }
    }
    const ackMoved = st.acked !== prevAcked;
    push({
      n: '10', label: 'acknowledgement', title: ackMoved ? 'Record the peer\'s acknowledgement and tidy our own queue' : 'The acknowledgement has not moved', where: WHERE,
      plain: ackMoved
        ? `Ledger A has received our messages through ${st.acked}. We record that, then clean our own outbound queue: acknowledged REPLY and CONTROL messages are deleted, because they need nothing further. Acknowledged DATA messages stay until their REPLY arrives, because the order of Ledger A's replies is checked against them.`
        : `Ledger A still acknowledges our messages through ${st.acked}, so nothing in our outbound queue can be deleted.`,
      proto: `The stored acknowledgement takes the peer's value (${prevAcked} → ${st.acked}). Deleted: ${deleted.length ? deleted.map((q) => `#${q.id} ${q.type}`).join(', ') : 'none'}. Kept until their REPLY is processed: ${retained.length ? retained.map((q) => `#${q.id}`).join(', ') : 'none'}. A Service MAY instead store an answered acknowledgement, capped below the oldest unanswered DATA message.`,
      refs: [['processing', 'Channel state transitions §2'], ['ack', 'Messaging §9']], extra: `<p class="verdict ${ackMoved ? 'is-pass' : 'is-skip'}">acked ${prevAcked} → ${st.acked}; ${deleted.length} deleted, ${retained.length} kept</p>`,
      verdict: ackMoved ? 'pass' : 'skip', changed: ackMoved ? ['acked'] : [],
      log: ackMoved ? `<span class="k">acked_message_id</span> ${prevAcked} → ${st.acked}${deleted.map((q) => ` · #${q.id} (${q.type}) deleted on ack`).join('')}${retained.map((q) => ` · #${q.id} (DATA) kept, awaiting its reply`).join('')}${st.queue.some((q) => q.id > st.acked) ? ` · ${st.queue.filter((q) => q.id > st.acked).map((q) => `#${q.id}`).join(', ')} not yet acknowledged` : ''}.` : 'Nothing changed.',
    });

    // 11 — auto-resume
    push({
      n: '11', label: 'auto-resume', title: 'Was the channel PAUSED? No', where: WHERE,
      plain: 'A PAUSED channel returns to ACTIVE here, with the first bundle accepted without a response ordering violation. Ours is ACTIVE, so nothing changes.',
      proto: `A PAUSED channel becomes ACTIVE. Own status is ${st.status}.`,
      refs: [['processing', 'Channel state transitions §2'], ['pause', 'Channel state transitions §6']], extra: '<p class="verdict is-skip">not PAUSED → nothing to do</p>',
      verdict: 'skip', changed: [], log: 'Nothing changed.',
    });

    // 12 — configuration propagation
    push({
      n: '12', label: 'configuration propagation', title: 'Any configuration change to send the peer? No', where: WHERE,
      plain: 'If our administration had changed this ledger\'s configuration since we last sent it on this channel, a ConfigUpdate CONTROL message would be enqueued here, before any REPLY this bundle generates, so that both ledgers agree on the point in the message stream where the change takes effect. Our last change already went out as message 19, so nothing is due.',
      proto: 'If the channel is ACTIVE and a ConfigUpdate is due (the channel\'s last propagated configuration timestamp is older than the current configuration\'s), enqueue it now. A ConfigUpdate carries the configuration, not endpoint manifest changes; those travel in bundles. Not due here.',
      refs: [['processing', 'Channel state transitions §2'], ['configSend', 'Ledger configuration §5.2']], extra: '<p class="verdict is-skip">not due → nothing enqueued</p>',
      verdict: 'skip', changed: [], log: 'Nothing changed.',
    });

    // 13 — dispatch, by message type
    for (const m of fresh) {
      if (m.type === 'DATA') {
        const replyId = st.next;
        st.queue.push({ id: replyId, type: 'REPLY', label: `reply(${m.id}) ${m.outcome}`, note: 'to Ledger A', acked: false, fresh: true });
        st.next += 1; dispatched.push(m.id);
        let plain = '', proto = '', verdictLine = '';
        if (m.outcome === 'SUCCESS') {
          plain = `Message ${m.id} is a DATA message for the PingPong application here. The CLPR Service resolves the connector it names (${m.connector}) on this channel. ${m.connector} is charged the execution cost plus a margin, paid to the account that submitted the bundle. PingPong is invoked, and a SUCCESS REPLY is enqueued for Ledger A as our message ${replyId}.`;
          proto = `Resolve the connector the message names (${m.connector}) on the channel: found. Apply the charging policy: the destination connector is charged and the bundle submitter paid. Invoke the target application with the channel id, the sender and the message data, within our execution budget per message. It succeeds → enqueue one REPLY that answers message ${m.id}, with status SUCCESS and the application's return data, as our message ${replyId}.`;
          verdictLine = `<p class="verdict is-pass">delivered · REPLY SUCCESS enqueued as #${replyId}</p>`;
        } else if (m.outcome === 'APPLICATION_ERROR') {
          plain = `Message ${m.id} asks the Bank application to pay Bo 5, and Bank fails (say Bo has no account). That is not the connector's fault: ${m.connector} is still charged, the REPLY carries APPLICATION_ERROR, and no connector is slashed. A failure of one application affects only the REPLY of that message; the other messages are processed normally.`;
          proto = `Connector ${m.connector} resolved and charged as for a successful message. The invocation fails → status APPLICATION_ERROR, enqueued as our message ${replyId}. APPLICATION_ERROR is not attributable to a connector, so no connector is slashed on either ledger.`;
          verdictLine = `<p class="verdict is-pass">application failed · REPLY APPLICATION_ERROR enqueued as #${replyId} · no slash</p>`;
        } else {
          plain = `Message ${m.id} names connector ${m.connector}, whose balance on this ledger cannot pay the charge. The message is not dispatched: Bank is not called. ${m.connector}'s locked stake is slashed and the penalty paid to the submitter, and a CONNECTOR_UNDERFUNDED REPLY is enqueued as our message ${replyId}. When that REPLY reaches Ledger A, the source connector is slashed as well. The other messages are unaffected.`;
          proto = `Connector ${m.connector} found, but it cannot pay → status CONNECTOR_UNDERFUNDED, empty reply data, enqueued as our message ${replyId}. The local connector is slashed on this ledger, the source connector on Ledger A when the REPLY arrives, and each penalty goes to the submitter of the bundle being processed. Penalties escalate and end in a ban.`;
          verdictLine = `<p class="verdict is-pass">connector underfunded · stake slashed · REPLY CONNECTOR_UNDERFUNDED enqueued as #${replyId}</p>`;
        }
        push({
          n: '13', label: `dispatch #${m.id} (DATA)`, title: `DATA message ${m.id}: charge, deliver, reply`, where: `${WHERE}, dispatch`,
          plain, proto, refs: [['processing', 'Channel state transitions §2'], ['delivery', 'Messaging §6'], ['replies', 'Messaging §7'], ['charges', 'Channel economics §1'], ['slashing', 'Stakes and bonds §2.1']], extra: verdictLine,
          verdict: 'pass', changed: ['next'], cur: m.id,
          log: `queue: +#${replyId} REPLY(${m.id}) ${m.outcome} · <span class="k">next_message_id</span> ${replyId} → ${st.next}${m.outcome === 'CONNECTOR_UNDERFUNDED' ? ` · ${m.connector}'s locked stake slashed, penalty to the submitter` : ` · ${m.connector} charged, paid to the submitter`}.`,
        });
      } else if (m.type === 'REPLY') {
        const answered = st.queue.find((q) => q.type === 'DATA' && !q.del && q.id === m.replyTo)!;
        answered.del = 'deleted: reply processed';
        dispatched.push(m.id);
        push({
          n: '13', label: `dispatch #${m.id} (REPLY)`, title: `REPLY ${m.id}: deliver, delete #${m.replyTo}`, where: `${WHERE}, dispatch`,
          plain: `Message ${m.id} is Ledger A's answer to our message ${m.replyTo}; its order was checked before dispatch. The REPLY is delivered to the application that sent ${m.replyTo}, and message ${m.replyTo} is deleted from our queue. Its status is SUCCESS, so no connector is slashed. The connector that authorized ${m.replyTo} is charged for delivering the REPLY.`,
          proto: `Deliver the id ${m.replyTo}, the status and the reply data to the application that sent DATA message ${m.replyTo}, best effort: a failing application does not affect processing. Delete DATA message ${m.replyTo} from the outbound queue. Apply the charging and slashing policy by status: SUCCESS and APPLICATION_ERROR slash no one; CONNECTOR_NOT_FOUND and CONNECTOR_UNDERFUNDED are attributable to the source connector.`,
          refs: [['processing', 'Channel state transitions §2'], ['delivery', 'Messaging §6'], ['replies', 'Messaging §7'], ['slashing', 'Stakes and bonds §2.1']], extra: `<p class="verdict is-pass">reply(${m.replyTo}) delivered, #${m.replyTo} deleted</p>`,
          verdict: 'pass', changed: [], cur: m.id,
          log: `queue: #${m.replyTo} (DATA) deleted, its REPLY delivered to the sender.`,
        });
      } else {
        dispatched.push(m.id);
        push({
          n: '13', label: `dispatch #${m.id} (CONTROL)`, title: `CONTROL message ${m.id}: apply the peer's new configuration`, where: `${WHERE}, dispatch`,
          plain: `Message ${m.id} is a ConfigUpdate from Ledger A. Its timestamp must be later than the one we hold for Ledger A, and its protocol version must be ours, or the whole bundle is rejected. It replaces our copy of Ledger A's throttles. No connector is involved, no application is called, and no REPLY is generated.`,
          proto: 'Apply as configuration propagation defines on receipt: reject the bundle on a protocol version mismatch or a timestamp that is not strictly later; otherwise replace the peer configuration timestamp and the peer throttles. A CONTROL message with no type or an unknown type also rejects the bundle. No REPLY.',
          refs: [['processing', 'Channel state transitions §2'], ['configRecv', 'Ledger configuration §5.3']], extra: '<p class="verdict is-pass">configuration applied · no REPLY</p>',
          verdict: 'pass', changed: [], cur: m.id, log: 'peer configuration updated.',
        });
      }
    }
    const prevReceived = st.received;
    if (fresh.length) { st.received = last.id; st.rhash = H.computed[H.computed.length - 1]; }
    push({
      n: '13', label: 'advance received id and hash', title: fresh.length ? 'Record what we have received' : 'No new message: counters unchanged', where: WHERE,
      plain: fresh.length
        ? `With every new message dispatched, the CLPR Service records that it has received Ledger A's messages through ${last.id}, and stores the recomputed running hash as the starting point for the next bundle.`
        : 'No message was new, so the received message id and running hash stay as they were.',
      proto: fresh.length ? `The received message id becomes the last message's id (${prevReceived} → ${last.id}); the received running hash becomes the one recomputed in the running hash step.` : 'Only done when the bundle had new messages.',
      refs: [['processing', 'Channel state transitions §2'], ['queue', 'Messaging §2']], extra: `<p class="verdict ${fresh.length ? 'is-pass' : 'is-skip'}">${fresh.length ? `received ${prevReceived} → ${last.id}` : 'unchanged'}</p>`,
      verdict: fresh.length ? 'pass' : 'skip', changed: fresh.length ? ['received', 'rhash'] : [],
      log: fresh.length ? `<span class="k">received_message_id</span> ${prevReceived} → ${last.id} · <span class="k">received_running_hash</span> → H${last.id}.` : 'Nothing changed.',
    });

    // 14 — status
    push({
      n: '14', label: 'status', title: 'Is either side closing? No', where: WHERE,
      plain: `If Ledger A's queue metadata said it is closing, our ACTIVE channel would follow into CLOSING here; a CLOSING channel with no DATA message left would become DRAINED; and a DRAINED channel would close once both sides have everything. Ledger A says ${sc.sync.status} and we are ${st.status}, so nothing changes.`,
      proto: `An ACTIVE channel whose peer reports CLOSING, DRAINED or CLOSED becomes CLOSING; a CLOSING channel with no DATA message in its outbound queue becomes DRAINED; a DRAINED channel whose peer reports DRAINED or CLOSED becomes CLOSED once the peer has acknowledged all of ours and we have received all of theirs. The checks run in order, so one bundle can apply several. Here the peer reports ${sc.sync.status}: none applies.`,
      refs: [['processing', 'Channel state transitions §2'], ['closing', 'Channel state transitions §5']], extra: '<p class="verdict is-skip">both ACTIVE → no transition</p>',
      verdict: 'skip', changed: [], log: 'Nothing changed.',
    });

    // done
    const waitingReplies = st.queue.filter((q) => q.type === 'REPLY' && !q.del).length;
    push({
      n: '✓', label: 'bundle processed', title: 'Done: the channel has moved on', where: 'after processing',
      plain: fresh.length
        ? `The bundle is fully processed. We now hold Ledger A's messages through ${st.received}, our running hash equals the proven one, Ledger A's acknowledgement is recorded, and ${waitingReplies} REPLY messages wait in our outbound queue for the next bundle going the other way. The submitter was paid the connector charges for the messages that were delivered, and the penalty for the one whose connector could not pay.`
        : 'The bundle is processed. It carried no new message; it made progress through its trust anchor change or newer manifest, which are now stored with the channel.',
      proto: `Received through ${st.received} (was ${STORED_RECEIVED}); acknowledged through ${st.acked} (was 17); next message id ${st.next} (was 21); status ${st.status}. Every REPLY was appended to our outbound queue and extends our own running hash: DATA, REPLY and CONTROL messages share one queue and one sequence of message ids. Ledger A learns all of this from the queue metadata of the next bundle we send it.`,
      refs: [['processing', 'Channel state transitions §2'], ['queue', 'Messaging §2'], ['payment', 'Channel economics §2']], extra: '<p class="verdict is-pass">bundle accepted; all state changes committed together</p>',
      verdict: 'done', changed: [], log: 'All changes are committed in one transaction. Choose a fault above and step through again to see a rejection.',
    });
    return { steps, canon };
  }

  for (const root of Array.from(document.querySelectorAll<HTMLElement>('.sim.bundleverify'))) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const links: Record<string, string> = JSON.parse(root.dataset.links || '{}');
    const card = $('[data-role="card"]'); const list = $('[data-role="list"]'); const log = $('[data-role="log"]');
    const status = $('[data-role="status"]'); const counter = $('[data-role="counter"]'); const faultPill = $('[data-role="fault"]');
    const bundleEl = $('[data-role="bundle"]'); const queueEl = $('[data-role="queue"]'); const track = $('[data-role="track"]');
    const reverted = $('[data-role="reverted"]'); const qempty = $('[data-role="qempty"]');
    const prev = $('[data-role="prev"]') as HTMLButtonElement; const next = $('[data-role="next"]') as HTMLButtonElement;
    const faultBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-fault]'));
    const opts = Array.from(root.querySelectorAll<HTMLInputElement>('input[data-opt]'));
    let sc = scenario('none', false, false);
    let H: Hashes | null = null;
    let steps: Step[] = []; let canon: { n: string; label: string }[] = [];
    let i = 0;
    let token = 0;
    let wasBad = false;
    // Rows are persistent elements keyed by message id; renders only toggle classes and marks, so
    // the CSS transitions (walk down the bundle, strike a deleted row, slide a reply in) can run.
    const bundleRows = new Map<number, HTMLElement>();
    const queueRows = new Map<number, HTMLElement>();

    function field(name: string) { return root.querySelector<HTMLElement>(`[data-f="${name}"]`)!; }
    function row(type: MType, id: number, text: string, meta: string, size?: number): HTMLElement {
      const el = document.createElement('div'); el.className = 'bv__msg';
      el.innerHTML = `<span class="pill ${PILL[type]}">${type}</span><b>#${id}</b><code>${esc(text)}</code><span class="meta">${esc(meta)}</span>${size === undefined ? '' : `<span class="meta">${size} B</span>`}<span class="marks"></span>`;
      return el;
    }
    function setMarks(el: HTMLElement, html: string) { const m = el.querySelector<HTMLElement>('.marks')!; if (m.innerHTML !== html) m.innerHTML = html; }
    function buildRows() {
      for (const el of Array.from(bundleRows.values())) el.remove();
      for (const el of Array.from(queueRows.values())) el.remove();
      bundleRows.clear(); queueRows.clear();
      for (const m of sc.msgs) { const el = row(m.type, m.id, m.text, m.meta, bytes(m.text)); bundleRows.set(m.id, el); bundleEl.appendChild(el); }
    }
    function renderBundle(step: Step) {
      const rev = !!sc.verifierReverts && step.n !== '0';
      bundleEl.classList.toggle('is-reverted', rev); reverted.hidden = !rev;
      for (const m of sc.msgs) {
        const el = bundleRows.get(m.id)!;
        const isCur = step.cur === m.id, isBad = step.bad === m.id, hit = step.dispatched.includes(m.id);
        el.classList.toggle('cur', isCur); el.classList.toggle('bad', isBad); el.classList.toggle('done', hit && !isCur);
        setMarks(el, [hit ? '<span class="pill ok">dispatched</span>' : '', isBad ? '<span class="pill bad">rejected here</span>' : ''].join(''));
      }
    }
    function renderQueue(s: State) {
      qempty.hidden = s.queue.length > 0;
      const keep = new Set<number>();
      let cursor: Element | null = qempty.nextElementSibling;
      for (const q of s.queue) {
        keep.add(q.id);
        let el = queueRows.get(q.id);
        if (!el) { el = row(q.type, q.id, q.label, q.note); queueRows.set(q.id, el); }
        if (el !== cursor) queueEl.insertBefore(el, cursor); else cursor = cursor.nextElementSibling;
        el.classList.toggle('del', !!q.del); el.classList.toggle('fresh', !!q.fresh);
        setMarks(el, [
          q.del ? `<span class="pill bad">${q.del}</span>` : '',
          !q.del && q.acked ? '<span class="pill ok">acked</span>' : '',
          !q.del && !q.acked ? '<span class="pill grey">not yet acked</span>' : '',
          !q.del && q.acked && q.type === 'DATA' ? '<span class="pill b">retained: awaiting reply</span>' : '',
          q.fresh ? '<span class="pill ok">new</span>' : '',
        ].join(''));
      }
      for (const [id, el] of Array.from(queueRows)) if (!keep.has(id)) { el.remove(); queueRows.delete(id); }
    }
    function renderState(step: Step) {
      const s = step.state;
      const vals: Record<string, string> = { status: s.status, received: String(s.received), rhash: `<code>H${s.received} = ${s.rhash}</code>`, acked: String(s.acked), next: String(s.next), anchorId: s.anchorId, manifestV: String(s.manifestV) };
      // Fields changed by an earlier step of this bundle keep a small marker; a rejection resets everything.
      const seen = new Set<string>();
      if (step.verdict !== 'reject') for (let j = 0; j <= i; j++) for (const k of steps[j].changed) seen.add(k);
      for (const k of Object.keys(vals)) {
        const el = field(k);
        if (el.innerHTML !== vals[k]) el.innerHTML = vals[k];
        const chg = step.changed.includes(k);
        if (chg) { el.className = ''; void el.offsetWidth; }
        el.className = `${chg ? 'chg' : seen.has(k) ? 'was' : ''} ${k === 'status' && s.status === 'PAUSED' ? 'bad' : ''}`.trim();
        el.title = chg ? 'changed at this step' : seen.has(k) ? 'changed earlier in this bundle' : '';
      }
      const reverted = sc.verifierReverts && step.n !== '0';
      field('sync').innerHTML = reverted ? '-' : `<code class="nw">received_message_id ${sc.sync.received}</code> · ${sc.sync.status} · <code class="nw">next_message_id ${sc.sync.next}</code>`;
      field('anchorMsg').textContent = reverted ? '-' : String(sc.anchorId);
      field('anchorHash').innerHTML = reverted ? '-' : `<code>H${sc.anchorId} = ${H!.last}</code>`;
      field('newAnchor').textContent = reverted ? '-' : sc.rotate ? 'epoch 8 (with new_trust_anchor)' : '(empty)';
      field('newManifest').textContent = reverted ? '-' : sc.manifest ? 'version 4' : '(absent)';
      field('count').textContent = reverted ? '-' : `${sc.msgs.length} (ids ${sc.msgs.map((m) => m.id).join(', ')})`;
    }
    function renderCard(step: Step) {
      const refs = step.refs.map(([k, label]) => `<a href="${links[k]}" rel="noopener">${label}</a>`).join(' · ');
      card.innerHTML = `<div class="phase">${step.where} · ${i} of ${canon.length - 1}</div><h4>${esc(step.title)}</h4><p>${step.plain}</p>${step.extra ?? ''}<p class="proto"><strong>In protocol terms.</strong> ${step.proto}</p><p class="small" style="margin:6px 0 0">Source: ${refs}</p>`;
    }
    /** The step list and the progress track are built once per scenario; render() only updates their state. */
    function buildList() {
      list.innerHTML = canon.map((c, j) => {
        const done = j < steps.length;
        return `<li data-i="${j}" class="${done ? '' : 'is-nr'}" ${done ? 'tabindex="0"' : 'title="not reached in this scenario"'}><span class="n">${c.n}</span><span>${esc(c.label)}</span><span class="ev"></span></li>`;
      }).join('');
      for (const li of Array.from(list.querySelectorAll<HTMLLIElement>('li[data-i]'))) {
        const j = Number(li.dataset.i);
        if (j >= steps.length) continue;
        li.addEventListener('click', () => go(j));
        li.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(j); } });
      }
      track.innerHTML = canon.map(() => '<i></i>').join('');
    }
    function renderList() {
      const segs = Array.from(track.children) as HTMLElement[];
      Array.from(list.querySelectorAll<HTMLLIElement>('li[data-i]')).forEach((li, j) => {
        const done = j < steps.length;
        const v = done ? steps[j].verdict : 'nr';
        const tag = !done ? 'not reached' : j > i ? '' : v === 'info' ? '' : v === 'pause' ? 'PAUSED' : v === 'done' ? 'done' : v;
        const ev = li.querySelector<HTMLElement>('.ev')!;
        ev.className = `ev is-${done ? v : 'nr'}`;
        if (ev.textContent !== tag) ev.textContent = tag;
        if (j === i) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current');
        const seg = segs[j];
        if (seg) seg.className = !done || j > i ? '' : v === 'reject' || v === 'pause' ? 'now bad' : v === 'done' ? 'done' : j === i ? 'now' : v === 'skip' ? 'skip' : 'done';
      });
      const current = list.querySelector<HTMLElement>('li[aria-current="step"]');
      if (current) scrollListTo(list, current);
    }
    function render() {
      const step = steps[i];
      renderState(step); renderBundle(step); renderQueue(step.state); renderCard(step); renderList();
      log.innerHTML = step.log;
      counter.textContent = `step ${i} of ${canon.length - 1}`;
      const s = step.state;
      let bad = false;
      if (step.verdict === 'reject') { status.textContent = `rejected at ${step.label}`; bad = true; }
      else if (s.status === 'PAUSED') { status.textContent = 'PAUSED'; bad = true; }
      else if (step.verdict === 'done') status.textContent = 'ACTIVE · bundle accepted';
      else status.textContent = s.status;
      status.className = `pill ${bad ? 'bad' : 'ok'}`;
      if (bad && !wasBad) { void status.offsetWidth; status.classList.add('pulse'); }
      wasBad = bad;
      prev.disabled = i === 0;
      next.disabled = i >= steps.length - 1;
    }
    function go(j: number) { i = Math.max(0, Math.min(steps.length - 1, j)); render(); }
    async function load(key: string) {
      const my = ++token;
      sc = scenario(key, opts[0].checked, opts[1].checked);
      const label = faultBtns.find((b) => b.dataset.fault === key)?.textContent ?? key;
      faultPill.textContent = `${key === 'none' ? 'no fault' : `fault: ${label}`}${sc.rotate ? ' + trust anchor change' : ''}${sc.manifest ? ' + manifest v4' : ''}`;
      faultPill.className = `pill ${key === 'none' ? 'grey' : 'bad'}`;
      H = await prepare(sc);
      if (my !== token) return;
      ({ steps, canon } = build(sc, H));
      buildRows(); buildList();
      i = 0; render();
    }
    status.addEventListener('animationend', () => status.classList.remove('pulse'));
    for (const b of faultBtns) b.addEventListener('click', () => { for (const x of faultBtns) x.setAttribute('aria-pressed', String(x === b)); load(b.dataset.fault!); });
    for (const o of opts) o.addEventListener('change', () => load(faultBtns.find((b) => b.getAttribute('aria-pressed') === 'true')!.dataset.fault!));
    prev.addEventListener('click', () => go(i - 1));
    next.addEventListener('click', () => go(i + 1));
    $('[data-role="reset"]').addEventListener('click', () => go(0));
    load('none');
  }
</script>
