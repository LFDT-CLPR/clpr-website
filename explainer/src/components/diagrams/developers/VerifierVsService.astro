---
/** One bundle submission: the Endpoint submits to the CLPR Service, the Service calls the channel's verifier with the bundle, the trust anchor and the context, and runs every other check and the dispatch itself; Channel state transitions §2, Verifier interface §1 and §3, Messaging §6. */
import Figure from '@kse/components/Figure.astro';
import { transitions, verifierIface, messaging, economics } from '../../../lib/sources';
---
<Figure
  lead="Two jobs, one transaction."
  caption="The Endpoint submits the bundle to the CLPR Service, which calls the channel's verifier with the bundle, the stored trust anchor and the channel context. The verifier answers one question: is this bundle the peer's proven state, for this channel, under that trust anchor? Limits, progress, replay, the running hash, acknowledgements, response ordering, status and dispatch are the service's own logic and run the same way for every proof scheme. Dispatch follows the specification's order; on EVM ledgers the charge follows the call."
  source={[{ label: 'Channel state transitions §2', href: transitions('2-bundle-processing') }, { label: 'Verifier interface §1', href: verifierIface('1-verifier-contracts-and-trust-anchors') }, { label: 'Verifier interface §3', href: verifierIface('3-verifybundle') }, { label: 'Messaging §6', href: messaging('6-delivery-to-the-application') }, { label: 'Channel economics §1', href: economics('1-execution-charges') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 488" role="img" aria-label="An endpoint submits the bundle to the CLPR Service on ledger B. The Service holds the channel state and calls the verifier beside it with the bundle, the trust anchor and the channel context; the verifier returns the bundle content or fails. The Service then runs its own logic: pre-checks, limits, progress, the manifest and trust anchor, replay, the running hash, the acknowledgement, response order and status. For each message it resolves the connector beside it, charges it, invokes the application, which only runs the message, and enqueues the REPLY. A rejected bundle changes nothing; misordered replies pause the channel.">
    <defs>
      <marker id="vvs-arrow-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--c)" /></marker>
      <marker id="vvs-arrow-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--ok)" /></marker>
      <marker id="vvs-arrow-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--b)" /></marker>
    </defs>

    <!-- arrows first, boxes over them -->
    <line x1="380" y1="68" x2="380" y2="94" class="line c" marker-end="url(#vvs-arrow-c)" />
    <line x1="554" y1="160" x2="590" y2="160" class="line b" marker-end="url(#vvs-arrow-b)" />
    <line x1="592" y1="214" x2="558" y2="226" class="line ok" marker-end="url(#vvs-arrow-ok)" />
    <line x1="570" y1="370" x2="590" y2="370" class="line b" marker-end="url(#vvs-arrow-b)" />
    <line x1="166" y1="350" x2="190" y2="350" class="line money" />

    <!-- endpoint -->
    <rect x="270" y="16" width="220" height="52" rx="8" class="d-c" />
    <text x="380" y="36" class="t b center">Endpoint</text>
    <text x="380" y="54" class="t small center">submits the bundle</text>
    <text x="390" y="86" class="t small">bundle</text>

    <!-- the CLPR Service on B -->
    <rect x="190" y="96" width="380" height="320" rx="10" class="d-b" />
    <text x="380" y="118" class="t b center">CLPR Service on B</text>

    <rect x="206" y="130" width="348" height="58" rx="8" class="d-grey" />
    <text x="380" y="148" class="t b small center">Channel state</text>
    <text x="380" y="164" class="t small center">received id · acknowledged id · running hash</text>
    <text x="380" y="178" class="t small center">trust anchor · context · peer manifest</text>

    <rect x="206" y="200" width="348" height="58" rx="8" class="d-surface" />
    <text x="380" y="218" class="t b small center">Bundle content, as returned</text>
    <text x="380" y="234" class="t small center">queue metadata · messages · last id, its hash</text>
    <text x="380" y="248" class="t small center">new trust anchor · endpoint manifest</text>

    <text x="380" y="280" class="t small center muted">then its own logic:</text>
    <text x="380" y="298" class="t small center">pre-checks · limits · progress</text>
    <text x="380" y="312" class="t small center">manifest, trust anchor · replay</text>
    <text x="380" y="326" class="t small center">running hash · acknowledgement</text>
    <text x="380" y="340" class="t small center">response order · status</text>
    <text x="380" y="360" class="t small center">dispatch, per message: resolve</text>
    <text x="380" y="374" class="t small center">the connector, charge it, invoke</text>
    <text x="380" y="388" class="t small center">the application, enqueue the REPLY</text>

    <!-- the verifier, called by the Service -->
    <rect x="592" y="130" width="152" height="110" rx="8" class="d-ok" />
    <text x="668" y="152" class="t b center">Verifier</text>
    <text x="668" y="172" class="t small center">gets the bundle,</text>
    <text x="668" y="186" class="t small center">trust anchor and</text>
    <text x="668" y="200" class="t small center">context; returns</text>
    <text x="668" y="214" class="t small center">the content or fails</text>

    <!-- the application, only invoked -->
    <rect x="592" y="336" width="152" height="70" rx="8" class="d-surface" />
    <text x="668" y="358" class="t b center">Application on B</text>
    <text x="668" y="376" class="t small center">invoked with</text>
    <text x="668" y="390" class="t small center">the message</text>

    <!-- the connector, beside the Service -->
    <rect x="16" y="310" width="150" height="80" rx="8" class="d-money" />
    <text x="91" y="332" class="t b center">Connector on B</text>
    <text x="91" y="350" class="t small center">resolved by its id;</text>
    <text x="91" y="364" class="t small center">pays for execution</text>

    <!-- what a rejection does -->
    <text x="24" y="150" class="t small muted">a rejected bundle</text>
    <text x="24" y="164" class="t small muted">changes nothing;</text>
    <text x="24" y="178" class="t small muted">misordered replies</text>
    <text x="24" y="192" class="t small muted">pause the channel</text>

    <text x="380" y="462" class="t take center">The service's checks catch verifier bugs.</text>
    <text x="380" y="476" class="t take center">They do not catch a compromised verifier, which can return fabricated bundle content.</text>
  </svg>
</Figure>
