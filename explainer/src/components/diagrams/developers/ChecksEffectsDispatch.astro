---
/** The order the specification recommends when the service hands control to arbitrary code: state-changing entry points carry a reentrancy guard, and the Service completes its own state changes, including debiting charges, before an external call. Draws on CLPR Service §6.4 (a Recommendation), Messaging §6 and Channel economics §1. */
import Figure from '@kse/components/Figure.astro';
import { messaging, service, economics } from '../../../lib/sources';
---
<Figure
  lead="Checks, effects, then the application."
  caption="The specification recommends a reentrancy guard on every state-changing entry point, and that the Service completes its own state changes, including debiting charges, before control passes to the target application. On EVM ledgers the execution charge is collected after the call, from the gas it used."
  source={[{ label: 'CLPR Service §6.4', href: service('64-reentrancy-and-external-calls') }, { label: 'Messaging §6', href: messaging('6-delivery-to-the-application') }, { label: 'Channel economics §1', href: economics('1-execution-charges') }]}
  kind="spec"
  minWidth={720}
>
  <svg viewBox="0 0 720 334" role="img" aria-label="Three boxes. On the left, the CLPR Service processing message i of a bundle submission, with a reentrancy guard held on its state-changing entry points. Step 1, a green arrow to a box at the top right: checks, then the Service's own state changes, including debiting charges, the recommended order. Step 2, an arrow to the target application at the bottom right: dispatch to the application. Step 3, a dashed red arrow curving from the application back to the service: a re-entrant call meets completed state, and the guard.">
    <defs>
      <marker id="ced-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="ced-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="ced-arrow-bad" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--bad)"/></marker>
    </defs>

    <!-- the service, left -->
    <rect x="20" y="78" width="204" height="140" rx="10" class="d-a"/>
    <text x="32" y="100" class="t b">CLPR Service</text>
    <text x="32" y="118" class="t small">the bundle submission</text>
    <text x="32" y="135" class="t small">processing message i</text>
    <text x="32" y="160" class="t small">state-changing entry points</text>
    <text x="32" y="176" class="t small">carry a reentrancy guard</text>
    <rect x="32" y="188" width="120" height="20" rx="10" class="d-grey"/>
    <text x="92" y="202" class="t mono center">guard held</text>

    <!-- 1: checks, then all effects -->
    <line x1="224" y1="98" x2="422" y2="62" class="line ok" marker-end="url(#ced-arrow-ok)"/>
    <circle cx="246" cy="112" r="9" class="d-grey"/><text x="246" y="116" class="t small center b">1</text>
    <text x="262" y="116" class="t small ok">checks, then its own effects</text>

    <rect x="424" y="24" width="280" height="94" rx="8" class="d-ok"/>
    <text x="436" y="44" class="t b">Service state, completed first</text>
    <text x="436" y="62" class="t small">its own state changes</text>
    <text x="436" y="78" class="t small">for message i,</text>
    <text x="436" y="94" class="t small">including debiting charges</text>
    <text x="436" y="110" class="t small muted">the recommended order</text>

    <!-- 2: interaction -->
    <line x1="224" y1="176" x2="422" y2="194" class="line a" marker-end="url(#ced-arrow-a)"/>
    <circle cx="246" cy="158" r="9" class="d-grey"/><text x="246" y="162" class="t small center b">2</text>
    <text x="262" y="162" class="t small a">calls the application</text>

    <rect x="424" y="150" width="280" height="90" rx="8" class="d-surface"/>
    <text x="436" y="170" class="t b">Target application</text>
    <text x="436" y="188" class="t small">arbitrary code; it may call back</text>
    <text x="436" y="204" class="t small">into the service</text>

    <!-- 3: a re-entrant call -->
    <path d="M430,240 C360,282 230,282 172,222" class="line bad dash" marker-end="url(#ced-arrow-bad)"/>
    <circle cx="262" cy="296" r="9" class="d-grey"/><text x="262" y="300" class="t small center b">3</text>
    <text x="278" y="300" class="t small bad">a re-entrant call meets completed state, and the guard</text>

    <!-- takeaway -->
    <text x="360" y="324" class="t take center">Recommended: the Service settles its own state before your callback runs.</text>
  </svg>
</Figure>
