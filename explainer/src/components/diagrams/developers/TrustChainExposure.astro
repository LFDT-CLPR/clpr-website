---
/** The roles of Overview §5 as a chain of vetting, with each role's economic part, and the two infrastructure roles that sit outside it. */
import Figure from '@kse/components/Figure.astro';
import { overview } from '../../../lib/sources';
---
<Figure
  lead="Who checks whom."
  caption="Each role vets those it depends on, in proportion to the value it puts at risk. The verifier developer, whose code every channel depends on, has no economic part in the protocol; the endpoint operator, who pays transaction fees and earns the margin on executed messages, and the administrator sit outside the chain. Endpoints are not slashed."
  source={[{ label: 'Overview §5', href: overview('5-roles') }, { label: 'Overview §4', href: overview('4-trust-model') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 382" role="img" aria-label="A chain of vetting: the end user vets the application, whose developer vets the channel and connector, whose operator vets the channel and its verifier, which is built by the verifier developer for a proof scheme of the source ledger. Each box notes the role's economic part: application-level risk for the end user; paying connectors for the application developer; funding execution and a slashable stake for the connector operator; none in the protocol for the verifier developer. Outside the chain sit the endpoint operator, who serves every channel and fronts the fees, and the CLPR Service administrator, who configures the Service, admits endpoints and closes channels, with no economic part.">
    <defs>
      <marker id="tce-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--text-3)" /></marker>
    </defs>

    <!-- the chain -->
    <rect x="20" y="16" width="172" height="52" rx="8" class="d-grey" />
    <text x="106" y="38" class="t b center">End user</text>
    <text x="106" y="56" class="t small center">application-level risk</text>

    <path d="M106,68 L154,94" class="line" marker-end="url(#tce-arrow)" />
    <text x="162" y="85" class="t small muted">vets</text>

    <rect x="130" y="94" width="190" height="52" rx="8" class="d-a" />
    <text x="225" y="116" class="t b center">Application developer</text>
    <text x="225" y="134" class="t small center">pays connectors</text>

    <path d="M225,146 L260,172" class="line" marker-end="url(#tce-arrow)" />
    <text x="268" y="163" class="t small muted">vets</text>

    <rect x="236" y="172" width="220" height="52" rx="8" class="d-money" />
    <text x="346" y="194" class="t b center">Connector operator</text>
    <text x="346" y="212" class="t small center">funds execution; slashable stake</text>

    <path d="M346,224 L384,250" class="line" marker-end="url(#tce-arrow)" />
    <text x="392" y="241" class="t small muted">vets</text>

    <rect x="360" y="250" width="190" height="52" rx="8" class="d-ok" />
    <text x="455" y="272" class="t b center">Channel (verifier)</text>
    <text x="455" y="290" class="t small center">verifier code, peer legitimacy</text>

    <path d="M550,276 L620,226" class="line" marker-end="url(#tce-arrow)" />
    <text x="566" y="292" class="t small muted">built by</text>

    <rect x="576" y="172" width="174" height="52" rx="8" class="d-surface" />
    <text x="663" y="194" class="t b center">Verifier developer</text>
    <text x="663" y="212" class="t small center">none in the protocol</text>

    <path d="M663,172 L663,126" class="line" marker-end="url(#tce-arrow)" />
    <text x="671" y="152" class="t small muted">implements</text>

    <rect x="576" y="72" width="174" height="52" rx="8" class="d-grey" />
    <text x="663" y="94" class="t b center">Source ledger</text>
    <text x="663" y="112" class="t small center">one of its proof schemes</text>

    <!-- outside the chain -->
    <rect x="10" y="234" width="326" height="96" rx="12" class="line dash" />
    <text x="20" y="248" class="t small muted">outside the chain</text>

    <rect x="18" y="256" width="144" height="66" rx="8" class="d-c" />
    <text x="90" y="278" class="t b center">Endpoint operator</text>
    <text x="90" y="296" class="t small center">serves every channel;</text>
    <text x="90" y="310" class="t small center">fronts the fees</text>

    <rect x="174" y="256" width="154" height="66" rx="8" class="d-grey" />
    <text x="251" y="278" class="t b center">Administrator</text>
    <text x="251" y="296" class="t small center">configures, admits,</text>
    <text x="251" y="310" class="t small center">closes channels</text>

    <text x="380" y="352" class="t take center">Each role vets what it depends on, in proportion to the value it puts at risk.</text>
    <text x="380" y="368" class="t take center">The verifier developer has no economic part; the administrator has power but no economic part.</text>
  </svg>
</Figure>
