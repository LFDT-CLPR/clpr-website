---
/** What the specification consists of: the non-normative overview, then the three categories of normative text (the Protocol modules, the Ledger Specifications and the Recommendations), the open issues list, and CLIPs as the way the Protocol changes. Drawn from the clpr-spec README.md, clpr-overview.md §6 and clips/clip-0001.md §3 and §6. */
import Figure from '@kse/components/Figure.astro';
import { pinned, overview, openIssues } from '../../../lib/sources';
---
<Figure
  lead="The document set."
  caption="The overview introduces the parts and the vocabulary. The Protocol modules are required of every implementation, the Ledger Specifications of anyone interoperating with that ledger, and the Recommendations are advised for a deployment, which may differ from them. The open issues list known questions; CLIPs are how the Protocol changes."
  source={[
    { label: 'README.md', href: pinned('clpr-spec', 'README.md') },
    { label: 'Overview §6', href: overview('6-how-the-specification-is-organized') },
    { label: 'CLIP-0001', href: pinned('clpr-spec', 'clips/clip-0001.md') },
    { label: 'Ledger Specifications', href: pinned('clpr-spec', 'ledgers/README.md') },
    { label: 'Open issues', href: openIssues() },
  ]}
  kind="plain"
  minWidth={760}
>
  <svg viewBox="0 0 760 316" role="img" aria-label="At the top, the overview, non-normative: parts, message flow, trust model, roles and vocabulary. Below it three categories side by side. The Protocol, required of every implementation, with its modules: conventions, ledger configuration, endpoint manifest, channel setup, connector setup, messaging, bundle, verifier interface, channel state transitions, endpoint sync and schema. The Ledger Specifications, required for one ledger: its ledger specification, verifier API, bundle aggregation and proof schemes; the verifier API is shared within a family. The Recommendations, advised for a deployment, which may differ: CLPR Service, stakes and bonds, channel economics. Under the Protocol, CLIPs, the CLPR Improvement Proposals, with an arrow into the Protocol: they are how it changes. Beside them, the open issues: known open design questions, non-normative.">
    <defs>
      <marker id="sdm-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--text-3)"/></marker>
      <marker id="sdm-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
    </defs>

    <!-- the overview, read first -->
    <line x1="260" y1="70" x2="160" y2="90" class="line dash" marker-end="url(#sdm-arrow)"/>
    <line x1="380" y1="70" x2="380" y2="90" class="line dash" marker-end="url(#sdm-arrow)"/>
    <line x1="500" y1="70" x2="600" y2="90" class="line dash" marker-end="url(#sdm-arrow)"/>
    <rect x="190" y="14" width="380" height="56" rx="10" class="d-surface"/>
    <text x="380" y="36" class="t b center">Overview (non-normative)</text>
    <text x="380" y="54" class="t small center">parts, message flow, trust model, roles, vocabulary</text>

    <!-- Protocol -->
    <rect x="20" y="92" width="250" height="134" rx="10" class="d-ok"/>
    <text x="145" y="112" class="t b center">Protocol</text>
    <text x="145" y="128" class="t small center muted">MUST: every implementation</text>
    <text x="145" y="146" class="t small center">conventions · ledger configuration</text>
    <text x="145" y="160" class="t small center">endpoint manifest · channel setup</text>
    <text x="145" y="174" class="t small center">connector setup · messaging</text>
    <text x="145" y="188" class="t small center">bundle · verifier interface</text>
    <text x="145" y="202" class="t small center">channel state transitions</text>
    <text x="145" y="216" class="t small center">endpoint sync · schema</text>

    <!-- Ledger Specifications -->
    <rect x="285" y="92" width="190" height="134" rx="10" class="d-a"/>
    <text x="380" y="112" class="t b center">Ledger Specifications</text>
    <text x="380" y="128" class="t small center muted">MUST for one ledger</text>
    <text x="380" y="146" class="t small center">ledger specification</text>
    <text x="380" y="160" class="t small center">verifier API</text>
    <text x="380" y="174" class="t small center">bundle aggregation</text>
    <text x="380" y="188" class="t small center">proof schemes</text>
    <text x="380" y="202" class="t small center">verifier API shared</text>
    <text x="380" y="216" class="t small center">within a family</text>

    <!-- Recommendations -->
    <rect x="490" y="92" width="250" height="134" rx="10" class="d-b"/>
    <text x="615" y="112" class="t b center">Recommendations</text>
    <text x="615" y="128" class="t small center muted">SHOULD: a deployment may differ</text>
    <text x="615" y="146" class="t small center">CLPR Service</text>
    <text x="615" y="160" class="t small center">stakes and bonds</text>
    <text x="615" y="174" class="t small center">channel economics</text>

    <!-- CLIPs change the Protocol -->
    <line x1="145" y1="240" x2="145" y2="229" class="line ok" marker-end="url(#sdm-arrow-ok)"/>
    <rect x="20" y="240" width="250" height="44" rx="8" class="d-grey"/>
    <text x="145" y="258" class="t b center">CLIPs</text>
    <text x="145" y="275" class="t small center">proposals: how the Protocol changes</text>

    <!-- open issues -->
    <rect x="285" y="240" width="455" height="44" rx="8" class="d-grey"/>
    <text x="512" y="258" class="t b center">Open issues</text>
    <text x="512" y="275" class="t small center">known open design questions; non-normative</text>

    <!-- takeaway -->
    <text x="380" y="306" class="t take center">Three strengths: MUST everywhere, MUST for one ledger, SHOULD. CLIPs change the Protocol.</text>
  </svg>
</Figure>
