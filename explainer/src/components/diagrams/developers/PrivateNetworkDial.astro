---
/** A manifest entry without an address can only initiate: a private network's endpoints dial out and are never dialled, while the bidirectional stream still serves both sides' requests in one cycle. Draws on Endpoint manifest §1 and §6, Endpoint sync §2 and §3, and CLPR Service §6.8. */
import Figure from '@kse/components/Figure.astro';
import { endpointSync, manifest, service } from '../../../lib/sources';
---
<Figure
  lead="Dial out, never in."
  caption="Leaving the address out of a manifest entry means nobody can call that endpoint; it opens every sync itself. The stream is bidirectional, so the public side still gets its own request answered in the same cycle."
  source={[{ label: 'Endpoint manifest §1', href: manifest('1-endpoint') }, { label: 'Endpoint sync §3.3', href: endpointSync('33-sequence') }, { label: 'Endpoint manifest §6', href: manifest('6-endpoint-discovery') }, { label: 'CLPR Service §6.8', href: service('68-transport-and-sync-hygiene') }]}
  kind="spec"
  minWidth={720}
>
  <svg viewBox="0 0 720 376" role="img" aria-label="A private ledger on the left whose manifest entry has no address, and its endpoint, which is initiator only. A public ledger on the right whose manifest entry has an address and port and a certificate, and its endpoint, which can be dialled. Between them: the private endpoint opens the stream and sends its request; a dashed crossed-out arrow shows the public endpoint cannot dial back because there is no address; the public endpoint answers on the same stream with a bundle plus its own request; the private endpoint answers that request with a bundle.">
    <defs>
      <marker id="pnd-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
      <marker id="pnd-arrow-bad" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--bad)"/></marker>
    </defs>

    <!-- Private ledger (left) -->
    <rect x="20" y="36" width="230" height="278" rx="12" class="d-a"/>
    <text x="34" y="58" class="t b">Private ledger</text>
    <text x="34" y="74" class="t small muted">its manifest entry:</text>
    <rect x="34" y="84" width="202" height="66" rx="8" class="d-surface"/>
    <text x="46" y="104" class="t b small">Endpoint entry</text>
    <text x="46" y="122" class="t small">no address</text>
    <text x="46" y="138" class="t small muted">only initiates</text>
    <rect x="34" y="160" width="202" height="140" rx="8" class="d-c"/>
    <text x="46" y="182" class="t b">Private endpoint</text>
    <text x="46" y="200" class="t small">initiator only</text>
    <text x="46" y="216" class="t small">no inbound port</text>
    <text x="46" y="232" class="t small">opens every stream itself</text>
    <text x="46" y="256" class="t small muted">the only side of this pair</text>
    <text x="46" y="272" class="t small muted">that can initiate</text>

    <!-- Public ledger (right) -->
    <rect x="470" y="36" width="230" height="278" rx="12" class="d-b"/>
    <text x="484" y="58" class="t b">Public ledger</text>
    <text x="484" y="74" class="t small muted">its manifest entry:</text>
    <rect x="484" y="84" width="202" height="66" rx="8" class="d-surface"/>
    <text x="496" y="104" class="t b small">Endpoint entry</text>
    <text x="496" y="122" class="t small">address and port</text>
    <text x="496" y="138" class="t small">certificate</text>
    <rect x="484" y="160" width="202" height="140" rx="8" class="d-c"/>
    <text x="496" y="182" class="t b">Public endpoint</text>
    <text x="496" y="200" class="t small">address published</text>
    <text x="496" y="216" class="t small">can be dialled</text>
    <text x="496" y="232" class="t small">responder in this cycle</text>
    <text x="496" y="256" class="t small muted">still sends its own</text>
    <text x="496" y="272" class="t small muted">request, and is answered</text>

    <!-- 1: the private endpoint opens the stream -->
    <text x="360" y="166" class="t small center">opens the stream,</text>
    <text x="360" y="180" class="t small center">sends its request</text>
    <line x1="238" y1="186" x2="482" y2="186" class="line c" marker-end="url(#pnd-arrow-c)"/>
    <circle cx="262" cy="186" r="9" class="d-grey"/>
    <text x="262" y="190" class="t small center b">1</text>

    <!-- The public side cannot dial back -->
    <line x1="482" y1="218" x2="238" y2="218" class="line bad dash" marker-end="url(#pnd-arrow-bad)"/>
    <circle cx="360" cy="218" r="10" class="d-surface"/>
    <text x="360" y="222" class="t b center bad">✕</text>
    <text x="360" y="238" class="t small center bad">no address to dial</text>

    <!-- 2: the public endpoint answers on the same stream -->
    <line x1="482" y1="250" x2="238" y2="250" class="line c" marker-end="url(#pnd-arrow-c)"/>
    <circle cx="458" cy="250" r="9" class="d-grey"/>
    <text x="458" y="254" class="t small center b">2</text>
    <text x="360" y="266" class="t small center">a bundle and its own request</text>

    <!-- 3: the private endpoint answers that request -->
    <line x1="238" y1="282" x2="482" y2="282" class="line c" marker-end="url(#pnd-arrow-c)"/>
    <circle cx="262" cy="282" r="9" class="d-grey"/>
    <text x="262" y="286" class="t small center b">3</text>
    <text x="360" y="298" class="t small center">answers with a bundle</text>

    <!-- The stream itself -->
    <text x="360" y="336" class="t small center muted">a new stream each cycle, for one channel; the connection may persist across cycles</text>

    <!-- takeaway -->
    <text x="360" y="360" class="t take center">No inbound port, same protocol: on one stream both sides still ask and both sides still deliver.</text>
  </svg>
</Figure>
