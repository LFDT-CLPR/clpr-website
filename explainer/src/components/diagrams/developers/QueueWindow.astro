---
/** One outbound queue holding DATA, REPLY and CONTROL entries under a single id sequence and one running hash chain, with the acknowledged id marking what may be deleted and the next message id marking where the next message is appended. Draws on Messaging §2, §4, §5 and §9, and CLPR Service §1. */
import Figure from '@kse/components/Figure.astro';
import { messaging, service } from '../../../lib/sources';
---
<Figure
  lead="One queue per direction, nothing sorted by kind."
  caption="DATA, REPLY and CONTROL messages share the same ids and the same running hash chain. The acknowledged id marks what the peer has proven it received: acknowledged REPLY and CONTROL messages are deleted, and a DATA message is kept until its REPLY arrives. The next message id is where the next message is appended. Message ids are illustrative."
  source={[{ label: 'Messaging §2', href: messaging('2-message-identifiers-and-queue') }, { label: 'Messaging §4', href: messaging('4-running-hash') }, { label: 'Messaging §9', href: messaging('9-acknowledgement') }, { label: 'CLPR Service §1', href: service('1-structure-and-internal-state') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 374" role="img" aria-label="A row of six queue slots: msg 40 (DATA, answered and deleted), msg 41 (DATA), msg 42 (REPLY answering inbound 37), msg 43 (CONTROL, a configuration update), msg 44 (DATA) and an empty slot 45. Above the slots a running hash chain H40 to H44 ends in the sent running hash; each running hash is computed from the previous one and the next message. Below, the acknowledged id 41 points at slot 41: acknowledged REPLY and CONTROL entries are deleted and DATA entries wait for their REPLY; the next message id 45 points at the empty slot where the next message is appended. A note at the bottom says the queue is keyed by channel id and message id.">
    <defs>
      <marker id="qw-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--text-3)"/></marker>
      <marker id="qw-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
    </defs>

    <!-- The running hash chain -->
    <text x="380" y="28" class="t small center ok">each running hash is computed from the previous one and the next message</text>
    <text x="75" y="56" class="t mono center muted">H40</text>
    <line x1="91" y1="52" x2="181" y2="52" class="line ok" marker-end="url(#qw-arrow-ok)"/>
    <text x="197" y="56" class="t mono center ok">H41</text>
    <line x1="213" y1="52" x2="303" y2="52" class="line ok" marker-end="url(#qw-arrow-ok)"/>
    <text x="319" y="56" class="t mono center ok">H42</text>
    <line x1="335" y1="52" x2="425" y2="52" class="line ok" marker-end="url(#qw-arrow-ok)"/>
    <text x="441" y="56" class="t mono center ok">H43</text>
    <line x1="457" y1="52" x2="547" y2="52" class="line ok" marker-end="url(#qw-arrow-ok)"/>
    <text x="563" y="56" class="t mono center ok">H44</text>
    <line x1="579" y1="52" x2="618" y2="52" class="line ok" marker-end="url(#qw-arrow-ok)"/>
    <text x="626" y="56" class="t small ok">sent running hash</text>

    <!-- The queue, oldest on the left -->
    <rect x="20" y="80" width="110" height="80" rx="8" class="d-grey"/>
    <text x="30" y="102" class="t b muted">msg 40</text>
    <text x="30" y="120" class="t mono muted">DATA</text>
    <text x="30" y="136" class="t small muted">answered,</text>
    <text x="30" y="150" class="t small muted">deleted</text>

    <rect x="142" y="80" width="110" height="80" rx="8" class="d-surface"/>
    <text x="152" y="102" class="t b">msg 41</text>
    <text x="152" y="120" class="t mono">DATA</text>
    <text x="152" y="136" class="t small">acknowledged,</text>
    <text x="152" y="150" class="t small">no REPLY yet</text>

    <rect x="264" y="80" width="110" height="80" rx="8" class="d-surface"/>
    <text x="274" y="102" class="t b">msg 42</text>
    <text x="274" y="120" class="t mono">REPLY</text>
    <text x="274" y="136" class="t small">answers</text>
    <text x="274" y="150" class="t small">inbound 37</text>

    <rect x="386" y="80" width="110" height="80" rx="8" class="d-surface"/>
    <text x="396" y="102" class="t b">msg 43</text>
    <text x="396" y="120" class="t mono">CONTROL</text>
    <text x="396" y="136" class="t small">configuration</text>
    <text x="396" y="150" class="t small">update</text>

    <rect x="508" y="80" width="110" height="80" rx="8" class="d-surface"/>
    <text x="518" y="102" class="t b">msg 44</text>
    <text x="518" y="120" class="t mono">DATA</text>
    <text x="518" y="136" class="t small">application</text>
    <text x="518" y="150" class="t small">data</text>

    <rect x="630" y="80" width="110" height="80" rx="8" class="d-surface" stroke-dasharray="5 4"/>
    <text x="640" y="102" class="t b muted">slot 45</text>
    <text x="640" y="120" class="t small muted">empty</text>
    <text x="640" y="136" class="t small muted">next write</text>

    <!-- Two counters -->
    <line x1="197" y1="196" x2="197" y2="164" class="line ok" marker-end="url(#qw-arrow-ok)"/>
    <rect x="20" y="196" width="300" height="80" rx="8" class="d-ok"/>
    <text x="32" y="216" class="t b">acknowledged: 41</text>
    <text x="32" y="234" class="t small">the peer has proven it received up to here;</text>
    <text x="32" y="250" class="t small">REPLY and CONTROL up to here are deleted,</text>
    <text x="32" y="266" class="t small">DATA waits for its REPLY</text>

    <text x="380" y="222" class="t mono center">42 … 44</text>
    <text x="380" y="238" class="t small center muted">unacknowledged,</text>
    <text x="380" y="252" class="t small center muted">still in the queue</text>

    <line x1="685" y1="196" x2="685" y2="164" class="line" marker-end="url(#qw-arrow)"/>
    <rect x="440" y="196" width="300" height="80" rx="8" class="d-grey"/>
    <text x="452" y="216" class="t b">next message id: 45</text>
    <text x="452" y="234" class="t small">the next message, of any type, goes here;</text>
    <text x="452" y="250" class="t small">then the counter increases by one</text>

    <!-- Storage -->
    <rect x="20" y="288" width="720" height="48" rx="8" class="d-grey"/>
    <text x="32" y="308" class="t b">storage</text>
    <text x="120" y="308" class="t small">keyed by channel id and message id · entries deleted as acknowledgement allows</text>

    <!-- takeaway -->
    <text x="380" y="358" class="t take center">Three message types, one id sequence, one hash chain: nothing is sorted by type.</text>
  </svg>
</Figure>
