---
/** An endpoint's loop with the dry run drawn in: watch the home outbound queue, build the bundle and its proof, sync with a peer (TLS when the peer's manifest entry has a certificate, plaintext otherwise; one stream per cycle, for one channel), check what arrives with a read-only preview, submit only what would pass. From Endpoint sync §1 to §3 and CLPR Service §5.2 (a Recommendation). */
import Figure from '@kse/components/Figure.astro';
import { endpointSync, service, pinned } from '../../../lib/sources';
---
<Figure
  lead="The endpoint's loop."
  caption="Watch the outbound queue, build the bundle and its proof, sync with a peer, dry-run what arrives, submit only what would pass. A rejected bundle still costs its submitter the transaction fee, so the specification recommends this check before submitting; it spares the honest endpoint the fee for bundles it can already tell would fail. As specified, sync runs over TLS when the peer's manifest entry has a certificate; the reference endpoint serves plaintext."
  source={[{ label: 'Endpoint sync §1', href: endpointSync('1-purpose-and-roles') }, { label: 'Endpoint sync §2', href: endpointSync('2-transport') }, { label: 'Endpoint sync §3', href: endpointSync('3-exchange') }, { label: 'CLPR Service §5.2', href: service('52-checks-before-submitting') }, { label: 'endpoint docs/sync-protocol.md', href: pinned('clpr-endpoint', 'docs/sync-protocol.md') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 332" role="img" aria-label="An endpoint reads its home ledger's outbound queue and the peer's endpoint manifest, talks to a peer endpoint, each sync one stream for one channel, where each side says how far it got, and receives the missing messages plus the proof. What arrives goes into a dry run, a read-only preview of the submission. Bundles that pass are submitted to the home ledger as an ordinary transaction; bundles that would be rejected are dropped with nothing paid. The peer endpoint does the same five things with its own ledger on the right.">
    <defs>
      <marker id="cl-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="cl-arrow-b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--b)"/></marker>
      <marker id="cl-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
      <marker id="cl-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
    </defs>

    <text x="424" y="22" class="t small center muted">one stream per cycle, for one channel; each side says how far it got</text>

    <!-- Home ledger -->
    <rect x="16" y="64" width="160" height="100" rx="12" class="d-a" />
    <text x="96" y="90" class="t b center">Home ledger</text>
    <text x="96" y="110" class="t small center">outbound queue, and the</text>
    <text x="96" y="126" class="t small center">peer's endpoint manifest</text>

    <!-- Endpoint -->
    <rect x="222" y="34" width="180" height="130" rx="12" class="d-c" />
    <text x="312" y="58" class="t b center">Endpoint</text>
    <text x="312" y="80" class="t small center">1 watch the outbound queue</text>
    <text x="312" y="96" class="t small center">2 build bundle and proof</text>
    <text x="312" y="112" class="t small center">3 sync with a peer</text>
    <text x="312" y="128" class="t small center">4 dry-run what arrives</text>
    <text x="312" y="144" class="t small center">5 submit the good ones</text>

    <!-- Peer endpoint -->
    <rect x="446" y="34" width="136" height="130" rx="12" class="d-c" />
    <text x="514" y="58" class="t b center">Peer endpoint</text>
    <text x="514" y="94" class="t small center">the same five things,</text>
    <text x="514" y="110" class="t small center">from the other side</text>

    <!-- Peer ledger -->
    <rect x="672" y="64" width="72" height="100" rx="12" class="d-b" />
    <text x="708" y="108" class="t b center">Peer</text>
    <text x="708" y="126" class="t small center">ledger</text>

    <!-- Home ledger -> endpoint -->
    <line x1="176" y1="100" x2="220" y2="100" class="line a" marker-end="url(#cl-arrow-a)" />
    <text x="199" y="92" class="t small center muted">read</text>

    <!-- Endpoint <-> peer endpoint -->
    <line x1="402" y1="84" x2="444" y2="84" class="line c" marker-end="url(#cl-arrow-c)" />
    <line x1="444" y1="120" x2="404" y2="120" class="line c" marker-end="url(#cl-arrow-c)" />
    <text x="432" y="180" class="t small center muted">the missing messages, plus the proof</text>

    <!-- Peer endpoint -> peer ledger -->
    <line x1="582" y1="100" x2="670" y2="100" class="line b" marker-end="url(#cl-arrow-b)" />
    <text x="627" y="92" class="t small center muted">read · submit</text>

    <!-- Dry run -->
    <line x1="312" y1="164" x2="312" y2="212" class="line c" marker-end="url(#cl-arrow-c)" />
    <text x="304" y="194" class="t small muted end">what arrived</text>
    <rect x="222" y="214" width="180" height="70" rx="8" class="d-ok" />
    <text x="312" y="236" class="t b center">dry run</text>
    <text x="312" y="254" class="t small center">a read-only preview,</text>
    <text x="312" y="270" class="t small center">run before any fee</text>

    <!-- Passed: submit as an ordinary transaction -->
    <path d="M222,258 L80,258 L80,166" class="line ok" marker-end="url(#cl-arrow-ok)" />
    <text x="151" y="234" class="t small center ok">submit as an</text>
    <text x="151" y="248" class="t small center ok">ordinary transaction</text>

    <!-- Would be rejected: dropped -->
    <line x1="402" y1="258" x2="458" y2="258" class="line bad dash" />
    <line x1="460" y1="252" x2="472" y2="264" class="line bad" />
    <line x1="460" y1="264" x2="472" y2="252" class="line bad" />
    <text x="482" y="254" class="t small bad">would be rejected:</text>
    <text x="482" y="268" class="t small bad">dropped, nothing paid</text>

    <!-- takeaway -->
    <text x="380" y="320" class="t take center">With a correct verifier an endpoint can delay, not forge; the dry run spares the honest one the fee.</text>
  </svg>
</Figure>
