---
/** Why the chain id alone cannot name a peer: two CLPR Service contracts on one ledger both claim eip155:1, so a peer CLPR Service is identified by the pair (chain id, service address). Draws on Ledger configuration §1 and §2 and Channel setup §3. */
import Figure from '@kse/components/Figure.astro';
import { ledgerConfig, channelSetup } from '../../../lib/sources';
---
<Figure
  lead="Two services, one chain id."
  caption="Nothing stops two CLPR Service contracts on the same ledger from both claiming eip155:1, so a peer is identified by chain id and service address together. The chain id is self-asserted and private networks may assign their own; trust in a peer comes from the channel's verifier and trust anchor, not from the chain id."
  source={[{ label: 'Ledger configuration §1', href: ledgerConfig('1-ledger-identity') }, { label: 'Ledger configuration §2', href: ledgerConfig('2-ledger-configuration') }, { label: 'Channel setup §3', href: channelSetup('3-channel-context') }]}
  kind="spec"
  minWidth={740}
>
  <svg viewBox="0 0 740 340" role="img" aria-label="Ledger A on the left holds a Channel whose peer chain id is eip155:1 and whose peer service address is that of service 1. On the right, a dashed frame labelled eip155:1 contains two CLPR Service contracts, service 1 and service 2, each with its own service address, both publishing the same chain id. A solid arrow from the channel reaches service 1, labelled peer = (eip155:1, service 1); a dashed crossed-out arrow towards service 2 says the chain id alone cannot tell them apart. Below, a private network assigns its own chain id, which, like every chain id, is self-asserted.">
    <defs>
      <marker id="cpi-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="cpi-arrow-bad" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--bad)"/></marker>
    </defs>

    <!-- Ledger A (left): the channel that names its peer -->
    <rect x="20" y="36" width="270" height="184" rx="12" class="d-a"/>
    <text x="36" y="58" class="t b">Ledger A</text>
    <text x="36" y="74" class="t small muted">local ledger: holds the channel</text>
    <rect x="36" y="96" width="238" height="108" rx="8" class="d-surface"/>
    <text x="48" y="118" class="t b">Channel</text>
    <text x="48" y="138" class="t small">peer chain id: eip155:1</text>
    <text x="48" y="156" class="t small">peer service address: service 1</text>
    <text x="48" y="176" class="t small muted">names its peer by both</text>

    <!-- One ledger, two services (right, dashed frame) -->
    <rect x="430" y="36" width="290" height="184" rx="12" class="d-b" stroke-dasharray="6 4"/>
    <text x="446" y="58" class="t b b-col">eip155:1</text>
    <text x="446" y="74" class="t small muted">one CAIP-2 id, one ledger</text>
    <rect x="446" y="88" width="258" height="58" rx="8" class="d-b"/>
    <text x="458" y="108" class="t b">CLPR Service 1</text>
    <text x="458" y="126" class="t small">its own service address</text>
    <text x="458" y="140" class="t small">publishes chain id eip155:1</text>
    <rect x="446" y="156" width="258" height="58" rx="8" class="d-grey"/>
    <text x="458" y="176" class="t b">CLPR Service 2</text>
    <text x="458" y="194" class="t small">a different service address</text>
    <text x="458" y="208" class="t small">also publishes eip155:1</text>

    <!-- Channel -> service 1: the compound key resolves -->
    <line x1="278" y1="138" x2="444" y2="120" class="line a" marker-end="url(#cpi-arrow-a)"/>
    <text x="361" y="100" class="t mono center a">peer =</text>
    <text x="361" y="114" class="t mono center a">(eip155:1, service 1)</text>

    <!-- Channel -> service 2: chain_id alone is ambiguous -->
    <line x1="278" y1="162" x2="444" y2="186" class="line bad dash" marker-end="url(#cpi-arrow-bad)"/>
    <circle cx="361" cy="174" r="10" class="d-surface"/>
    <text x="361" y="178" class="t b center bad">✕</text>
    <text x="361" y="200" class="t small center bad">chain id alone cannot</text>
    <text x="361" y="214" class="t small center bad">tell them apart</text>

    <!-- The key the spec names -->
    <rect x="20" y="236" width="270" height="64" rx="8" class="d-surface"/>
    <text x="36" y="256" class="t b">Peer identity</text>
    <text x="36" y="274" class="t small">(chain id, service address)</text>
    <text x="36" y="290" class="t small muted">a compound key; neither half is enough</text>

    <!-- Private networks pick their own namespace -->
    <rect x="430" y="236" width="290" height="64" rx="8" class="d-grey"/>
    <text x="446" y="256" class="t b">Private network</text>
    <text x="446" y="274" class="t small">assigns its own chain id</text>
    <text x="446" y="290" class="t small muted">self-asserted, like every chain id</text>

    <!-- takeaway -->
    <text x="370" y="324" class="t take center">A peer is the pair (chain id, service address); the chain id alone does not name a service.</text>
  </svg>
</Figure>
