---
/** What each ledger's proof points at: a Hiero proof walks from a hinTS-signed block root down to the channel record and one queue entry per message; a QBFT proof walks from a sealed header through the CLPR Service contract's account proof to storage proofs of the channel's state. Both end in the queue metadata and last running hash the service checks. Draws on ledgers/hiero/proof-schemes/hints-wraps.md and hints.md §2, and ledgers/besu/ledger.md §3. */
import Figure from '@kse/components/Figure.astro';
import { pinned } from '../../../lib/sources';
---
<Figure
  lead="Two state trees, one question."
  caption="A Hiero proof walks from a block root signed with a hinTS threshold signature down to the channel record and one queue entry per message; a QBFT proof walks from a sealed header through the CLPR Service contract's account proof to storage proofs of the channel's state. Both deliver the same queue metadata and last running hash for the service's own checks."
  source={[{ label: 'Hiero proof scheme: hinTS with WRAPS', href: pinned('clpr-spec', 'ledgers/hiero/proof-schemes/hints-wraps.md') }, { label: 'Hiero proof scheme: hinTS', href: pinned('clpr-spec', 'ledgers/hiero/proof-schemes/hints.md') }, { label: 'EVM ledger: proven storage layout', href: pinned('clpr-spec', 'ledgers/besu/ledger.md') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 436" role="img" aria-label="Two columns. Left, Hiero: a hinTS signature box (a threshold signature over the block root) signs a block root box (the root the ledger signs over its state tree), from which Merkle paths lead to a channel leaf holding the sender's channel record with its queue metadata, and a message leaf, one queue entry per message with its payload and running hash. Right, QBFT: a block header sealed by validators, with a quorum of seals from the trusted validator set, gives the state root; an account proof for the CLPR Service contract leads to its storage root, and storage proofs cover the channel's state and the last message's running hash. Both columns feed one box at the bottom: what the verifier returns to the service, the queue metadata, the messages, the last message id and its running hash.">
    <defs>
      <marker id="tst-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="tst-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="tst-arrow-b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--b)"/></marker>
    </defs>

    <!-- Column headings -->
    <text x="185" y="28" class="t b center a">Hiero (hinTS)</text>
    <text x="575" y="28" class="t b center b-col">QBFT (EVM ledger)</text>

    <!-- Hiero: signature over the block root -->
    <rect x="20" y="40" width="330" height="64" rx="8" class="d-ok"/>
    <text x="32" y="60" class="t b">hinTS signature</text>
    <text x="32" y="76" class="t small">a threshold signature</text>
    <text x="32" y="90" class="t small">over the block root</text>
    <line x1="185" y1="104" x2="185" y2="122" class="line ok" marker-end="url(#tst-arrow-ok)"/>
    <text x="193" y="117" class="t small muted">signs</text>

    <!-- Hiero: block root -->
    <rect x="20" y="124" width="330" height="64" rx="8" class="d-a"/>
    <text x="32" y="144" class="t b">block root</text>
    <text x="32" y="160" class="t small">the root the ledger signs,</text>
    <text x="32" y="176" class="t small">over its state tree</text>
    <line x1="99" y1="188" x2="99" y2="212" class="line a" marker-end="url(#tst-arrow-a)"/>
    <line x1="271" y1="188" x2="271" y2="212" class="line a" marker-end="url(#tst-arrow-a)"/>
    <text x="185" y="206" class="t small center muted">Merkle paths</text>

    <!-- Hiero: the two leaves -->
    <rect x="20" y="214" width="158" height="90" rx="8" class="d-a"/>
    <text x="32" y="234" class="t b">Channel leaf</text>
    <text x="32" y="252" class="t small">the sender's record:</text>
    <text x="32" y="268" class="t small">queue metadata: ids,</text>
    <text x="32" y="282" class="t small">running hashes, status</text>
    <rect x="192" y="214" width="158" height="90" rx="8" class="d-a"/>
    <text x="204" y="234" class="t b">Message leaf</text>
    <text x="204" y="252" class="t small">one queue entry per</text>
    <text x="204" y="268" class="t small">message: its payload</text>
    <text x="204" y="282" class="t small">and its running hash</text>

    <!-- QBFT: sealed header -->
    <rect x="410" y="40" width="330" height="64" rx="8" class="d-ok"/>
    <text x="422" y="60" class="t b">QBFT block header</text>
    <text x="422" y="76" class="t small">sealed by validators; a quorum of the seals</text>
    <text x="422" y="90" class="t small">must come from the trusted validator set</text>
    <line x1="575" y1="104" x2="575" y2="122" class="line b" marker-end="url(#tst-arrow-b)"/>
    <text x="583" y="117" class="t small muted">gives</text>

    <!-- QBFT: stateRoot and the account proof -->
    <rect x="410" y="124" width="330" height="64" rx="8" class="d-b"/>
    <text x="422" y="144" class="t b">state root</text>
    <text x="422" y="160" class="t small">account proof for the CLPR Service contract,</text>
    <text x="422" y="176" class="t small">walked to the contract's storage root</text>
    <line x1="575" y1="188" x2="575" y2="212" class="line b" marker-end="url(#tst-arrow-b)"/>
    <text x="583" y="204" class="t small muted">storage proofs</text>

    <!-- QBFT: the channel slots -->
    <rect x="410" y="214" width="330" height="90" rx="8" class="d-b"/>
    <text x="422" y="234" class="t b">the channel's state</text>
    <text x="422" y="252" class="t small">storage proofs of the channel's state</text>
    <text x="422" y="268" class="t small">and of the last message's running hash</text>

    <!-- Both end in the same values -->
    <path d="M20,306 V312 H350 V306" class="line a"/>
    <line x1="185" y1="312" x2="262" y2="334" class="line ok" marker-end="url(#tst-arrow-ok)"/>
    <line x1="575" y1="304" x2="498" y2="334" class="line ok" marker-end="url(#tst-arrow-ok)"/>
    <rect x="200" y="336" width="360" height="66" rx="8" class="d-ok"/>
    <text x="380" y="356" class="t b center">what the verifier returns to the service</text>
    <text x="380" y="374" class="t small center">queue metadata · messages</text>
    <text x="380" y="390" class="t small center">last message id · its running hash</text>

    <!-- takeaway -->
    <text x="380" y="424" class="t take center">Different trees, different signatures, the same handful of values at the end.</text>
  </svg>
</Figure>
