---
/** A bundle carries a contiguous run of the sender's queue: the receiver's Endpoint requests it from the sender's Endpoint and submits it to its own CLPR Service, which has its own Verifier check the proof; the run starts after the requestor's received message id, the proof covers the channel state and only the last message's queue entry, the running hash ties the earlier messages to it, and the rest waits for a later cycle (a partial bundle). Draws on Bundle §1, §3 and §4, Endpoint sync §4 and Messaging §4. */
import Figure from '@kse/components/Figure.astro';
import { messaging, bundle, endpointSync } from '../../../lib/sources';
---
<Figure
  lead="One proof, many messages."
  caption="The sending endpoint starts the run after the message the receiver last received and stops within the receiver's limits on messages and bytes. The proof covers the channel state and the queue entry of the last message only; the receiver recomputes the running hash over the run from its own stored value. A bundle may end before the sender's latest message, so a large backlog drains over several bundles. Ids and the cap are illustrative."
  source={[{ label: 'Bundle §1', href: bundle('1-bundle-content') }, { label: 'Bundle §3', href: bundle('3-partial-bundles') }, { label: 'Bundle §4', href: bundle('4-proof-requirements') }, { label: 'Endpoint sync §4', href: endpointSync('4-message-range') }, { label: 'Messaging §4', href: messaging('4-running-hash') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 380" role="img" aria-label="Ledger B, the receiver, on the right with received message id 42 and stored running hash H42. Its Endpoint sends a dashed, unproven request to the Endpoint of Ledger A on the left, which holds the sender's outbound queue. The queue shows message 42 already received, a bundle frame around messages 43 to 46 with 46 marked as the last message, and a remainder 47 to 52 waiting for a later cycle. A running hash chain H42 to H46 runs under the slots. A state proof covers A's channel state and the queue entry of message 46, and is sent with the bundle to B's Endpoint, which submits it to B's CLPR Service. The Service has B's verifier check the proof, then recomputes H43 to H46 from its stored H42 and requires the result to equal the proven H46.">
    <defs>
      <marker id="bpa-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
      <marker id="bpa-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
    </defs>

    <!-- Ledger B: the receiver drives -->
    <rect x="570" y="40" width="170" height="300" rx="12" class="d-b"/>
    <text x="584" y="62" class="t b">Ledger B</text>
    <text x="584" y="78" class="t small muted">receiver</text>
    <text x="584" y="98" class="t small">received: 42</text>
    <text x="584" y="114" class="t small">running hash: H42</text>
    <line x1="655" y1="164" x2="655" y2="174" class="line c"/>
    <line x1="655" y1="270" x2="655" y2="282" class="line"/>
    <rect x="576" y="124" width="158" height="40" rx="8" class="d-c"/>
    <text x="588" y="140" class="t b">Endpoint</text>
    <text x="588" y="156" class="t small">requests, submits</text>
    <rect x="576" y="174" width="158" height="96" rx="8" class="d-surface"/>
    <text x="588" y="194" class="t b">CLPR Service</text>
    <text x="588" y="212" class="t small">recomputes H43 … H46</text>
    <text x="588" y="226" class="t small">from its stored H42;</text>
    <text x="588" y="240" class="t small">must equal the H46</text>
    <text x="588" y="254" class="t small">its verifier returns</text>
    <rect x="576" y="282" width="158" height="50" rx="8" class="d-ok"/>
    <text x="588" y="302" class="t b">Verifier</text>
    <text x="588" y="320" class="t small">checks the proof</text>

    <!-- The request: unproven, shapes the bundle -->
    <path d="M576,134 H548 V66 H432 V100" class="line c dash" marker-end="url(#bpa-arrow-c)"/>
    <text x="540" y="58" class="t small end c">request: last message received is 42</text>
    <text x="424" y="82" class="t small end muted">unproven: shapes the bundle, never changes state</text>

    <!-- Ledger A: the sender's outbound queue -->
    <rect x="20" y="96" width="470" height="240" rx="12" class="d-a"/>
    <text x="34" y="118" class="t b">Ledger A · sender outbound queue</text>
    <text x="34" y="136" class="t small">queued 43 … 52 · next message id 53 (illustrative)</text>
    <rect x="384" y="102" width="96" height="40" rx="8" class="d-c"/>
    <text x="432" y="118" class="t b center">Endpoint</text>
    <text x="432" y="134" class="t small center">the sender</text>

    <rect x="26" y="176" width="60" height="44" rx="6" class="d-grey"/>
    <text x="56" y="195" class="t b center muted">42</text>
    <text x="56" y="211" class="t small center muted">received</text>

    <rect x="90" y="150" width="262" height="76" rx="8" class="d-c"/>
    <text x="102" y="168" class="t b c">Bundle</text>
    <text x="152" y="168" class="t small">43 … 46 · at the cap (4 here)</text>
    <rect x="98" y="176" width="56" height="44" rx="6" class="d-surface"/>
    <text x="126" y="202" class="t b center">43</text>
    <rect x="162" y="176" width="56" height="44" rx="6" class="d-surface"/>
    <text x="190" y="202" class="t b center">44</text>
    <rect x="226" y="176" width="56" height="44" rx="6" class="d-surface"/>
    <text x="254" y="202" class="t b center">45</text>
    <rect x="290" y="176" width="56" height="44" rx="6" class="d-ok"/>
    <text x="318" y="196" class="t b center">46</text>
    <text x="318" y="212" class="t small center ok">last</text>

    <!-- Running hash chain under the slots -->
    <text x="56" y="238" class="t mono center muted">H42</text>
    <line x1="70" y1="234" x2="112" y2="234" class="line ok" marker-end="url(#bpa-arrow-ok)"/>
    <text x="126" y="238" class="t mono center ok">H43</text>
    <line x1="140" y1="234" x2="176" y2="234" class="line ok" marker-end="url(#bpa-arrow-ok)"/>
    <text x="190" y="238" class="t mono center ok">H44</text>
    <line x1="204" y1="234" x2="240" y2="234" class="line ok" marker-end="url(#bpa-arrow-ok)"/>
    <text x="254" y="238" class="t mono center ok">H45</text>
    <line x1="268" y1="234" x2="304" y2="234" class="line ok" marker-end="url(#bpa-arrow-ok)"/>
    <text x="318" y="238" class="t mono center ok">H46</text>

    <!-- The remainder waits -->
    <rect x="368" y="176" width="108" height="44" rx="6" class="d-grey"/>
    <text x="422" y="195" class="t b center muted">47 … 52</text>
    <text x="422" y="211" class="t small center muted">later cycle</text>
    <text x="422" y="238" class="t small center muted">next bundle: 47</text>

    <!-- Where the slice starts -->
    <text x="34" y="292" class="t small muted">the run starts at</text>
    <text x="34" y="308" class="t mono">received + 1 = 43</text>

    <!-- One proof, over the anchor -->
    <rect x="200" y="272" width="276" height="50" rx="8" class="d-ok"/>
    <text x="212" y="292" class="t b">State proof</text>
    <text x="212" y="308" class="t small">A's channel state + queue entry 46</text>
    <line x1="318" y1="272" x2="318" y2="252" class="line ok" marker-end="url(#bpa-arrow-ok)"/>

    <!-- Bundle + proof go to B's Endpoint, which submits them to B's CLPR Service -->
    <line x1="476" y1="290" x2="574" y2="154" class="line c" marker-end="url(#bpa-arrow-c)"/>
    <text x="530" y="304" class="t small center muted">sent with</text>
    <text x="530" y="318" class="t small center muted">the bundle</text>

    <!-- takeaway -->
    <text x="380" y="364" class="t take center">One proof over the last message; the running hash extends it back over every earlier message in the run.</text>
  </svg>
</Figure>
