---
/** The EVM reference contracts: one router that is not upgradeable and holds the Service's state, logic modules it delegates to, which write its storage, and the committed storage layout CI guards, which peers' proofs depend on. Draws on the contracts repository's docs/architecture.md and pull request workflow, and on the EVM ledger's proven storage layout and CLPR Service §6.6. */
import Figure from '@kse/components/Figure.astro';
import { pinned, sol, service } from '../../../lib/sources';
---
<Figure
  lead="One router, its modules, one storage layout."
  caption="The router contract is not upgradeable and holds all of the CLPR Service's state; each call is delegated to a logic module that writes into the router's own storage. Because every module writes into that one layout, a snapshot of it is committed and CI regenerates and diffs it on every pull request; peers' proofs of the Service's state depend on the same layout."
  source={[{ label: 'contracts docs/architecture.md', href: pinned('clpr-smart-contracts', 'docs/architecture.md') }, { label: 'the router contract', href: sol('src/ClprService.sol') }, { label: 'pull request checks', href: pinned('clpr-smart-contracts', '.github/workflows/600-flow-pull-request-checks.yaml') }, { label: 'EVM ledger: proven storage layout', href: pinned('clpr-spec', 'ledgers/besu/ledger.md') }, { label: 'CLPR Service §6.6', href: service('66-service-upgrades') }]}
  kind="impl"
  minWidth={720}
>
  <svg viewBox="0 0 720 440" role="img" aria-label="A caller at the top, an application, an endpoint or the administrator, sends a call to the router contract, which is not upgradeable and holds the Service's state. The router delegates each call to one of its logic modules. A dashed line leads from the modules down into one box, the shared storage layout; a libraries box feeds it too. From the storage box a green arrow leads to the layout snapshot, a committed file that CI regenerates and diffs, and an Endpoint box points at that file to say its proofs use the same layout.">
    <defs>
      <marker id="evm-router-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--text-3)"/></marker>
      <marker id="evm-router-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="evm-router-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
    </defs>

    <!-- caller -->
    <rect x="195" y="14" width="280" height="44" rx="8" class="d-b"/>
    <text x="335" y="32" class="t b center">Caller</text>
    <text x="335" y="49" class="t small center">application · endpoint · administrator</text>
    <line x1="335" y1="58" x2="335" y2="90" class="line b" marker-end="url(#evm-router-arrow)"/>
    <text x="347" y="78" class="t small muted">call</text>

    <!-- router -->
    <rect x="150" y="92" width="370" height="62" rx="10" class="d-b"/>
    <text x="335" y="112" class="t b center">Router contract</text>
    <text x="335" y="129" class="t small center">not upgradeable · holds the Service's state</text>
    <text x="335" y="145" class="t small center">delegates each call to a module</text>

    <!-- the logic modules -->
    <line x1="335" y1="154" x2="335" y2="188" class="line b" marker-end="url(#evm-router-arrow)"/>
    <rect x="30" y="190" width="660" height="38" rx="8" class="d-grey"/>
    <text x="360" y="213" class="t center">Logic modules: each call runs in one, against the router's storage</text>

    <!-- modules write the router's storage -->
    <line x1="360" y1="228" x2="360" y2="260" class="line dash" marker-end="url(#evm-router-arrow)"/>

    <rect x="30" y="262" width="660" height="46" rx="8" class="d-surface"/>
    <text x="42" y="282" class="t b">Shared storage</text>
    <text x="42" y="299" class="t small">the one shared storage layout: every module reads and writes the router's own storage</text>

    <!-- libraries -->
    <line x1="190" y1="330" x2="190" y2="310" class="line dash" marker-end="url(#evm-router-arrow)"/>
    <rect x="30" y="332" width="320" height="60" rx="8" class="d-grey"/>
    <text x="42" y="352" class="t b">Libraries</text>
    <text x="42" y="369" class="t small">helpers that change state</text>
    <text x="42" y="385" class="t small">through storage references</text>

    <!-- snapshot and the endpoint -->
    <line x1="470" y1="308" x2="470" y2="330" class="line ok" marker-end="url(#evm-router-arrow-ok)"/>
    <text x="480" y="324" class="t small ok">snapshot</text>
    <rect x="380" y="332" width="180" height="60" rx="8" class="d-ok"/>
    <text x="392" y="352" class="t b">Layout snapshot</text>
    <text x="392" y="369" class="t small">committed file;</text>
    <text x="392" y="385" class="t small">CI regenerates and diffs it</text>
    <line x1="590" y1="362" x2="562" y2="362" class="line c" marker-end="url(#evm-router-arrow-c)"/>
    <rect x="592" y="332" width="98" height="60" rx="8" class="d-c"/>
    <text x="641" y="352" class="t b center">Endpoint</text>
    <text x="641" y="369" class="t small center">proofs use</text>
    <text x="641" y="385" class="t small center">this layout</text>

    <!-- takeaway -->
    <text x="360" y="424" class="t take center">One contract owns the state; modules borrow its storage; CI guards the layout that proofs depend on.</text>
  </svg>
</Figure>
