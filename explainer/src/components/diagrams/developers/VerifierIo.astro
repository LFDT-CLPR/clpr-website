---
/** A verifier as a stateless function the CLPR Service calls: the Endpoint submits the bundle to the Service, the Service passes it with the stored trust anchor and channel context to the verifier, and acts on the bundle content returned; Verifier interface §1, §3 and §4, Channel state transitions §2. */
import Figure from '@kse/components/Figure.astro';
import { verifierIface, transitions } from '../../../lib/sources';
---
<Figure
  lead="Stateless on purpose."
  caption="The Endpoint submits the bundle to the CLPR Service. The Service passes it, with the trust anchor stored with the channel and the channel context, which never changes, to the channel's verifier, and acts on what comes back; a new trust anchor comes back only when the bundle proves a change. The Service never reads the proof bytes itself."
  source={[{ label: 'Verifier interface §3', href: verifierIface('3-verifybundle') }, { label: 'Verifier interface §1', href: verifierIface('1-verifier-contracts-and-trust-anchors') }, { label: 'Verifier interface §4', href: verifierIface('4-trust-anchor-changes') }, { label: 'Channel state transitions §2', href: transitions('2-bundle-processing') }]}
  kind="spec"
  minWidth={740}
>
  <svg viewBox="0 0 740 356" role="img" aria-label="The Endpoint submits the bundle to the CLPR Service. The Service holds the channel storage: the trust anchor and its id, opaque to the Service, and the channel context of channel id and peer address. The Service calls the verifier with the bundle, the trust anchor and the context; the verifier, read-only and without per-channel state, returns the bundle content or fails. The bundle content is the queue metadata, the messages, the last message id and its running hash, and any new trust anchor or endpoint manifest. The Service acts on it: it replaces the trust anchor before any message, then checks the running hash, the message ids, replay and response order itself.">
    <defs>
      <marker id="vio-arrow-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--c)" /></marker>
      <marker id="vio-arrow-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--ok)" /></marker>
      <marker id="vio-arrow-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--b)" /></marker>
    </defs>

    <!-- arrows first, boxes over them -->
    <line x1="176" y1="56" x2="228" y2="56" class="line c" marker-end="url(#vio-arrow-c)" />
    <line x1="480" y1="74" x2="538" y2="74" class="line b" marker-end="url(#vio-arrow-b)" />
    <line x1="632" y1="124" x2="632" y2="168" class="line ok" marker-end="url(#vio-arrow-ok)" />
    <line x1="540" y1="224" x2="482" y2="224" class="line ok" marker-end="url(#vio-arrow-ok)" />

    <!-- the endpoint -->
    <rect x="16" y="24" width="160" height="64" rx="8" class="d-c" />
    <text x="96" y="46" class="t b center">Endpoint</text>
    <text x="96" y="64" class="t small center">submits the bundle</text>
    <text x="96" y="80" class="t small center">opaque proof bytes</text>
    <text x="202" y="48" class="t small center">bundle</text>

    <!-- the CLPR Service, holding the channel storage -->
    <rect x="230" y="24" width="250" height="278" rx="10" class="d-b" />
    <text x="355" y="46" class="t b center">CLPR Service</text>
    <rect x="246" y="58" width="218" height="112" rx="8" class="d-grey" />
    <text x="355" y="78" class="t b small center">Channel storage</text>
    <text x="355" y="96" class="t small center">trust anchor</text>
    <text x="355" y="110" class="t small center">trust anchor id</text>
    <text x="355" y="126" class="t small center muted">opaque to the service</text>
    <text x="355" y="146" class="t small center">channel context</text>
    <text x="355" y="160" class="t small center">channel id, peer address</text>
    <text x="355" y="194" class="t small center muted">acts on what returns:</text>
    <text x="355" y="212" class="t small center">replaces the trust anchor</text>
    <text x="355" y="226" class="t small center">before any message,</text>
    <text x="355" y="244" class="t small center">then checks the running hash,</text>
    <text x="355" y="258" class="t small center">message ids, replay</text>
    <text x="355" y="272" class="t small center">and response order</text>

    <text x="509" y="66" class="t small center">calls</text>

    <!-- the verifier, called by the Service -->
    <rect x="540" y="24" width="184" height="100" rx="8" class="d-ok" />
    <text x="632" y="46" class="t b center">Verifier</text>
    <text x="632" y="64" class="t small center">called with the bundle,</text>
    <text x="632" y="78" class="t small center">trust anchor and context</text>
    <text x="632" y="96" class="t small center">read-only;</text>
    <text x="632" y="110" class="t small center">no per-channel state</text>

    <text x="640" y="150" class="t small">returns,</text>
    <text x="580" y="150" class="t small end bad">or fails</text>

    <!-- what comes back -->
    <rect x="540" y="170" width="184" height="108" rx="8" class="d-surface" />
    <text x="632" y="192" class="t b center">Bundle content</text>
    <text x="632" y="210" class="t small center">queue metadata</text>
    <text x="632" y="224" class="t small center">messages</text>
    <text x="632" y="238" class="t small center">last id and running hash</text>
    <text x="632" y="252" class="t small center">new trust anchor (+ id)</text>
    <text x="632" y="266" class="t small center">new endpoint manifest</text>

    <text x="370" y="328" class="t take center">The verifier proves the bundle under the stored trust anchor and binds it to the channel.</text>
    <text x="370" y="344" class="t take center">Running hash, message ids, replay and response order are the service's job.</text>
  </svg>
</Figure>
