---
/** The reveal step: completeChannel checks the commitment and signature, verifyConfig checks the configuration proof and the optional manifest proof, and the service stores what comes back and creates the channel ACTIVE; Channel setup §2.2 and §5, Verifier interface §2. */
import Figure from '@kse/components/Figure.astro';
import { channelSetup, verifierIface } from '../../../lib/sources';
---
<Figure
  lead="What completeChannel stores."
  caption="The verifier checks the configuration proof and, when one is supplied, the manifest proof, and returns the peer's chain id, Service address, configuration timestamp, throttles, the initial trust anchor and the endpoint manifest. The service stores them with the constant channel context and the verifier binding, and the channel becomes ACTIVE."
  source={[{ label: 'Channel setup §2.2', href: channelSetup('22-completechannel') }, { label: 'Channel setup §5', href: channelSetup('5-initial-peer-state') }, { label: 'Verifier interface §2', href: verifierIface('2-verifyconfig') }]}
  kind="spec"
  minWidth={740}
>
  <svg viewBox="0 0 740 356" role="img" aria-label="completeChannel first checks that the commitment is pending, that the signature proves control of the registrant's key and that the named verifier exists, then hands the configuration proof and the optional manifest proof to verifyConfig on that verifier. verifyConfig fails if a proof is invalid, the manifest's service address differs or a supplied manifest proof yields version 0; otherwise its outputs are stored on the channel record: the peer chain id, the peer configuration timestamp, the peer throttles, the constant channel context, the trust anchor and its id, the peer manifest truncated to a local limit or no manifest when no proof was supplied, and the verifier binding fixed for the channel's life. The shared channel state goes from PENDING to ACTIVE with received message id 0 and next message id 1.">
    <defs>
      <marker id="ccs-arrow-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--c)" /></marker>
      <marker id="ccs-arrow-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--ok)" /></marker>
      <marker id="ccs-arrow-bad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--bad)" /></marker>
    </defs>

    <!-- completeChannel -->
    <rect x="16" y="24" width="200" height="92" rx="8" class="d-surface" />
    <text x="116" y="46" class="t b center">completeChannel</text>
    <text x="116" y="62" class="t small center">checks first:</text>
    <text x="116" y="78" class="t small center">pending commitment</text>
    <text x="116" y="92" class="t small center">signature by the key</text>
    <text x="116" y="106" class="t small center">a verifier at the address</text>

    <line x1="216" y1="70" x2="268" y2="70" class="line c" marker-end="url(#ccs-arrow-c)" />
    <text x="242" y="62" class="t small center">proofs</text>

    <!-- verifyConfig -->
    <rect x="270" y="24" width="206" height="86" rx="8" class="d-ok" />
    <text x="373" y="46" class="t b center">verifyConfig</text>
    <text x="373" y="64" class="t small center">configuration proof</text>
    <text x="373" y="78" class="t small center">manifest proof, if any</text>
    <text x="373" y="96" class="t small center">runs once, on the named verifier</text>

    <!-- revert -->
    <line x1="373" y1="110" x2="373" y2="148" class="line bad dash" marker-end="url(#ccs-arrow-bad)" />
    <text x="381" y="133" class="t small bad">fails if</text>

    <rect x="270" y="150" width="206" height="62" rx="8" class="d-bad" />
    <text x="373" y="172" class="t b center">no channel</text>
    <text x="373" y="190" class="t small center">invalid proof, address</text>
    <text x="373" y="204" class="t small center">mismatch or manifest version 0</text>

    <!-- stored on the channel record -->
    <line x1="476" y1="70" x2="528" y2="70" class="line ok" marker-end="url(#ccs-arrow-ok)" />
    <text x="502" y="62" class="t small center">stored</text>

    <rect x="530" y="24" width="194" height="178" rx="8" class="d-a" />
    <text x="627" y="46" class="t b center">Channel record</text>
    <text x="627" y="64" class="t small center">peer chain id</text>
    <text x="627" y="78" class="t small center">configuration timestamp</text>
    <text x="627" y="92" class="t small center">peer throttles</text>
    <text x="627" y="106" class="t small center">channel context (constant)</text>
    <text x="627" y="120" class="t small center">trust anchor (+ id)</text>
    <text x="627" y="134" class="t small center">peer manifest</text>
    <text x="627" y="148" class="t small center">truncated to a local limit,</text>
    <text x="627" y="162" class="t small center">or none if no proof given</text>
    <text x="627" y="180" class="t small center">verifier binding</text>
    <text x="627" y="194" class="t small center">fixed for the channel's life</text>

    <!-- status -->
    <path d="M476,92 H500 V275 H528" class="line ok" marker-end="url(#ccs-arrow-ok)" />
    <text x="494" y="240" class="t small end">becomes ACTIVE</text>

    <rect x="530" y="236" width="194" height="78" rx="8" class="d-ok" />
    <text x="627" y="258" class="t b center">Shared channel state</text>
    <text x="627" y="276" class="t small center">status: PENDING → ACTIVE</text>
    <text x="627" y="290" class="t small center">received message id: 0</text>
    <text x="627" y="304" class="t small center">next message id: 1</text>

    <text x="370" y="342" class="t take center">The registrant keeps no authority over the channel; the verifier it named stays for the channel's life.</text>
  </svg>
</Figure>
