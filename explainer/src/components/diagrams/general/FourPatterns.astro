---
/** The three application patterns the overview names in §8: remote contract calls through proxy contracts; escrow, mint, then burn; and two-phase commit across ledgers. The overview names them without detail, so each panel draws only what the pattern's name says, plus §8's point that a send's outcome arrives later as a reply. General page section 11; the rows of src/data/patterns.json name the same three (this figure does not read them). The file keeps its old name because the page imports it by that name. */
import Figure from '@kse/components/Figure.astro';
import { overview } from '../../../lib/sources';
---
<Figure
  lead="Three patterns built on one message primitive."
  caption="Drawn as an illustration of each pattern's name. A call to a contract on another ledger through proxy contracts, with the result coming back later as a reply. Assets held in escrow on one ledger, minted on another, then burned. Several ledgers changing state together or not at all, by two-phase commit. All three are built from messages and their replies."
  source={[{ label: 'Overview §8', href: overview('8-application-patterns') }]}
  kind="plain"
  minWidth={760}
>
  <svg viewBox="0 0 760 358" role="img" aria-label="Three panels. Remote call: an application on Ledger A calls a proxy contract, the call travels as a message to a proxy on Ledger B, which invokes the target contract, and the result comes back later as a reply. Escrow, mint, then burn: assets held in escrow on A, minted on B, then burned. Two-phase commit: three ledgers each get ready and say so, then all commit, or one fails and all roll back.">
    <!-- panel 1: remote call -->
    <rect x="10" y="12" width="240" height="318" rx="10" class="d-surface" />
    <text x="130" y="36" class="t b center">Remote call</text>
    <rect x="22" y="52" width="216" height="40" rx="8" class="d-a" />
    <text x="130" y="70" class="t center">application on A</text>
    <text x="130" y="85" class="t small center">calls a proxy contract</text>
    <line x1="130" y1="92" x2="130" y2="134" class="line c" />
    <text x="141" y="116" class="t small">a message</text>
    <rect x="22" y="134" width="216" height="40" rx="8" class="d-b" />
    <text x="130" y="152" class="t center">proxy on B</text>
    <text x="130" y="167" class="t small center">invokes the target</text>
    <rect x="22" y="192" width="216" height="40" rx="8" class="d-b" />
    <text x="130" y="210" class="t center">target contract</text>
    <text x="130" y="225" class="t small center">does the work</text>
    <line x1="74" y1="232" x2="74" y2="270" class="line b dash" />
    <text x="82" y="256" class="t small">the result, in a reply</text>
    <text x="130" y="304" class="t small center muted">written for</text>
    <text x="130" y="319" class="t small center muted">asynchronous answers</text>

    <!-- panel 2: escrow, mint, then burn -->
    <rect x="260" y="12" width="240" height="318" rx="10" class="d-surface" />
    <text x="380" y="36" class="t b center">Escrow, mint, then burn</text>
    <rect x="272" y="52" width="216" height="40" rx="8" class="d-a" />
    <text x="380" y="70" class="t center">1 escrow on A</text>
    <text x="380" y="85" class="t small center">assets held in escrow</text>
    <line x1="380" y1="92" x2="380" y2="134" class="line c" />
    <rect x="272" y="134" width="216" height="40" rx="8" class="d-b" />
    <text x="380" y="152" class="t center">2 mint on B</text>
    <text x="380" y="167" class="t small center">assets issued on B</text>
    <line x1="380" y1="174" x2="380" y2="212" class="line c" />
    <rect x="272" y="212" width="216" height="40" rx="8" class="d-grey" />
    <text x="380" y="230" class="t center">3 burn</text>
        <text x="380" y="304" class="t small center muted">steps linked by</text>
    <text x="380" y="319" class="t small center muted">CLPR messages</text>

    <!-- panel 3: two-phase commit -->
    <rect x="510" y="12" width="240" height="318" rx="10" class="d-surface" />
    <text x="630" y="36" class="t b center">Two-phase commit</text>
    <text x="630" y="60" class="t small center">1 each gets ready, and says so</text>
    <rect x="522" y="70" width="60" height="34" rx="8" class="d-a" /><text x="552" y="92" class="t center">A</text>
    <rect x="600" y="70" width="60" height="34" rx="8" class="d-b" /><text x="630" y="92" class="t center">B</text>
    <rect x="678" y="70" width="60" height="34" rx="8" class="d-c" /><text x="708" y="92" class="t center">C</text>
    <line x1="552" y1="104" x2="552" y2="136" class="line a" />
    <line x1="630" y1="104" x2="630" y2="136" class="line b" />
    <line x1="708" y1="104" x2="708" y2="136" class="line c" />
    <rect x="522" y="142" width="216" height="40" rx="8" class="d-ok" />
    <text x="630" y="160" class="t center">all ready → all commit</text>
    <text x="630" y="175" class="t small center">the changes land together</text>
    <rect x="522" y="194" width="216" height="40" rx="8" class="d-bad" />
    <text x="630" y="212" class="t center">one fails → all roll back</text>
    <text x="630" y="227" class="t small center">nothing lands anywhere</text>
    <text x="630" y="304" class="t small center muted">both phases carried as</text>
    <text x="630" y="319" class="t small center muted">CLPR messages</text>

    <text x="380" y="350" class="t take center">Three patterns, one primitive: a data message that gets exactly one reply.</text>
  </svg>
</Figure>
