---
/** Who picks whom: an application sends through the CLPR Service and names one connector per send; the Service asks that connector once for a yes or no (allow-list, rate limit, fee are the connector's own choice) and does the queuing itself; a rejected send costs the sender only its transaction fee. Several connectors can serve one channel; one operator can run connectors on many channels, and several on one (different salts). Connector setup §1 and §4; Messaging §5; Channel economics §1 (Recommendations). */
import Figure from '@kse/components/Figure.astro';
import { connectorSetup, messaging, economics } from '../../../lib/sources';
---
<Figure
  lead="Who picks whom."
  caption="An application sends through the CLPR Service and names a connector; the Service asks that connector once, yes or no. The connector can refuse, limit or charge as it chooses; the Service queues only what it approves, and by approving the connector commits to pay on the receiving ledger. Several connectors can serve one channel, and one operator can run connectors on many channels, and several on one."
  source={[{ label: 'Connector setup §1', href: connectorSetup('1-connector-identity') }, { label: 'Connector setup §4', href: connectorSetup('4-authorization-of-outbound-messages') }, { label: 'Messaging §5', href: messaging('5-enqueue') }, { label: 'Channel economics §1', href: economics('1-execution-charges') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 332" role="img" aria-label="Three applications on the left send to the CLPR Service in the middle, each naming a connector: applications 1 and 2 name connector X, application 3 names connector Y. Below the Service, beside it, connector X has a gate of allow-list, rate limit and fee, and connector Y accepts everything; the Service asks the named connector yes or no. On a yes the Service queues the message in channel 1's outbound queue on the right; on a no it rejects the send and the sender pays only for the attempt. Two connectors serve one channel.">
    <defs>
      <marker id="wpw-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="wpw-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="wpw-arrow-money" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto-start-reverse"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--money)"/></marker>
    </defs>

    <text x="91" y="30" class="t small center muted">each send names a connector</text>

    <!-- Applications -->
    <rect x="16" y="48" width="150" height="46" rx="8" class="d-a" />
    <text x="91" y="67" class="t b center">Application 1</text>
    <text x="91" y="84" class="t small center">names connector X</text>

    <rect x="16" y="112" width="150" height="46" rx="8" class="d-a" />
    <text x="91" y="131" class="t b center">Application 2</text>
    <text x="91" y="148" class="t small center">names connector X</text>

    <rect x="16" y="176" width="150" height="46" rx="8" class="d-a" />
    <text x="91" y="195" class="t b center">Application 3</text>
    <text x="91" y="212" class="t small center">names connector Y</text>

    <!-- Applications -> CLPR Service -->
    <line x1="166" y1="71" x2="198" y2="88" class="line a" marker-end="url(#wpw-arrow-a)" />
    <line x1="166" y1="135" x2="198" y2="124" class="line a" marker-end="url(#wpw-arrow-a)" />
    <line x1="166" y1="199" x2="198" y2="160" class="line a" marker-end="url(#wpw-arrow-a)" />

    <!-- CLPR Service: asks, then queues or rejects -->
    <rect x="200" y="40" width="260" height="168" rx="10" class="d-surface" />
    <text x="330" y="62" class="t b center">CLPR Service</text>
    <text x="330" y="84" class="t small center">asks the named connector</text>
    <text x="330" y="100" class="t small center">once: yes or no</text>
    <text x="330" y="126" class="t small center ok">yes: queues the message</text>
    <text x="330" y="150" class="t small center bad">no: rejects the send;</text>
    <text x="330" y="166" class="t small center bad">the sender pays only</text>
    <text x="330" y="182" class="t small center bad">for the attempt</text>

    <!-- Connectors, beside the Service: each answers yes or no -->
    <line x1="263" y1="210" x2="263" y2="228" class="line money" marker-start="url(#wpw-arrow-money)" marker-end="url(#wpw-arrow-money)" />
    <line x1="397" y1="210" x2="397" y2="228" class="line money" marker-start="url(#wpw-arrow-money)" marker-end="url(#wpw-arrow-money)" />
    <rect x="200" y="230" width="126" height="66" rx="8" class="d-money" />
    <text x="263" y="250" class="t b center">Connector X</text>
    <text x="263" y="268" class="t small center">gate: allow-list,</text>
    <text x="263" y="284" class="t small center">rate limit, fee</text>
    <rect x="334" y="230" width="126" height="66" rx="8" class="d-money" />
    <text x="397" y="250" class="t b center">Connector Y</text>
    <text x="397" y="268" class="t small center">gate: accepts</text>
    <text x="397" y="284" class="t small center">everything</text>

    <!-- Approved sends -> the channel's outbound queue -->
    <line x1="460" y1="126" x2="578" y2="126" class="line ok" marker-end="url(#wpw-arrow-ok)" />
    <text x="519" y="116" class="t small center ok">approved sends</text>
    <rect x="580" y="98" width="160" height="56" rx="8" class="d-grey" />
    <text x="660" y="121" class="t b center">Channel 1</text>
    <text x="660" y="139" class="t small center">its outbound queue</text>
    <text x="660" y="178" class="t small center money">two connectors,</text>
    <text x="660" y="194" class="t small center money">one channel</text>

    <!-- takeaway -->
    <text x="380" y="322" class="t take center">The application picks the connector; the connector says yes or no; the CLPR Service does the queuing.</text>
  </svg>
</Figure>
