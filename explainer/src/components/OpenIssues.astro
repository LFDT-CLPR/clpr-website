---
/** What is not settled yet, from src/data/open.json: the open issues of the specification, one per OI-n heading, each with the problem and its current behaviour. */
import data from '../data/open.json';
import Refs from '@kse/components/Refs.astro';
import type { Ref } from '../lib/sources';
const refs = data.open.flatMap((o) => o.refs) as Ref[];
---
<ul class="open-list">
  {data.open.map((o) => (
    <li><strong>{o.title}.</strong> {o.plain}</li>
  ))}
</ul>
<Refs refs={refs} />
<style>
  .open-list { padding-left: 20px; }
  .open-list li { margin: 8px 0; }
</style>
