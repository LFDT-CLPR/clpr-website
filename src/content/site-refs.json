    "hiero-native": {
      "claim": "Status of the native Hiero CLPR Service: the status of HIP-1535. The pull request, the release that ships it and the default setting are not stated on the site. No pinned LFDT-CLPR repository records this (the organization profile still says pending).",
      "checks": [
        "gh api repos/hiero-ledger/hiero-improvement-proposals/contents/HIP/hip-1535.md -q .content | base64 -d | grep -m1 '^status:'"
      ],
      "recorded": {
        "date": "2026-11-19",
        "result": "HIP-1535 status: Approved; the HIP describes the service as opt-in (networks that do not enable it are unaffected)"
      }
    },
    "spec-license": {
      "claim": "The licence the clpr-spec repository carries, against the Labs charter's rule for specifications.",
      "checks": [
        "gh api repos/LFDT-CLPR/clpr-spec/license -q .license.spdx_id"
      ],
      "recorded": {
        "date": "2026-11-28",
        "result": "GitHub reports NOASSERTION; the pinned README.md and LICENSE.md say the specification is under the Community Specification License 1.0 and code in the repository under Apache-2.0, as the charter (governance repository, §6.b.iv) asks for specifications"
      }
    },
    "lab-status": {
      "claim": "Whether the LFDT lab proposal for CLPR was accepted.",
      "checks": [
        "gh issue view 5 -R LF-Decentralized-Trust/lab-proposals --json state,labels -q '.state + \" \" + ([.labels[].name]|join(\",\"))'"
      ],
      "recorded": {
        "date": "2026-11-19",
        "result": "CLOSED Approved (2026-09-11)"
      }
    },
    "teams": {
      "claim": "The teams the governance page points to (teams.yml); the page names no individual maintainers, only the teams and the repository that lists them.",
      "checks": [
        "gh api repos/LFDT-CLPR/governance/contents/teams.yml -q .content | base64 -d | awk '/^repositories:/{exit} /^  - name:/{print $3}'"
      ],
      "recorded": {
        "date": "2026-11-28",
        "result": "Nine teams: clpr-maintainers, clpr-release-engineers, clpr-e2e-committers, clpr-endpoint-committers, clpr-smart-contracts-committers, clpr-spec-committers, clpr-website-committers, lfdt-staff, security-maintainers"
      }
    },
    "lfdt-release": {
      "claim": "The announcement of 24 September 2026: what CLPR is and who contributed it (LFDT press release), and the quotes by Daniela Barbosa and Dr. Leemon Baird with their titles (reported the same day; the original Hedera release with the quotes was not found).",
      "checks": [
        "curl -sL https://www.linuxfoundation.org/press/lf-decentralized-trust-adds-swift-wells-fargo-and-13-additional-new-members | grep -o 'CLPR[^<]*' | head -5",
        "curl -sL https://genfinity.io/2026/09/24/hedera-hashgraph-clpr-linux-foundation-decentralized-trust-labs/ | grep -oE '(Cross ledger interoperability|Just weeks ago)[^<]*' | head -4"
      ],
      "recorded": {
        "date": "2026-11-19",
        "result": "LFDT release dated 24 September 2026: CLPR is a bridgeless cross-ledger messaging protocol lab contributed by Hedera and developed by the Hashgraph team; Barbosa's release quote does not mention CLPR and Baird is not quoted there. Genfinity (24 September 2026) carries both quotes as used on the site."
      }
    },
    "hip-motivation": {
      "claim": "What other interledger designs do, as the site states it (story statement, comparison lead and the bridge column): only what the Motivation of HIP-1535 says. No pinned LFDT-CLPR repository describes other designs.",
      "checks": [
        "gh api repos/hiero-ledger/hiero-improvement-proposals/contents/HIP/hip-1535.md -q .content | base64 -d | awk '/^## Motivation/{f=1} /^## Rationale/{f=0} f' | head -8"
      ],
      "recorded": {
        "date": "2026-11-28",
        "result": "Existing interledger solutions typically introduce an intermediary trust layer (a federated bridge, an external validator set, or a wrapped-asset custodian) to move value or messages between chains. That layer becomes the weakest link: its keys can be stolen, its validators can collude, and its guarantees are usually weaker than the finality guarantees of either chain it connects."
      }
    }
  }
